{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "typeAcquisition": {
    "enable": true
  },
  "references": [
    {
      "path": "./source"
    },
    {
      "path": "./scripts"
    }
  ]
}
