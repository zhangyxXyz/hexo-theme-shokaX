mixin CommentEntry()
    if page.comment !== false && (theme.waline.enable || theme.twikoo.enable)
        section.comment-entry(aria-label=__('comment_panel.title'))
            div.comment-entry-copy
                strong
                    i.ic.i-comments(aria-hidden="true")
                    = __('comment_entry.title')
                p= __('comment_entry.description')
            a.comment-entry-button(href="#comments" aria-controls="comments" aria-label=__('comment_entry.action'))
                i.ic.i-comments(aria-hidden="true")
                span.comment-entry-button-label
                    span= __('comment_entry.action')
                    span.comment-entry-count

mixin CommentFooter()
    if page.comment !== false && (theme.waline.enable || theme.twikoo.enable)
        .comment-entry-footer.wrap
            +CommentEntry()

mixin CommentRender()
    != shokax_inject('comment')
    if page.comment !== false && (theme.waline.enable || theme.twikoo.enable)
        - var friendStyle = {}
        - var friendColors = (theme.waline.friendBadge || {}).colors || {}
        - for (var mode of ['light', 'dark']) { for (var key of ['text', 'background', 'border']) { var color = (friendColors[mode] || {})[key]; if (typeof color === 'string' && /^#(?:[\da-f]{3}|[\da-f]{4}|[\da-f]{6}|[\da-f]{8})$/i.test(color)) friendStyle['--friend-' + mode + '-' + key] = color; } }
        - var commentLayout = theme.waline.enable && (page.comment_layout ?? theme.waline.layout ?? 'bottom') === 'slide' ? 'slide' : 'bottom'
        section.comment-shell(data-comment-layout=commentLayout data-side=(theme.sidebar.position === 'left' ? 'left' : 'right') data-title=__('comment_panel.title') data-close=__('comment_panel.close') data-missing=__('comment_panel.missing') hidden=commentLayout === 'slide')
            div(class="wrap" id="comments" style=friendStyle data-region-template=__('comment_region') data-friend-label=__('comment_friend') data-private-label=__('comment_private.label') data-private-hint=__('comment_private.hint'))


