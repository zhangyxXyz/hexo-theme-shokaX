include postmeta.pug

mixin SMRender(item, lazy)
    - var link1 = item.link || item.path
    - var gradient = theme?.experiments?.gradient
    if item.link
        - var postTitleIcon = '<i class="ic i-link-alt"></i>'
    - var postText = item.title || item.link || __('post.untitled')
    - var cardSummary = is_home() ? summary_card(item) : null
    - var currentSummary = cardSummary && cardSummary[0]
    - var summaryMode = theme.summary.home && theme.summary.home.mode || 'switch'
    - var summaryDefault = theme.summary.home && theme.summary.home.default || 'original'
    - var summaryIndex = cardSummary ? Math.max(0, cardSummary.findIndex(version => version.id === summaryDefault || version.model === summaryDefault)) : 0
    - var summaryAI = !!cardSummary && (summaryMode === 'ai' || (summaryMode === 'switch' && summaryDefault !== 'original'))
    article(class="item")
        if gradient
            div(class="cover" style=`background: linear-gradient(to bottom right, ${random_color()}, ${random_color()});`)
        else
            div(class="cover")
                if lazy
                    != _url(link1, '<img loading="lazy" decoding="async" src="'+ _cover(item) +'" alt="article cover">', {itemprop: 'url', title: postText})
                else
                    != _url(link1, '<img loading="eager" decoding="async" src="'+ _cover(item) +'" alt="article cover">', {itemprop: 'url', title: postText})
        div(class="info")
            +PMRender(item)
                if cardSummary && summaryMode !== 'original'
                    span.summary-switch(role="group" aria-label=__('ai_summary.label'))
                        if summaryMode === 'switch' || cardSummary.length > 1
                            span.summary-model-picker
                                select(data-summary-select aria-label=__('ai_summary.choose_model'))
                                    if summaryMode === 'switch'
                                        option(value="original" data-preference="original" data-icon="i-align-left" data-tooltip=__('ai_summary.original') selected=!summaryAI)= __('ai_summary.original')
                                    each version, index in cardSummary
                                        option(value=String(index) data-preference=version.id selected=(summaryAI && index === summaryIndex) data-icon=summary_model_icon(version.model) data-tooltip=__('ai_summary.by_model', version.model || __('ai_summary.unknown_model')))= summary_model_label(version.model, page.lang || config.language, cardSummary) || __('ai_summary.unknown_model')
                        else
                            span.summary-fixed(tabindex="0" title=__('ai_summary.by_model', currentSummary.model || __('ai_summary.unknown_model')))
                                i.ic(class=summary_model_icon(currentSummary.model) aria-hidden="true")
            h3
                != _url(link1, postText + (postTitleIcon || ''), {itemprop: 'url', title: postText})
            div(class="excerpt" data-summary-panel="original" hidden=summaryAI)
                if item.description
                    != item.description
                else if item.excerpt
                    != item.excerpt
                else
                    != _truncate(escape_html(_striptags(item.content)),300)
            if cardSummary && summaryMode !== 'original'
                each version, index in cardSummary
                    div.excerpt(data-summary-panel="ai" data-summary-version=String(index) hidden=(!summaryAI || index !== summaryIndex))= version.text
            if item.categories.length > 0
                div(class="meta footer")
                    span
                        - var lastcat = item.categories.last()
                        != _url(lastcat.path, '<i class="ic i-flag"></i>' + lastcat.name, {itemprop: 'url', title: lastcat.name})
            != _url(link1, 'more...', {itemprop: 'url', title: postText, class: 'btn'})
