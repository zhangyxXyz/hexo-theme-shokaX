extends ./_partials/layout.pug

block head
    != _css('page.css')

block title
    != `${__('title.tag')}${__('symbol.colon')}${page.tag}`

block header
    h1(itemprop="name headline")
        != _p('title.tag_in', page.tag)

block content
    - const tagOptions = theme.tag_view || {}
    - const tagMode = tagOptions.mode === 'classic' ? 'classic' : 'tree'
    - const tagTreeData = tag_tree(page.tag, site.tags, page.posts)
    .tag-detail-page.archive-page.wrap(data-mode=tagMode data-default-mode=tagMode data-switchable=String(tagOptions.switchable !== false))
        .tag-detail-overview
            header.tag-detail-heading.collapse
                h2.item.header
                    a(href=url_for(config.tag_dir))= __('title.all')
                    small /
                    = page.tag
                    small= __('title.tag')
                    small.tag-detail-count= __('archive_view.posts', tagTreeData.total)
            if tagOptions.switchable !== false
                .tag-detail-controls.archive-view-controls(role="group" aria-label=__('tag_view.view') hidden)
                    button(type="button" data-archive-mode="tree" title=__('archive_view.tree') aria-label=__('archive_view.tree') aria-pressed=String(tagMode === 'tree') aria-controls="tag-tree-panel")
                        i.ic.i-timeline(aria-hidden="true")
                    button(type="button" data-archive-mode="classic" title=__('tag_view.classic') aria-label=__('tag_view.classic') aria-pressed=String(tagMode === 'classic') aria-controls="tag-classic-panel")
                        i.ic.i-list-alt(aria-hidden="true")
            if tagTreeData.years.length
                .tag-detail-meta
                    include _partials/archive-tree-tools.pug
        .archive-tree-panel#tag-tree-panel(data-archive-panel="tree" hidden=tagMode !== 'tree')
            include _partials/tag-tree.pug
        .archive-classic-panel#tag-classic-panel(data-archive-panel="classic" hidden=tagMode !== 'classic')
            include _partials/tag-classic.pug
    .tag-classic-pagination
        include _partials/pagination.pug
