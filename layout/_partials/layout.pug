include ../_mixin/breadcrumb.pug
include ../_mixin/sidebar.pug
include ../_mixin/widgets.pug

- var covers = _cover_index(page, 6)
- var enableFixedCover = theme.homeConfig?.fixedCover
- var enablePreload = theme.homeConfig?.coverConfig?.enablePreload
- var enableCover = theme.homeConfig?.coverConfig?.enableCover

doctype html
html(lang=page.language?page.language:config.language, style=theme.grayMode ? 'filter: grayscale(1);':'' )
    head
        != partial('_partials/head/head.pug', {}, {cache: true})
        if enablePreload && enableCover
            if enableFixedCover
                link(rel="preload" href=theme.homeConfig.fixedCover as="image" fetchpriority="high")
            else if Array.isArray(covers)
                each image in covers
                    link(rel="preload" href!=image as="image" fetchpriority="high")
            else
                link(rel="preload" href!=covers as="image" fetchpriority="high")

        != partial('_partials/head/head_com.pug')
        != shokax_inject('head')
        block head
        title
            block title
                = `${alternate ? alternate + ' = ' : ''}${title}${(theme.title || {}).show_subtitle !== false && subtitle ? ' = ' + subtitle : ''}`
    body(itemscope itemtype="http://schema.org/WebPage")
        != partial('_partials/loading.pug', {}, {cache: true})
        if theme.pagefind && theme.pagefind.enable
            include search.pug
        div(id="container")
            header(id="header" itemscope itemtype="http://schema.org/WPHeader")
                div(class="inner")
                    div(class="brand-clip")
                        div(id="brand")
                            div(class="pjax")
                                block header
                                    a(href=config.root class="logo" rel="start")
                                        if alternate
                                            p(class="artboard")
                                                != alternate
                                                span.artboard-glitch(aria-hidden="true" data-alternate=_striptags(alternate))
                                        h1(itemprop="name headline" class="title")
                                            != title
                                    - var homeSubtitle = theme.homeConfig.subtitle || {}
                                    - var quoteOptions = theme.hitokoto || {}
                                    if homeSubtitle.enable !== false && (subtitle || quoteOptions.home)
                                        p(class="meta home-subtitle" itemprop="description" data-quote data-hitokoto=String(quoteOptions.home === true) data-typewriter=String(quoteOptions.typewriter === true) data-fallback=subtitle)
                                            = subtitle

                    != partial('_partials/header.pug', {}, {cache: true})
                div(id="imgs" class="pjax")
                    if enableCover
                        if theme.homeConfig.gradient || enableFixedCover
                            //- cover不可用时用Bing随机图片代替
                            - var coverImage = theme.homeConfig?.fixedCover || "https://7ed.net/bing/api"
                            img(src=coverImage loading="eager" decoding="async" fetchpriority="high" alt=title)
                        else
                            if covers.length === 6
                                ul
                                    each image in covers
                                        li(class="item" style=`background-image: url("${image}");`)
                            else
                                img(src=covers loading="eager" decoding="async" fetchpriority="high" alt=title)
            div(id="waves")
                svg(class="waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto")
                    defs
                        path(id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z")
                    g(class="parallax")
                        use(xlink:href="#gentle-wave" x="48" y="0")
                        use(xlink:href="#gentle-wave" x="48" y="3")
                        use(xlink:href="#gentle-wave" x="48" y="5")
                        use(xlink:href="#gentle-wave" x="48" y="7")
            main
                div(class="inner")
                    div(id="main" class="pjax")
                        block content
                    div(id="sidebar")
                        block sidebar
                            +sidebarRender
                    div(class="dimmer")
                div(id="player")
            footer(id="footer")
                div(class="inner")
                    != partial('_partials/footer.pug', {}, {cache: true})
        - var ccIcon = '<i class="ic i-creative-commons"></i>'
        - var ccText = theme.creative_commons.license.toUpperCase()
        - var audioValue
        if page.audio
            - audioValue = JSON.stringify(page.audio);

        else if page.audio === false
            - audioValue = JSON.stringify({});
        else
            - audioValue = "undefined"

        - var ccIcon = '<i class="ic i-creative-commons"></i>'
        - var ccText = theme.creative_commons.license.toUpperCase()
        - const imageViewerLabels = { zoomIn: __('image_viewer.zoom_in'), zoomOut: __('image_viewer.zoom_out'), oneToOne: __('image_viewer.one_to_one'), reset: __('image_viewer.reset'), rotateLeft: __('image_viewer.rotate_left'), rotateRight: __('image_viewer.rotate_right'), previous: __('image_viewer.previous'), next: __('image_viewer.next'), close: __('image_viewer.close'), thumbnails: __('image_viewer.thumbnails'), image: __('image_viewer.image'), thumbnail: __('image_viewer.thumbnail'), counter: __('image_viewer.counter') }
        script(data-config type="text/javascript").
            var LOCAL = {
                imageViewer: !{JSON.stringify(imageViewerLabels).replace(/</g, '\\u003c')},
                codeBlock: !{JSON.stringify({wrap: __('code_block.wrap'), copy: __('code_block.copy'), copied: __('code_block.copied'), copyFailed: __('code_block.copy_failed'), fullscreen: __('code_block.fullscreen'), exitFullscreen: __('code_block.exit_fullscreen'), expand: __('code_block.expand'), collapse: __('code_block.collapse')}).replace(/</g, '\\u003c')},
                ispost: !{is_post()},
                path: `#{_permapath(page.path)}`,
                favicon: {
                    show: `#{__('favicon.show')}`,
                    hide: `#{__('favicon.hide')}`
                },
                search: {
                    placeholder: "!{__('search.placeholder')}",
                    empty: "!{__('search.empty')}",
                    stats: "!{__('search.stats')}"
                },
                copyright: !{JSON.stringify(page.nocopy === true ? __('tips.nocopy') : (page.copyright !== false ? __('tips.copyright', ccIcon + ccText) : '')).replace(/</g, '\\u003c')},
                copy_tex: #{!!page.math},
                katex: #{!!page.math},
                mermaid: #{!!page.mermaid},
                audio: !{audioValue},
                nocopy: #{!!page.nocopy},
                outime: #{page.outime !== false},
                template: `!{__('outime.template')}`,
                quiz: {
                    choice: `#{__('quiz.choice')}`,
                    multiple: `#{__('quiz.multiple')}`,
                    true_false: `#{__('quiz.true_false')}`,
                    essay: `#{__('quiz.essay')}`,
                    gap_fill: `#{__('quiz.gap_fill')}`,
                    mistake: `#{__('quiz.mistake')}`
                }
            };

        != partial('_partials/third-party/baidu-analytics.pug', {}, {cache: true})
        != partial('_partials/third-party/clarity.pug', {}, {cache: true})
        != partial('_partials/third-party/google-analytics.pug', {}, {cache: true})

        != _js('siteInit.js')

        != partial('_partials/third-party/festival.pug')
        != shokax_inject('bodyEnd')
