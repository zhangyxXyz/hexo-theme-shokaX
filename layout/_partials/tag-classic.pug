.collapse
    each post in page.posts.toArray()
        article.item.normal(itemscope itemtype="https://schema.org/Article")
            .meta
                time(itemprop="dateCreated" datetime=moment(post.date).format() content=date(post.date, config.date_format))= date(post.date, 'YYYY-MM-DD')
            .title
                if post.link
                    != _url(post.link, escape_html(post.title || post.link) + '<i class="ic i-link-alt"></i>', {class: 'external', itemprop: 'url'})
                else
                    a(href=url_for(post.path) itemprop="url")
                        span(itemprop="name")= post.title || __('post.untitled')
