- const icons = icon_preview_data()
- const labels = Object.assign({ search: 'Search icons', class: 'Copy class', html: 'Copy HTML', code: 'Copy code', copied: 'Copied', failed: 'Copy failed', empty: 'No matching icons', baseline_before: 'Inline', baseline_after: 'test', view: 'View', view_grid: 'Grid', view_row: 'Row', raw: 'Uncorrected', adjust_baseline: 'Baseline', adjust_scale: 'Size', adjust_weight: 'Weight' }, page.icon_preview || {})
- const signed = value => (value > 0 ? '+' : '') + value
.icon-preview(data-copied=labels.copied data-failed=labels.failed)
  .icon-preview-toolbar
    i.ic.i-search.icon-preview-search-icon(aria-hidden="true")
    input(type="search" placeholder=labels.search aria-label=labels.search autocomplete="off")
    button.icon-preview-clear(type="button" aria-label=__('pagefind_search.clear') title=__('pagefind_search.clear') hidden)
      i.ic.i-times(aria-hidden="true")
  .icon-preview-meta
    p.icon-preview-status(role="status" aria-live="polite")= icons.length + ' / ' + icons.length
    .icon-preview-views(role="group" aria-label=labels.view)
      button(type="button" data-view="grid" aria-pressed="true")= labels.view_grid
      button(type="button" data-view="row" aria-pressed="false")= labels.view_row
    button.icon-preview-raw(type="button" aria-pressed="false")= labels.raw
  .icon-preview-grid
    each icon in icons
      .icon-preview-card(data-name=icon.name data-code=icon.code)
        button.icon-preview-glyph(type="button" data-copy="html" aria-label=labels.html + ' ' + icon.name title=labels.html)
          if icon.svg
            != icon.svg
            //- The single-row view compares the font glyph, including its corrections.
            i.icon-preview-font(class='ic ' + icon.name aria-hidden="true")
          else
            i(class='ic ' + icon.name aria-hidden="true")
        button.icon-preview-name(type="button" data-copy="class" aria-label=labels.class + ' ' + icon.name title=labels.class)
          span= icon.name
        button.icon-preview-code(type="button" data-copy="code" aria-label=labels.code + ' ' + icon.code title=labels.code)
          span= '\\' + icon.code
        .icon-preview-baseline
          span= labels.baseline_before
          | #{' '}
          i(class='ic ' + icon.name aria-hidden="true")
          | #{' '}
          span= labels.baseline_after
        if icon.adjust
          p.icon-preview-adjust
            if icon.adjust.baseline !== undefined
              span= labels.adjust_baseline + ' ' + signed(icon.adjust.baseline)
            if icon.adjust.scale !== undefined
              span= labels.adjust_scale + ' ×' + icon.adjust.scale
            if icon.adjust.weight !== undefined
              span= labels.adjust_weight + ' ' + signed(icon.adjust.weight)
        span.icon-preview-feedback(role="status" aria-live="polite")
  p.icon-preview-empty(hidden)= labels.empty
