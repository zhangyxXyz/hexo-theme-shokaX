include traditional-mixins.pug
//- Two magpies cross a loose red thread under a crescent and an arcing star river.
svg(viewBox='0 0 260 320' focusable='false')
    +festivalCraftPalette('qixi')
    defs
        linearGradient#qixi-feathers(x1='0%' y1='0%' x2='90%' y2='100%' gradientUnits='objectBoundingBox')
            stop(stop-color='#688d9e')
            stop(offset='.35' stop-color='#294d64')
            stop(offset='.7' stop-color='#162c41')
            stop(offset='1' stop-color='#102233')
        linearGradient#qixi-star-river(x1='0%' y1='100%' x2='100%' y2='0%' gradientUnits='objectBoundingBox')
            stop(stop-color='#7faaa9' stop-opacity='0')
            stop(offset='.35' stop-color='#91afb5' stop-opacity='.2')
            stop(offset='.65' stop-color='#dfc68e' stop-opacity='.38')
            stop(offset='1' stop-color='#ddc28a' stop-opacity='0')
    g(transform='translate(-22 -64) scale(1.1)')
        path(d='M76 202Q109 68 240 68L243 92Q137 86 83 214Z' fill='url(#qixi-star-river)')
        path(d='M86 189Q134 70 246 77' fill='none' stroke='#c5a672' stroke-width='.75' stroke-dasharray='1 6' opacity='.72')
        each speck in [[111,135],[119,121],[129,109],[139,98],[153,92],[163,85],[187,82],[201,78],[228,80],[141,117],[161,101],[201,97],[220,89],[107,151],[99,174]]
            circle(cx=speck[0] cy=speck[1] r='1' fill='#e4c98d' opacity='.8')
        g.festival-depth
            path(d='M208 92q-34-3-36 25-1 18 15 28-30-5-29-29 0-28 28-31 12-1 22 7Z' fill='url(#qixi-moon)' stroke='#cba566' stroke-width='.8')
            path(d='M165 115q3-20 22-24' fill='none' stroke='#fff4c3' stroke-width='1.4')
        g(fill='url(#qixi-gold)')
            each star in [[216,122,5],[197,151,3],[133,101,4],[228,161,3],[150,84,2]]
                path(d=`M${star[0]} ${star[1]-star[2]}l${star[2]*.3} ${star[2]*.7} ${star[2]*.7} ${star[2]*.3}-${star[2]*.7} ${star[2]*.3}-${star[2]*.3} ${star[2]*.7}-${star[2]*.3}-${star[2]*.7}-${star[2]*.7}-${star[2]*.3} ${star[2]*.7}-${star[2]*.3}Z`)
        g.festival-depth.festival-bird-breathe
            g(transform='translate(137 160) rotate(-15)')
                path(d='M-8 1q-20 15-39 49l29-17-6 12L2 7Z' fill='url(#qixi-feathers)' stroke='#142c3b' stroke-width='.8')
                path(d='M-14 12-39 43m31-26-11 20' fill='none' stroke='#7bafbc' stroke-width='1.3')
                path(d='M-13-13q-21 14-3 31 16 11 30-2 10-8 8-18 13-7 7-17-7-10-17-3-10 0-25 9Z' fill='url(#qixi-feathers)' stroke='#1e3b4c' stroke-width='1')
                path(d='M-17-3q-8 16 8 21 13 3 24-9L6 1Z' fill='url(#qixi-porcelain)')
                path(d='M-14-9q18-4 28 8-6 18-25 11L-27 26q3-19 13-35Z' fill='url(#qixi-blue)' stroke='#254b64' stroke-width='.8')
                path(d='M-12-3q13-2 20 4M-16 3q11-2 19 2M-19 10q7-4 13-3' fill='none' stroke='#9cbfcd' stroke-width='.8')
                path(d='m28-15 11 5-10 2Z' fill='url(#qixi-gold)')
                circle(cx='23' cy='-15' r='2' fill='#fff6d7')
                circle(cx='23.5' cy='-15' r='1.1' fill='#182837')
                path(d='m1 19 2 10 7 2m-6-2-6 3' fill='none' stroke='#8f724d' stroke-width='1.2')
            g(transform='translate(210 181) rotate(11) scale(-.86 .86)')
                path(d='M-8 1q-20 15-39 49l29-17-6 12L2 7Z' fill='url(#qixi-feathers)' stroke='#142c3b' stroke-width='.8')
                path(d='M-14 12-39 43m31-26-11 20' fill='none' stroke='#7bafbc' stroke-width='1.3')
                path(d='M-13-13q-21 14-3 31 16 11 30-2 10-8 8-18 13-7 7-17-7-10-17-3-10 0-25 9Z' fill='url(#qixi-feathers)' stroke='#1e3b4c' stroke-width='1')
                path(d='M-17-3q-8 16 8 21 13 3 24-9L6 1Z' fill='url(#qixi-porcelain)')
                path(d='M-14-9q18-4 28 8-6 18-25 11L-27 26q3-19 13-35Z' fill='url(#qixi-blue)' stroke='#254b64' stroke-width='.8')
                path(d='M-12-3q13-2 20 4M-16 3q11-2 19 2M-19 10q7-4 13-3' fill='none' stroke='#9cbfcd' stroke-width='.8')
                path(d='m28-15 11 5-10 2Z' fill='url(#qixi-gold)')
                circle(cx='23' cy='-15' r='2' fill='#fff6d7')
                circle(cx='23.5' cy='-15' r='1.1' fill='#182837')
        g.festival-thread-sway(style='--festival-thread-origin: 162px 155px; --festival-motion-delay: -2s')
            path(d='M162 155q20 33 28 15M135 192q-28 24-13 43 14 16 37-1t44-7q12 2 16 10' fill='none' stroke='#a94c5a' stroke-width='2.2' stroke-linecap='round')
            path(d='M162 155q20 33 28 15M135 192q-28 24-13 43 14 16 37-1t44-7q12 2 16 10' fill='none' stroke='#f1a6a0' stroke-width='.65' stroke-linecap='round')
        +festivalCaption(87, 98, 11.5, '#917454', '#fff2d6')
