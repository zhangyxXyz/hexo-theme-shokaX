include traditional-mixins.pug
//- Chrysanthemums and cornel berries above distant ridges and double-ninth cake.
svg(viewBox='0 0 260 320' focusable='false')
    +festivalCraftPalette('chongyang')
    defs
        linearGradient#chongyang-petal(x1='0%' y1='0%' x2='40%' y2='100%' gradientUnits='objectBoundingBox')
            stop(stop-color='#fff2b2')
            stop(offset='.4' stop-color='#f1c45e')
            stop(offset='.8' stop-color='#c48630')
            stop(offset='1' stop-color='#8b5726')
        linearGradient#chongyang-mountain-mist(x1='0%' y1='0%' x2='0%' y2='100%' gradientUnits='objectBoundingBox')
            stop(stop-color='#6f8e83' stop-opacity='.25')
            stop(offset='1' stop-color='#a0ad96' stop-opacity='0')
    g(transform='translate(-24 -66) scale(1.1)')
        path(d='m58 170 30-37 17 15 35-50 31 37 27-49 43 54 14 49Z' fill='url(#chongyang-mountain-mist)')
        path(d='m73 173 28-24 26 13 29-40 28 35 30-30 38 54Z' fill='url(#chongyang-mountain-mist)')
        g(fill='none' stroke-linecap='round')
            path(d='M167 227q-9-62-9-105m9 105q41-36 42-76m-48 45q-43-24-46-54m61 81q48-59 48-131' stroke='#66835d' stroke-width='2.4')
            path(d='m219 134 20-27m-18 8-16-19m-9 91 35-15' stroke='#80583c' stroke-width='1.3')
        g.festival-foliage-breathe(fill='url(#chongyang-jade)' stroke='#587853' stroke-width='.5')
            path(d='M159 175q-28 4-33-16l9 2-1-9 9 5 3-9q16 12 13 27M168 201q24-1 33-22l-10 4 1-10-11 6-4-8q-13 15-9 30M120 158q-22 0-24-18l8 2-1-8 8 4 2-7q10 10 7 27M215 153q24-1 29-19-22-4-29 19')
        g(fill='url(#chongyang-red)' stroke='#902f34' stroke-width='.5')
            each berry in [[238,107],[243,98],[232,100],[224,90],[211,97],[201,93],[204,84],[232,171],[241,169],[236,161]]
                circle(cx=berry[0] cy=berry[1] r='4.3')
        g.festival-depth
            each flower in [[158,125,1],[208,177,.67],[109,178,.56]]
                g(transform=`translate(${flower[0]} ${flower[1]}) scale(${flower[2]})`)
                    each angle in [0,20,40,60,80,100,120,140,160,180,200,220,240,260,280,300,320,340]
                        path(d='M0 3C-9-6-10-28-4-38 4-44 10-35 5-25L0 3Z' transform=`rotate(${angle})` fill='url(#chongyang-petal)' stroke='#c1903e' stroke-width='.6')
                    each angle in [10,40,70,100,130,160,190,220,250,280,310,340]
                        path(d='M0 4C-8-3-6-23 0-28 6-22 8-7 0 4Z' transform=`rotate(${angle})` fill='url(#chongyang-petal)' stroke='#a9732c' stroke-width='.55')
                    each angle in [0,45,90,135,180,225,270,315]
                        path(d='M0 3q-9-8-3-17 9 1 3 17Z' transform=`rotate(${angle})` fill='#efc568' stroke='#b88435' stroke-width='.6')
                    circle(r='6' fill='url(#chongyang-gold)')
                    each stamen in [[-2,-2],[2,-1],[-1,2],[3,3]]
                        circle(cx=stamen[0] cy=stamen[1] r='1' fill='#9b662b')
            g(transform='translate(144 225) rotate(-7) scale(1.12)')
                path(d='M-37-4 4-20 44-3 4 14Z' fill='#f6e3b4' stroke='#c4a46a' stroke-width='.8')
                path(d='M-37-4 4 14 44-3v26L4 41-37 23Z' fill='url(#chongyang-pearl)' stroke='#b69a69' stroke-width='.8')
                path(d='M-37 4 4 22 44 5v6L4 28-37 11Z' fill='#aa6260')
                path(d='M-37 16 4 34 44 17v4L4 39-37 21Z' fill='#cb8a79')
                path(d='M4 14v27' stroke='#c5a174' stroke-width='.8')
                path(d='M-27-4 3-14 32-3 3 8Z' fill='none' stroke='#dac08c' stroke-width='.9')
                each date in [[-18,-4],[23,-4]]
                    ellipse(cx=date[0] cy=date[1] rx='4.3' ry='2.5' fill='url(#chongyang-red)' transform=`rotate(-15 ${date[0]} ${date[1]})`)
                path(d='M2-11V-39l18 7-18 7' fill='url(#chongyang-red)' stroke='url(#chongyang-gold)' stroke-width='1.1')
                +festivalCaption(3, -2, 9.5, '#9c7549', '#f7e6bd')
