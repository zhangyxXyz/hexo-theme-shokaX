include traditional-mixins.pug
//- A six-sided palace lantern with silk panels, gilt ribs and sweet rice balls.
svg(viewBox='0 0 260 320' focusable='false')
    +festivalCraftPalette('lantern')
    g.festival-ornament-sway(style='--festival-origin: 178px 0px')
        +festivalCord('lantern', 178, 77)
        +festivalKnot('lantern', 178, 40, .72)
        g.festival-depth
            path(d='M158 70h40l14 15h-68Z' fill='url(#lantern-red)' stroke='url(#lantern-gold)' stroke-width='1.4')
            path(d='M175 61h6v10h-6Z' fill='url(#lantern-gold)')
            path(d='M135 95h83l18 28-12 70-28 28h-38l-30-28-12-70Z' fill='url(#lantern-red)' stroke='#792530' stroke-width='1.5')
            path(d='M153 101h47l8 24-7 67-10 20h-30l-11-20-7-67Z' fill='#d54b48')
            path(d='M153 101h47l8 24-7 67-10 20h-30l-11-20-7-67Z' fill='url(#lantern-silk-weave)')
            path(d='M138 103 125 125l11 65 22 20-8-83Zm74 0 16 22-12 65-20 20 5-83Z' fill='#802733' opacity='.7')
            path(d='m153 101-10 24 7 67 11 20m39-111 8 24-7 67-10 20M118 124h117M128 191h96' fill='none' stroke='url(#lantern-gold)' stroke-width='2.5')
            path(d='M134 94q42-13 85 0l22 22q-12-2-20-9h-87q-9 8-21 9Z' fill='url(#lantern-gold)' stroke='#b17b32' stroke-width='.7')
            path(d='M119 113q-11 3-9-6m123 6q11 3 9-6M145 92h65M136 103h82' fill='none' stroke='#ffe6a4' stroke-width='1.5' stroke-linecap='round')
            path(d='M139 199q38 8 74 0l-13 19h-47Z' fill='url(#lantern-gold)' stroke='#a77432' stroke-width='.8')
            path(d='M155 220h42v6h-42Z' fill='url(#lantern-red)' stroke='url(#lantern-gold)' stroke-width='1.2')
            g(transform='translate(176 155)' fill='none' stroke='url(#lantern-gold)')
                circle(r='22' stroke-width='1')
                circle(r='19' stroke-width='.6')
                path(d='m-4-16 4-2 4 2m-8 32 4 2 4-2' stroke-width='.7')
                +festivalCaption(0, 1, 14, '#ffe0a2', '#b54040')
            path(d='M155 127h41M157 186h37' stroke='#ffe2a2' stroke-width='.8')
        +festivalTassel('lantern', 128, 194, .65)
        +festivalTassel('lantern', 224, 194, .65)
        +festivalTassel('lantern', 176, 226, 1.25)
        g.festival-depth
            g(transform='translate(99 241) rotate(-8)')
                ellipse(cy='4' rx='43' ry='13' fill='url(#lantern-gold)')
                path(d='M-40 0Q-35 35 0 37 35 35 40 0Z' fill='url(#lantern-porcelain)' stroke='#7f9caa' stroke-width='1')
                ellipse(rx='40' ry='13' fill='#a7bdc4' stroke='#fff9e7' stroke-width='2')
                ellipse(cy='1' rx='35' ry='9' fill='#e9cc92')
                each ball in [[-17,-5,11],[5,-9,12],[21,1,10],[-1,5,12]]
                    circle(cx=ball[0] cy=ball[1] r=ball[2] fill='url(#lantern-pearl)' stroke='#e5d3b0' stroke-width='.6')
                path(d='M-34 13q35 13 68 0M-29 22q29 12 58 0' fill='none' stroke='#396385' stroke-width='1.6')
                each ornament in [-18,0,18]
                    path(d=`M${ornament-5} 19q5-8 10 0-5 7-10 0` fill='none' stroke='#396385' stroke-width='1')
                ellipse(cy='36' rx='18' ry='3.5' fill='url(#lantern-gold)')
        path(d='M87 213q-9-9 0-19m15 13q11-9 3-20' fill='none' stroke='#c6a66b' stroke-width='1.2' stroke-linecap='round' opacity='.65')
