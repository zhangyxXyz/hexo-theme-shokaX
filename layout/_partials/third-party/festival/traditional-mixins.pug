//- Shared, original SVG craft details. Every paint server belongs to its scene.
mixin festivalCaption(x, y, size, colour, outline)
    //- Keep the empty node: the preview changes textContent without rebuilding artwork.
    text(data-festival-label='' x=x y=y text-anchor='middle' dominant-baseline='central' font-family='KaiTi, STKaiti, "Noto Serif CJK SC", serif' font-size=size font-weight='500' letter-spacing='.8' fill=colour stroke=outline stroke-width='.45' paint-order='stroke fill' stroke-linejoin='round')= typeof festivalLabel === 'string' ? festivalLabel : ''

mixin festivalCraftPalette(scene)
    defs
        linearGradient(id=scene + '-gold' x1='0%' y1='0%' x2='100%' y2='70%' gradientUnits='objectBoundingBox')
            stop(stop-color='#8b471b')
            stop(offset='.18' stop-color='#dfaf55')
            stop(offset='.36' stop-color='#fff3bd')
            stop(offset='.53' stop-color='#ca8e34')
            stop(offset='.72' stop-color='#ffdfa0')
            stop(offset='1' stop-color='#a56325')
        linearGradient(id=scene + '-red' x1='0%' y1='0%' x2='100%' y2='30%' gradientUnits='objectBoundingBox')
            stop(stop-color='#771d28')
            stop(offset='.28' stop-color='#bd3840')
            stop(offset='.47' stop-color='#ee7164')
            stop(offset='.65' stop-color='#be333b')
            stop(offset='1' stop-color='#711e2b')
        linearGradient(id=scene + '-jade' x1='0%' y1='0%' x2='100%' y2='80%' gradientUnits='objectBoundingBox')
            stop(stop-color='#d9e7aa')
            stop(offset='.24' stop-color='#8ba878')
            stop(offset='.55' stop-color='#376f55')
            stop(offset='1' stop-color='#123f39')
        radialGradient(id=scene + '-pearl' cx='32%' cy='23%' r='78%' gradientUnits='objectBoundingBox')
            stop(stop-color='#fffef0')
            stop(offset='.48' stop-color='#f8e5b8')
            stop(offset='.82' stop-color='#dfbc76')
            stop(offset='1' stop-color='#b68644')
        linearGradient(id=scene + '-porcelain' x1='0%' y1='0%' x2='60%' y2='100%' gradientUnits='objectBoundingBox')
            stop(stop-color='#ffffff')
            stop(offset='.37' stop-color='#e6eff0')
            stop(offset='.68' stop-color='#b7cfd4')
            stop(offset='.83' stop-color='#f5faf5')
            stop(offset='1' stop-color='#89a6b6')
        linearGradient(id=scene + '-blue' x1='0%' y1='0%' x2='100%' y2='90%' gradientUnits='objectBoundingBox')
            stop(stop-color='#87b0c3')
            stop(offset='.4' stop-color='#376b91')
            stop(offset='1' stop-color='#183753')
        radialGradient(id=scene + '-moon' cx='34%' cy='25%' r='78%' gradientUnits='objectBoundingBox')
            stop(stop-color='#fff9dc')
            stop(offset='.55' stop-color='#f7df9b')
            stop(offset='1' stop-color='#d4a551')
        pattern(id=scene + '-silk-weave' width='4' height='4' patternUnits='userSpaceOnUse' patternTransform='rotate(25)')
            path(d='M0 0v4' stroke='#fff3cc' stroke-width='.45' opacity='.22')

mixin festivalCord(scene, x, bottom)
    path(d=`M${x} -4V${bottom}` fill='none' stroke='#732c2c' stroke-width='4' stroke-linecap='round')
    path(d=`M${x - .6} -4V${bottom}` fill='none' stroke='#e4be77' stroke-width='1.2' stroke-dasharray='3 2')

mixin festivalKnot(scene, x, y, size)
    g(transform=`translate(${x} ${y}) scale(${size || 1})`)
        path(d='M0-13C-17-30-27-8-10 0c-17 8-7 30 10 13 17 17 27-5 10-13 17-8 7-30-10-13ZM0-13 13 0 0 13-13 0Z' fill='none' stroke='#68262a' stroke-width='6.6' stroke-linejoin='round')
        path(d='M0-13C-17-30-27-8-10 0c-17 8-7 30 10 13 17 17 27-5 10-13 17-8 7-30-10-13ZM0-13 13 0 0 13-13 0Z' fill='none' stroke='url(#' + scene + '-red)' stroke-width='5.1' stroke-linejoin='round')
        path(d='M0-13 13 0 0 13-13 0Z' fill='none' stroke='url(#' + scene + '-gold)' stroke-width='1')
        path(d='m-4-7 11 11m-14-4 11 11m-8-18 11 11m-11-7-7 7m15-7-15 15m15-7-7 7' fill='none' stroke='#f4b073' stroke-width='.65' opacity='.6')
        circle(r='3' fill='url(#' + scene + '-gold)')

mixin festivalTassel(scene, x, y, size, colour)
    g(transform=`translate(${x} ${y}) scale(${size || 1})`)
        g.festival-silk
            path(d='M0 0v13' stroke='#d5a458' stroke-width='2')
            ellipse(cy='14' rx='4' ry='5.5' fill='url(#' + scene + '-pearl)')
            path(d='M-5 20Q-7 42-11 58 0 64 11 58 7 42 5 20Z' fill='url(#' + scene + (colour === 'jade' ? '-jade)' : '-red)'))
            each strand in [-7,-5,-3,-1,1,3,5,7]
                path(d=`M${strand * .55} 23Q${strand * .75} 44 ${strand} 59` fill='none' stroke=colour === 'jade' ? '#bfd3a0' : '#f8a77d' stroke-width='.65' opacity='.62')
            path(d='M-5 20h10v5H-5Z' fill='url(#' + scene + '-gold)')
            path(d='M-6 25h12' stroke='#fff0b7' stroke-width='.8')

mixin festivalCloud(scene, x, y, size)
    g(transform=`translate(${x} ${y}) scale(${size || 1})` fill='none' stroke-linecap='round')
        path(d='M-21 5h30q16 0 13-9-2-7-10-3-2-14-13-10-8 2-7 10-9-5-13 2-4 8 8 10' stroke='url(#' + scene + '-gold)' stroke-width='2.2')
        path(d='M-13 0H7q10 0 7-5M-2-8q4-5 7 0' stroke='#ffe9ae' stroke-width='.8')
