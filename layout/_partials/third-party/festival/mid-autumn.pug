//- Original vector artwork: harvest moon, osmanthus and mooncake.
svg(viewBox="0 0 260 260" focusable="false")
    defs
        radialGradient#festival-harvest-moon(cx=".35" cy=".3" r=".75")
            stop(stop-color="#fff9dc")
            stop(offset=".55" stop-color="#f6e4ae")
            stop(offset="1" stop-color="#cdaa62")
        radialGradient#festival-moon-halo
            stop(offset=".45" stop-color="#f6dda0" stop-opacity=".3")
            stop(offset="1" stop-color="#f6dda0" stop-opacity="0")
        linearGradient#festival-cake-edge(x1="0" y1="0" x2="0" y2="1")
            stop(stop-color="#e6b264")
            stop(offset=".45" stop-color="#a76029")
            stop(offset="1" stop-color="#713e22")
        radialGradient#festival-cake-top(cx=".35" cy=".25" r=".8")
            stop(stop-color="#f5d799")
            stop(offset=".65" stop-color="#d7a255")
            stop(offset="1" stop-color="#a2672e")
    circle(cx="171" cy="80" r="82" fill="url(#festival-moon-halo)")
    circle(cx="171" cy="80" r="57" fill="url(#festival-harvest-moon)" stroke="#fff2c8" stroke-opacity=".6")
    circle(cx="157" cy="63" r="9" fill="#c7a96c" opacity=".12")
    circle(cx="185" cy="101" r="15" fill="#c7a96c" opacity=".12")
    g(fill="none" stroke="#ba9e68" stroke-width="2" stroke-linecap="round")
        path(d="M263 78q-42 27-75 65t-86 54m88-56 22 20m-58 6-26-17")
    g.festival-bamboo(fill="currentColor")
        path(d="M228 106q-1-23-22-28 2 25 22 28m-35 36q29 0 43-19-29-3-43 19m-24 21q-1-28-25-36 0 29 25 36m-42 23q22 17 47 6-24-17-47-6")
    each position in [[202,137], [215,131], [214,148], [151,172], [163,181], [148,189]]
        g(transform=`translate(${position[0]} ${position[1]})`)
            each angle in [0,90,180,270]
                ellipse(cx="0" cy="-3" rx="2.5" ry="3.5" transform=`rotate(${angle})` fill="#f3ca6c" stroke="#c38e39" stroke-width=".5")
            circle(r="1.4" fill="#a9742c")
    g.festival-depth(transform="translate(84 202)")
        - const cakeOutline = 'M-34-13q-6-12 6-17 2-13 15-10 9-11 18-2 14-6 19 7 13 0 13 14 10 9 0 18 0 14-13 14-5 13-19 7-9 9-18-2-13 3-15-10-12-5-6-17Z'
        path(d=cakeOutline transform="translate(0 10)" fill="url(#festival-cake-edge)" stroke="#875024" stroke-width="1")
        path(d=cakeOutline fill="url(#festival-cake-top)" stroke="#f1cd88" stroke-width="2")
        circle(r="27" fill="none" stroke="#a16a33" stroke-width="2")
        circle(cy="-1" r="25" fill="none" stroke="#f9dea6" stroke-width="1.5")
        each angle in [0,45,90,135,180,225,270,315]
            path(d="M0-20q-9-12-11-2Q-5-13 0-20q9-12 11-2Q5-13 0-20" transform=`rotate(${angle})` fill="none" stroke="#ae7737" stroke-width="1.3")
        rect(x="-10" y="-12" width="20" height="24" rx="4" fill="#ddb16b" stroke="#a16a33" stroke-width="1.5")
        path(d="M-6-7h12M-6 0h12M-6 7h12M-3-9v18M3-9v18" fill="none" stroke="#a16a33" stroke-width="1.5")
        path(d="M-6-8h12M-6-1h12M-6 6h12" fill="none" stroke="#f8d999" stroke-width=".8")
