include traditional-mixins.pug
//- A harvest moon behind a jade rabbit, with loose osmanthus and a carved mooncake.
svg(viewBox='0 0 260 320' focusable='false')
    +festivalCraftPalette('mid-autumn')
    defs
        radialGradient#mid-autumn-cake(cx='30%' cy='20%' r='85%' gradientUnits='objectBoundingBox')
            stop(stop-color='#ffdf9f')
            stop(offset='.55' stop-color='#d69b49')
            stop(offset='1' stop-color='#8a4b24')
        linearGradient#mid-autumn-cake-edge(x1='0%' y1='0%' x2='0%' y2='100%' gradientUnits='objectBoundingBox')
            stop(stop-color='#c08039')
            stop(offset='.5' stop-color='#915026')
            stop(offset='1' stop-color='#65391f')
        radialGradient#mid-autumn-halo(cx='50%' cy='50%' r='50%' gradientUnits='objectBoundingBox')
            stop(offset='.6' stop-color='#edcf80' stop-opacity='.22')
            stop(offset='1' stop-color='#edcf80' stop-opacity='0')
    g(transform='translate(-20 -52) scale(1.08)')
        circle(cx='173' cy='130' r='86' fill='url(#mid-autumn-halo)')
        g.festival-depth
            circle(cx='173' cy='130' r='73' fill='url(#mid-autumn-moon)')
            path(d='M113 101q12-25 36-31' fill='none' stroke='#fffbe1' stroke-width='2' stroke-linecap='round' opacity='.65')
            g(fill='#d5ad60' opacity='.18')
                circle(cx='191' cy='118' r='10')
                circle(cx='154' cy='158' r='14')
                circle(cx='198' cy='165' r='7')
            +festivalCloud('mid-autumn', 206, 92, .59)
            g(transform='translate(170 174)')
                path(d='M-12 8q-14-2-17-14-4-18 11-23 10-3 14 6-1-18 5-27 4-6 7-2 4 5-2 23 9-15 14-13 7 4-5 23 12 8 7 21-2 6-9 7Z' fill='url(#mid-autumn-porcelain)' stroke='#d5bd89' stroke-width='.8')
                path(d='M3-30q0-14 3-17m4 22q7-13 10-15' fill='none' stroke='#d9b5a5' stroke-width='2' stroke-linecap='round')
                ellipse(cx='4' cy='6' rx='15' ry='5' fill='#fff8e5')
                circle(cx='14' cy='-13' r='1.8' fill='#695240')
                circle(cx='-24' cy='-1' r='7' fill='#fff9e5' stroke='#dfccab' stroke-width='.7')
        g.festival-branch-breathe(style='--festival-branch-origin: 242px 121px')
            g(fill='none' stroke-linecap='round')
                path(d='M242 121q-8 50-62 92t-76 19m111-51 19-2m-37 20-3-20' stroke='#8f6e3d' stroke-width='2.5')
                path(d='M241 121q-8 50-62 92t-76 19' stroke='#d9b26b' stroke-width='.9')
            g(fill='url(#mid-autumn-jade)')
                path(d='M233 155q-21-7-22-28 22 3 22 28M224 174q24 0 31-16-25-3-31 16M210 192q-26-5-30-25 23 0 30 25M183 213q23 15 40-1-24-12-40 1M163 224q-20-9-22-29 23 6 22 29')
            each position in [[237,168],[229,182],[218,194],[208,202],[186,216],[151,229]]
                g(transform=`translate(${position[0]} ${position[1]})`)
                    each angle in [0,90,180,270]
                        ellipse(cx='0' cy='-2.8' rx='2.3' ry='3.2' transform=`rotate(${angle})` fill='url(#mid-autumn-gold)' stroke='#b48138' stroke-width='.4')
                    circle(r='1.2' fill='#8c5625')
        g.festival-depth
            g(transform='translate(106 228) rotate(-13) scale(1.13)')
                - const midAutumnCakeOutline = 'M-27-10q-5-10 5-14 2-10 12-8 7-9 14-2 11-5 15 5 10 1 10 11 8 7 0 14 0 11-10 11-4 10-15 5-7 7-14-2-10 2-12-8-10-4-5-14Z'
                path(d=midAutumnCakeOutline transform='translate(0 8)' fill='url(#mid-autumn-cake-edge)' stroke='#925727')
                path(d=midAutumnCakeOutline fill='url(#mid-autumn-cake)' stroke='#f1cb82' stroke-width='1.8')
                circle(r='22' fill='none' stroke='#945c29' stroke-width='1.8')
                circle(cy='-.6' r='20' fill='none' stroke='#ffe0a2' stroke-width='.8')
                each angle in [0,45,90,135,180,225,270,315]
                    path(d='M0-14q-8-13-10-5-1 7 10 5 8-13 10-5 1 7-10 5' transform=`rotate(${angle})` fill='none' stroke='#a1652d' stroke-width='1.1')
                +festivalCaption(0, 1, 10.5, '#855022', '#efbf73')
