.bookmark-directory(data-mode="axis" data-count-label=__('bookmark_view.count', '%s') data-results-label=__('bookmark_view.results', '%s', '%s') data-search-bundle=url_for('pagefind-bookmarks/pagefind.js') data-search-page=('/' + post.path).replace(/index\.html$/, '') data-loading-label=__('bookmark_view.loading') data-fallback-label=__('bookmark_view.fallback'))
    .bookmark-toolbar(hidden)
        form.bookmark-search(role="search" aria-label=__('bookmark_view.search'))
            i.ic.i-search(aria-hidden="true")
            input.bookmark-search-input(type="search" placeholder=__('bookmark_view.placeholder') aria-label=__('bookmark_view.search') aria-describedby="bookmark-search-hint" autocomplete="off")
            button.bookmark-search-clear(type="button" hidden aria-label=__('bookmark_view.clear'))
                i.ic.i-times(aria-hidden="true")
        p.bookmark-search-hint#bookmark-search-hint= __('bookmark_view.hint')
        p.bookmark-status(role="status" aria-live="polite" aria-atomic="true")
        .bookmark-controls(role="group" aria-label=__('bookmark_view.label'))
            button(type="button" data-bookmark-view="axis" aria-pressed="true" aria-label=__('bookmark_view.axis'))
                i.ic.i-timeline(aria-hidden="true")
            button(type="button" data-bookmark-view="cards" aria-pressed="false" aria-label=__('bookmark_view.cards'))
                i.ic.i-th(aria-hidden="true")
    .bookmark-content
        != post.content
    .bookmark-empty(hidden)
        i.ic.i-search(aria-hidden="true")
        p= __('bookmark_view.empty')
