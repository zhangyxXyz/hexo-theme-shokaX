mixin navpost(item, type)
    - var enableNextGradientCover = theme?.homeConfig?.coverConfig?.enableNextGradientCover
    - var postText = item.title || item.link || __('post.untitled')
    - var lastcat = item.categories.last()
    - var directionIcon = `<i class="ic ${type === 'prev' ? 'i-chevron-left' : type === 'next' ? 'i-chevron-right' : 'i-shuffle'}" aria-hidden="true"></i>`
    - var directionLabel = `<span>${__('post.' + type)}</span>`
    - var itemlink = `<span class="type">${type === 'next' ? directionLabel + directionIcon : directionIcon + directionLabel}</span>${lastcat && lastcat.name ? `<span class="category"><i class="ic i-category" aria-hidden="true"></i><span>${lastcat.name}</span></span>` : ''}<h3>${postText}</h3>`
    if enableNextGradientCover
        != _url(item.path, itemlink, {itemprop: 'url', rel: type === 'random' ? undefined : type, title: postText, style: `background-image: linear-gradient(to bottom right, ${random_color()}, ${random_color()});`})
    else
        != _url(item.path, itemlink, {itemprop: 'url', rel: type === 'random' ? undefined : type, 'data-background-image': _cover(item), title: postText})

- var navLeft = navigation.left
- var navRight = navigation.right
if navLeft || navRight
    div(class="post-nav")
        if navLeft
            div(class="item left")
                +navpost(navLeft, navigation.leftType)
        if navRight
            div(class="item right")
                +navpost(navRight, navigation.rightType)
