.collapse
    each year in archiveData.years
        each month in year.months
            if !archiveScoped
                h3.item.section
                    a(href=url_for(config.archive_dir + '/' + year.year))= year.year + ' ' + __('symbol.year')
                    small /
                    a(href=url_for(config.archive_dir + '/' + year.year + '/' + month.month))= month.month + ' ' + __('symbol.month')
                    small= '(' + month.posts.length + ')'
            else
                if !is_month()
                    h3.item.section
                        a(href=url_for(config.archive_dir + '/' + year.year + '/' + month.month))= month.month + ' ' + __('symbol.month')
                each post in month.posts
                    article.item.normal(itemscope itemtype="https://schema.org/Article")
                        .meta
                            time(itemprop="dateCreated" datetime=moment(post.date).format() content=date(post.date, config.date_format))= date(post.date, 'MM-DD')
                        .title
                            if post.link
                                a.external(href=post.link rel="noopener external" itemprop="url")
                                    span(itemprop="name")= post.title || post.link
                                    i.ic.i-link-alt(aria-hidden="true")
                            else
                                a(href=url_for(post.path) itemprop="url")
                                    span(itemprop="name")= post.title || __('post.untitled')
