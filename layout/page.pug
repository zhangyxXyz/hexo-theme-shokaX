extends _partials/layout.pug
include _mixin/sidebar.pug
include _mixin/comment.pug

block head
    != _css('post.css')
    link(rel="stylesheet" media="none" onload="this.media='all'" href=vendor_url('css.math', 'https://s4.zstatic.net/ajax/libs/KaTeX/0.16.9/katex.min.css'))

block title
    if page.type === 'categories'
        != __('title.all') + __('title.category')
    else if page.type === 'tags'
        != __('title.all') + __('title.tag')
    else if page.type === '404'
        != __('title.not_found')
    else
        != page.title

block header
    h1(itemprop="name headline")
        if page.link
            - var postTitleIcon = '<i class="ic i-link-alt"></i>'
            - var postText = page.title || page.link
            != _url(page.link, postText + postTitleIcon, {class: 'link external', itemprop: 'url'})
        else
            if page.type === 'categories'
                != __('title.all') + __('title.category')
            else if page.type === 'tags'
                != __('title.all') + __('title.tag')
            else if page.type === '404'
                != __('title.not_found')
            else
                != page.title

block content
    if page.type === 'categories'
        - const categoryOptions = theme.category_view || {}
        - const categoryMode = categoryOptions.mode === 'classic' ? 'classic' : 'cards'
        div(class="collapse wrap category-directory" data-category-mode=categoryMode data-default-mode=categoryMode data-switchable=String(categoryOptions.switchable !== false))
            h2(class="item title")
                a(href=url_for(site.path))
                    != __('menu.home')
                small
                != _p('counter.categories', site.categories.length)
            include _partials/category-directory.pug
    else if page.type === 'tags'
        div(class="collapse wrap tag-directory")
            h2(class="item title")
                a(href=url_for(site.path))
                    != __('menu.home')
                small
                != _p('counter.tag_cloud', site.tags.length)
            include _partials/tagcloud.pug
    else
        div(class="page wrap")
            if page.type === 'festival-preview'
                include _partials/festival-preview.pug
            else
                != partial('_partials/post/post.pug', {post: page})
            if page.type === 'statistics'
                include _partials/statistics.pug
        +CommentFooter()
        +CommentRender

block sidebar
    +sidebarRender(true)
