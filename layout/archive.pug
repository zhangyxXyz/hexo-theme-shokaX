extends _partials/layout.pug

block head
    != _css('page.css')

block title
    if is_month()
        != `${page.year}${__('symbol.year')}/${page.month}${__('symbol.month')}`
    else if is_year()
        != `${page.year}${__('symbol.year')}`
    != `${__('title.archive')}`

block header
    h1(itemprop="name headline")
        if is_month()
            != _p('title.archive_in', page.year + __('symbol.year') + page.month + __('symbol.month'))
        else if is_year()
            != _p('title.archive_in', page.year + __('symbol.year'))
        else
            != __('title.archive')

block content
    - const archiveOptions = theme.archive_view || {}
    - const archiveMode = archiveOptions.mode === 'classic' ? 'classic' : 'tree'
    - const archiveScoped = is_year() || is_month()
    - const archiveData = archive_tree(page.posts, site.posts)
    - const archiveTreeData = archive_tree(page.posts, site.posts, { year: archiveScoped ? page.year : undefined, month: is_month() ? page.month : undefined })
    .archive-page.wrap#archive(data-default-mode=archiveMode data-mode=archiveMode data-switchable=String(archiveOptions.switchable !== false))
        .archive-overview
            include _partials/archive-header.pug
            .archive-toolbar
                if archiveOptions.switchable !== false
                    .archive-view-controls(role="group" aria-label=__('archive_view.view') hidden)
                        button(type="button" data-archive-mode="tree" aria-label=__('archive_view.tree') aria-pressed=String(archiveMode === 'tree') aria-controls="archive-tree-panel")
                            i.ic.i-timeline(aria-hidden="true")
                        button(type="button" data-archive-mode="classic" aria-label=__('archive_view.classic') aria-pressed=String(archiveMode === 'classic') aria-controls="archive-classic-panel")
                            i.ic.i-list-alt(aria-hidden="true")
                .archive-heading-meta
                    p.archive-heading-description
                        if archiveScoped
                            span.archive-tree-count= __('archive_view.posts', archiveTreeData.count)
                            span.archive-classic-count= __('archive_view.page_posts', archiveData.count)
                        else
                            = __('archive_view.heading')
                    if archiveTreeData.years.length
                        div(data-archive-tree-tools hidden)
                            button.archive-expand(type="button" data-archive-expand data-expand-label=__('archive_view.expand_all') data-collapse-label=__('archive_view.collapse_all'))
                                span(data-archive-expand-label)= __('archive_view.expand_all')
                                i.ic.i-angle-down(aria-hidden="true")
        .archive-tree-panel#archive-tree-panel(data-archive-panel="tree" hidden=archiveMode !== 'tree')
            include _partials/archive-tree.pug
        .archive-classic-panel#archive-classic-panel(data-archive-panel="classic" hidden=archiveMode !== 'classic')
            include _partials/archive-classic.pug
    .archive-classic-pagination
        include _partials/pagination.pug
