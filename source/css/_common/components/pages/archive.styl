.archive-page {
  --archive-line: unquote('color-mix(in srgb, var(--primary-color) 13%, var(--grey-3))');
  --archive-axis: unquote('color-mix(in srgb, var(--primary-color) 42%, var(--grey-3))');
  --archive-soft: unquote('color-mix(in srgb, var(--primary-color) 6%, var(--grey-1))');
  --archive-card: var(--grey-1);
  --archive-muted: var(--grey-6);
  min-width: 0;

  [hidden] { display: none !important; }
  &[data-mode='tree'] + .archive-classic-pagination,
  &[data-mode='tree'] .archive-classic-count,
  &[data-mode='classic'] .archive-tree-count { display: none; }
  &[data-mode='tree'] .archive-classic-panel,
  &[data-mode='classic'] .archive-tree-panel,
  &[data-mode='classic'] [data-archive-tree-tools] { display: none; }

  button, a, summary {
    &:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 4px;
    }
  }

  .archive-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin: .5rem 1.875rem 1.5rem;
  }

  .archive-view-controls {
    display: flex;
    order: 2;
    width: fit-content;
    margin-left: auto;
    gap: .1rem;
    padding: .15rem;
    border-radius: .6rem;
    background: var(--grey-3);

    button {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 1.65rem;
      padding: .25rem .4rem;
      border: 0;
      border-radius: .45rem;
      background: transparent;
      color: var(--archive-muted);
      font: inherit;
      font-size: 1rem;
      line-height: 1;
      cursor: pointer;
      transition: color .2s, background .2s, box-shadow .2s;

      &:hover { color: var(--primary-color); }
      &[aria-pressed='true'] {
        color: var(--primary-color);
        background: var(--grey-1);
        box-shadow: 0 1px 4px var(--box-bg-shadow);
      }

      .ic { display: block; line-height: 1; }
    }
  }

  .archive-expand {
    padding: .4rem .1rem;
    border: 0;
    background: transparent;
    color: var(--archive-muted);
    font: inherit;
    font-size: .8rem;
    cursor: pointer;

    &:hover { color: var(--primary-color); }
    .ic { transition: transform .2s; }
    .ic.is-expanded { transform: rotate(180deg); }
  }

  .archive-heading .item.header {
    padding-bottom: .75rem;
  }

  .archive-overview { position: relative; display: flow-root; }
  &[data-mode='classic'] .archive-toolbar {
    position: absolute;
    right: 1.875rem;
    bottom: .5rem;
    margin: 0;
  }
  &[data-mode='classic'][data-archive-enhanced='true'][data-switchable='true'] .archive-heading-description {
    padding-right: 5rem;
  }
  &[data-mode='classic']:has(.archive-classic-panel > .collapse > .item) .archive-overview::after {
    content: '';
    position: absolute;
    top: 1.9rem;
    bottom: -1.9rem;
    left: .35rem;
    border-left: .2rem dashed var(--color-red-a3);
    pointer-events: none;
  }
  &[data-mode='classic']:has(.archive-classic-panel > .collapse > .normal:first-child) .archive-overview::after {
    bottom: -1.4rem;
  }

  .archive-heading-description {
    display: block;
    margin: .5rem 0 0;
    color: var(--archive-muted);
    font-size: .8rem;
    font-weight: 400;
    line-height: 1.8;
  }

  .archive-tree-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem;
    gap: 1.5rem;
    padding-top: .5rem;
  }

  .archive-tree-content { min-width: 0; }

  // Use the heading's text inset for the desktop reading column.
  @media (min-width: 768px) {
    .archive-tree-panel { padding-inline: 1.875rem; }
  }

  .archive-tree {
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: 1rem;
      bottom: 1.5rem;
      left: 50%;
      width: 2px;
      transform: translateX(-50%);
      background: linear-gradient(var(--primary-color), var(--archive-axis) 35%, var(--archive-line) 95%);
    }
  }

  .archive-year {
    position: relative;
    scroll-margin-top: 5rem;

    + .archive-year { margin-top: 1.25rem; }
    &:not([open]) .archive-year-title { margin-bottom: 1.5rem; }
    &[open] .archive-year-title .ic { transform: none; }

    &:first-child .archive-year-pill {
      border-color: var(--archive-axis);
      background: var(--archive-soft);

      .archive-year-number:not(:hover):not(:focus-visible) { color: var(--primary-color); }
    }
  }

  .archive-year-title {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.3rem;
    margin-bottom: 1rem;
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker { display: none; }
    .ic {
      color: var(--archive-muted);
      font-size: .75rem;
      transform: rotate(-90deg);
      transition: transform .2s;
    }
  }

  .archive-year-pill {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    min-height: 2.3rem;
    padding: .3rem .8rem;
    border: 1px solid var(--archive-line);
    border-radius: 2rem;
    background: var(--grey-1);

    > .ic { display: inline-flex; align-items: center; justify-content: center; width: 1rem; height: 1rem; line-height: 1; }
  }

  .archive-year-number {
    color: var(--grey-7);
    font-family: inherit;
    font-size: 1.45rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
    letter-spacing: .03em;
    text-decoration: none;

    &:hover, &:focus-visible { color: var(--color-blue); text-decoration: none; }
  }

  .archive-year-count {
    color: var(--archive-muted);
    font-size: .7rem;
    line-height: 1;
  }

  .archive-year-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 3.375rem;
    align-items: start;
  }

  .archive-month-card {
    --archive-month-heading-center: 1.9rem;
    scroll-margin-top: 5rem;
    position: relative;
    grid-column: 1;
    grid-row: var(--archive-row);
    min-width: 0;
    margin: 0 0 1rem;
    padding: 1.1rem 1.15rem .8rem;
    border: 1px solid var(--archive-line);
    border-radius: .85rem;
    background: var(--archive-card);
    box-shadow: 0 .35rem 1.4rem unquote('color-mix(in srgb, var(--box-bg-shadow) 22%, transparent)');
    transition: border-color .2s, box-shadow .2s;

    &::before {
      content: '';
      position: absolute;
      top: calc(var(--archive-month-heading-center) - .35rem);
      right: -.4rem;
      width: .7rem;
      height: .7rem;
      border-top: 1px solid var(--archive-line);
      border-right: 1px solid var(--archive-line);
      background: var(--archive-card);
      transform: rotate(45deg);
    }

    &:hover {
      border-color: var(--archive-axis);
      box-shadow: 0 .5rem 1.6rem unquote('color-mix(in srgb, var(--box-bg-shadow) 40%, transparent)');
    }

    &.is-right {
      grid-column: 2;

      &::before {
        right: auto;
        left: -.4rem;
        transform: rotate(-135deg);
      }

      .archive-month-node { right: auto; left: -2.0625rem; }
    }

    &.is-offset { margin-top: 3.875rem; }

    &.is-latest {
      border-color: var(--archive-axis);
      background: linear-gradient(135deg, var(--archive-card), var(--archive-soft));

      &::before { border-color: var(--archive-axis); }
      .archive-month-node {
        background: var(--primary-color);
        box-shadow: 0 0 0 .3rem var(--archive-soft);
      }
    }
  }

  .archive-month-node {
    position: absolute;
    z-index: 1;
    top: calc(var(--archive-month-heading-center) - .3125rem);
    right: -2.0625rem;
    width: .625rem;
    height: .625rem;
    border: 2px solid var(--primary-color);
    border-radius: 50%;
    background: var(--grey-1);
  }

  .archive-month-heading {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding-bottom: .7rem;
    border-bottom: 1px solid var(--archive-line);

    h3 {
      display: flex;
      align-items: center;
      min-height: 1.6rem;
      margin: 0;
      color: var(--grey-7);
      font-size: .85rem;
      font-weight: 600;
      line-height: 1;

      a { display: inline-flex; align-items: center; gap: .45rem; line-height: 1; }
    }

    small {
      margin-left: auto;
      color: var(--archive-muted);
      font-size: .7rem;
      text-align: right;
      line-height: 1;
    }
  }

  .archive-month-number {
    font-family: Georgia, serif;
    font-size: 1.6rem;
    font-weight: 400;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
  }

  // Center the visible glyphs, rather than unequal font ascender/descender space.
  .archive-year-number, .archive-year-count,
  .archive-month-number, .archive-month-unit,
  .archive-month-heading > small, .archive-latest {
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .archive-latest {
    padding: .22rem .3rem;
    border: 1px solid var(--archive-axis);
    border-radius: .25rem;
    background: var(--archive-soft);
    color: var(--primary-color);
    font-size: .65rem;
    line-height: 1;
    white-space: nowrap;
  }

  .archive-post-list {
    margin: .3rem 0 0;
    padding: 0;
    list-style: none;

    li + li { border-top: 1px dashed var(--archive-line); }
  }

  .archive-post-link {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: .5rem;
    padding: .7rem 0;
    color: var(--grey-7);
    line-height: 1.8;

    time {
      color: var(--archive-muted);
      font-size: .75rem;
      font-variant-numeric: tabular-nums;
    }

    &:hover, &:hover time { color: var(--primary-color); }
  }

  .archive-post-title {
    min-width: 0;
    font-size: .85rem;
    overflow-wrap: anywhere;
  }

  .archive-month-more {
    margin-top: .3rem;
    padding-top: .35rem;
    border-top: 1px solid var(--archive-line);

    > summary, .archive-month-collapse {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .5rem;
      min-height: 2rem;
      color: var(--primary-color);
      font-size: .75rem;
      list-style: none;
      cursor: pointer;

      &::-webkit-details-marker { display: none; }
      .ic { transition: transform .2s; }
    }

    .archive-month-collapse {
      display: none;
      width: 100%;
      margin-top: .3rem;
      padding: .45rem 0 .15rem;
      border: 0;
      border-top: 1px solid var(--archive-line);
      background: transparent;
      font-family: inherit;
      text-align: left;
    }

    .archive-more-close { display: none; }
    &[open] {
      .archive-more-open { display: none; }
      .archive-more-close { display: inline; }
      > summary .ic { transform: rotate(180deg); }
    }
  }

  &[data-archive-enhanced='true'] .archive-month-more[open] {
    > summary { display: none; }
    .archive-month-collapse { display: flex; }
  }

  .archive-month-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    padding-top: .25rem;
    color: var(--archive-muted);
    font-size: .7rem;

    > a { flex-shrink: 0; }
  }

  .archive-month-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: .7rem;
    padding: .55rem 0;
    margin-bottom: .25rem;
    border-top: 1px solid var(--archive-line);
    color: var(--archive-muted);
    font-size: .75rem;
    font-variant-numeric: tabular-nums;

    button {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      padding: 0;
      border: 0;
      border-radius: .5rem;
      background: var(--archive-soft);
      color: var(--primary-color);
      cursor: pointer;
      &:hover:not(:disabled) { color: var(--color-blue); }
      &:disabled { opacity: .35; cursor: default; }
    }
  }

  .archive-month-show-all {
    flex-shrink: 0;
    margin-left: auto;
    padding: .25rem .1rem;
    border: 0;
    background: transparent;
    color: var(--primary-color);
    font: inherit;
    cursor: pointer;
    &:hover { color: var(--color-blue); }
  }

  .archive-post-list > li[hidden] + li { border-top: 0; }
  .archive-post-list > li:not([hidden]) + li:not([hidden]) { border-top: 1px dashed var(--archive-line); }

  .archive-categories {
    min-width: 0;
    padding: .05rem .4rem;
    border-radius: .25rem;
    background: var(--grey-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-year-note {
    position: absolute;
    top: 4rem;
    left: calc(50% + 1.8rem);
    max-width: calc(50% - 1.8rem);
    color: var(--archive-muted);
    font-size: .75rem;
    line-height: 2.1;

    > span, > .ic {
      display: block;
      color: var(--archive-axis);
      font-size: 1.5rem;
      line-height: 1.5;
    }

    b {
      color: var(--archive-muted);
      font-size: .65rem;
      font-weight: 400;
      letter-spacing: .06em;
    }
  }

  .archive-year:nth-child(2) .archive-year-note {
    right: calc(50% + 1.8rem);
    left: auto;
    text-align: right;
  }

  .archive-year-rail { min-width: 0; }
  .archive-rail-toggle { display: none; }

  .archive-year-rail-inner {
    position: sticky;
    top: 5rem;
  }

  .archive-rail-title {
    margin: 0 0 1rem;
    color: var(--archive-muted);
    font-size: .75rem;
    letter-spacing: .12em;

    .ic { margin-left: .75rem; color: var(--primary-color); }
  }

  .archive-year-nav {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    border-left: 1px solid var(--archive-line);

    a {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .5rem;
      padding: .35rem .75rem .35rem 1.2rem;
      border-radius: 0 .35rem .35rem 0;
      color: var(--archive-muted);
      font-size: .85rem;
      font-variant-numeric: tabular-nums;

      small { font-size: .7rem; }
      &:hover { color: var(--primary-color); }
      &[aria-current='location'], &.is-active {
        background: var(--archive-soft);
        color: var(--primary-color);

        &::before {
          content: '';
          position: absolute;
          top: .6rem;
          bottom: .6rem;
          left: -2px;
          width: 3px;
          border-radius: 2px;
          background: var(--primary-color);
        }
      }
    }
  }

  .archive-rail-note {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--archive-line);
    color: var(--archive-muted);
    font-size: .7rem;
    line-height: 2.1;

    > span, > .ic { color: var(--archive-axis); font-size: 1.6rem; }
    p { margin: .3rem 0 0; }
  }

  .archive-back-top {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--archive-muted);
    font-size: .75rem;
  }

  .archive-tree-end {
    position: relative;
    padding: .7rem 0 2rem;
    color: var(--archive-muted);
    text-align: center;

    > span, > .ic {
      display: inline-block;
      background: var(--grey-1);
      color: var(--archive-axis);
      font-size: 1.25rem;
      line-height: 1;
    }

    p { margin: .4rem 0 .1rem; font-size: .75rem; }
    small { font-size: .65rem; letter-spacing: .08em; }
  }

  @media (max-width: 1023px) {
    .archive-month-card { padding: .95rem; }
  }

  // Preserve readable cards alongside the site's full profile/menu sidebar.
  // Wide desktops keep the two-sided tree; narrower body columns use one axis.
  @media (min-width: 768px) and (max-width: 1199px) {
    .archive-tree-panel { padding-left: 0; }
    .archive-tree::before { left: .875rem; }
    .archive-year-title { justify-content: flex-start; }
    .archive-year-body { display: block; }
    .archive-month-card, .archive-month-card.is-right, .archive-month-card.is-offset {
      margin: 0 0 1rem 1.875rem;

      &::before { right: auto; left: -.4rem; transform: rotate(-135deg); }
      .archive-month-node { right: auto; left: -1.375rem; }
    }

    .archive-year-note { display: none; }
    .archive-tree-end { text-align: left; margin-left: .4rem; }
    .archive-tree-end p, .archive-tree-end small { padding-left: 2rem; }
    .archive-tree-end p { margin-top: -1.45rem; }
  }

  @media (max-width: 767px) {
    .archive-toolbar { gap: .45rem; margin-bottom: 1.1rem; }
    .archive-expand { font-size: .75rem; }
    .archive-heading .item.header { font-size: 1.15rem; line-height: 1.7; }
    .archive-heading-description { font-size: .75rem; }

    .archive-tree-layout { display: flex; flex-direction: column; gap: 0; padding-top: 0; }
    .archive-tree-content { order: 2; padding-top: 1.25rem; }
    .archive-year-rail {
      position: sticky;
      top: 3.125rem;
      z-index: 3;
      order: 1;
      margin: 0 -.25rem;
      border-bottom: 1px solid var(--archive-line);
      background: var(--grey-1);
    }

    .archive-year-rail-inner { position: static; }
    .archive-rail-title, .archive-rail-note, .archive-back-top { display: none; }
    .archive-year-nav {
      flex-direction: row;
      gap: .2rem;
      padding: .65rem .25rem;
      border: 0;
      overflow-x: auto;
      scrollbar-width: none;

      &::-webkit-scrollbar { display: none; }
      a {
        flex-shrink: 0;
        padding: .4rem .7rem;
        border-radius: .4rem;
        font-size: .8rem;

        small { display: none; }
        &[aria-current='location']::before, &.is-active::before { display: none; }
      }
    }

    .archive-tree::before { left: .875rem; }
    .archive-year { scroll-margin-top: 5rem; }
    .archive-year-title { justify-content: flex-start; margin-bottom: .9rem; }
    .archive-year-pill { padding: .2rem .75rem .2rem .55rem; gap: .5rem; }
    .archive-year-number { font-size: 1.4rem; }
    .archive-year-body { display: block; }
    .archive-month-card, .archive-month-card.is-right, .archive-month-card.is-offset {
      margin: 0 0 .9rem 1.875rem;
      --archive-month-heading-center: 1.75rem;
      padding: .95rem 1rem .75rem;
      border-radius: .7rem;

      &::before { right: auto; left: -.4rem; transform: rotate(-135deg); }
      .archive-month-node { right: auto; left: -1.375rem; }
    }

    .archive-month-heading { gap: .4rem; }
    .archive-post-link { grid-template-columns: 1.25rem minmax(0, 1fr); gap: .4rem; }
    .archive-post-title { font-size: .85rem; line-height: 1.85; }
    .archive-year-note { display: none; }
    .archive-tree-end { text-align: left; margin-left: .4rem; }
    .archive-tree-end p, .archive-tree-end small { padding-left: 2rem; }
    .archive-tree-end p { margin-top: -1.45rem; }
  }

  // All screen sizes share the same floating year picker after enhancement.
  &[data-archive-enhanced='true'] {
    .archive-tree-layout { display: block; }
    // Scoped archives lack the tree's closing note; leave room for the picker.
    .archive-tree-content:not(:has(.archive-tree-end)) { padding-bottom: 3.5rem; }
    .archive-year-rail {
      position: fixed;
      visibility: hidden;
      top: auto;
      right: var(--archive-picker-right, 3rem);
      bottom: unquote('max(1.25rem, env(safe-area-inset-bottom))');
      transform: translateY(var(--archive-picker-offset-y, 0px));
      z-index: 8;
      margin: 0;
      border: 1px solid var(--archive-line);
      border-radius: 1.4rem;
      background: var(--grey-1);
      box-shadow: 0 .25rem 1.25rem var(--box-bg-shadow);
      &[data-positioned='true'] { visibility: visible; }
    }

    .archive-year-rail-inner {
      position: static;
      display: flex;
      flex-direction: column-reverse;
      padding: .2rem;
    }
    .archive-rail-title, .archive-rail-note, .archive-back-top { display: none; }
    .archive-rail-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .55rem;
      min-height: 2.4rem;
      padding: .35rem .8rem;
      border: 0;
      border-radius: 1.3rem;
      background: transparent;
      color: var(--primary-color);
      font: inherit;
      font-size: .9rem;
      font-variant-numeric: tabular-nums;
      cursor: pointer;

      .ic:last-child { font-size: .7rem; transition: transform .2s; }
    }

    .archive-year-nav {
      display: none;
      flex-direction: column;
      gap: .2rem;
      max-height: unquote('min(55dvh, 19rem, var(--archive-picker-nav-max-height, 19rem))');
      padding: .35rem .25rem;
      border: 0;
      overflow-y: auto;

      a {
        min-height: 2.3rem;
        padding: .4rem .75rem;
        border-radius: .65rem;
        &::before { display: none; }
      }
      small { display: inline; margin-left: 1.5rem; }
    }

    .archive-year-rail[data-expanded='true'] {
      border-radius: 1rem;
      .archive-year-nav { display: flex; }
      .archive-rail-toggle .ic:last-child { transform: rotate(180deg); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; animation: none !important; }
  }
}
