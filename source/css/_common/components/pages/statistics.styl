#statistics_container
  --statistics-scale-low #fce9ee
  --statistics-scale-mid #f1acc0
  --statistics-scale-high #df5d82
  --statistics-bar-start #f3b3c5
  --statistics-summary-bg rgba(237, 111, 145, .045)
  --statistics-ui-accent var(--primary-color)
  --statistics-map-fill #f2edf0
  --statistics-map-border #c4b3bd
  --statistics-map-hover rgba(236, 140, 105, .3)
  --statistics-map-label var(--grey-7)
  --statistics-map-accent var(--statistics-ui-accent)
  display grid
  gap 1.5rem
  min-width 0

  .statistics-panel
    min-width 0
    position relative
    padding 1.25rem
    border 1px solid var(--grey-3)
    border-radius .5rem
    background var(--grey-1)
    box-shadow 0 3px 12px var(--box-bg-shadow)

  .statistics-comment-note button
    padding 0
    border 0
    background transparent
    color var(--primary-color)
    font inherit
    cursor pointer
    &:hover
      text-decoration underline
    &:focus-visible
      outline 2px solid var(--primary-color)
      outline-offset 3px

  .statistics-header
    display flex
    align-items center
    justify-content space-between
    flex-wrap wrap
    gap .75rem 1.25rem
    margin-bottom 1rem

  .statistics-heading
    margin 0 0 0 1.875rem
    padding 0
    min-width 0
    overflow-wrap anywhere
    &::after
      display none
    .anchor::before
      top 0
      left -1.875rem
      line-height inherit

  .statistics-map-toolbar
    display flex
    align-items center
    flex-shrink 0
    gap .75rem
    margin-left auto

  .statistics-map-summary
    margin 0
    color var(--grey-6)
    font-size .8rem
    strong
      color var(--primary-color)
      font-weight 600
      font-variant-numeric tabular-nums

  .statistics-map-detail
    order 1
    flex-basis 100%
    display flex
    align-items center
    justify-content space-between
    flex-wrap wrap
    gap .75rem

  .statistics-map-ranking-title
    padding .25rem .45rem .65rem
    color var(--statistics-map-accent)
    font-size .85rem
    font-weight 600

  .statistics-map-tooltip-title
    color var(--statistics-map-accent)
    font-weight 600
    margin-bottom 4px

  .statistics-loading
    width 2.75rem
    height 2.75rem
    margin 1rem auto
    border .3rem solid transparent
    border-top-color #ff32a8
    border-radius 50%
    animation statistics-spin .7s linear infinite

  .statistics-feedback
    display flex
    flex-direction column
    justify-content center
    align-items center
    min-height 160px
    padding 1rem
    text-align center
    gap .75rem

  .is-ready .statistics-feedback
    min-height 80px
    padding .5rem
    .statistics-loading
      width 1.75rem
      height 1.75rem
      border-width .2rem

  @media (prefers-reduced-motion: reduce)
    .statistics-loading
      animation none

  [hidden]
    display none !important

  .statistics-status
    color var(--grey-6)
    margin 0
    font-size .9rem

  button
    margin 0
    padding .25rem .9rem
    color var(--primary-color)
    border 1px solid currentColor
    border-radius 6px
    background transparent
    cursor pointer
    transition color .2s, background .2s
    &:hover
      background var(--color-red-a1)

  button:focus-visible
    outline 2px solid var(--primary-color)
    outline-offset 3px

  .statistics-map-controls, .statistics-map-zoom, .statistics-content-controls
    display flex
    width fit-content
    gap .125rem
    padding .1875rem
    margin 0
    border-radius .5rem
    background var(--grey-2)
    button
      display grid
      place-items center
      margin 0
      width 2.25rem
      height 2.25rem
      padding 0
      border 0
      border-radius .375rem
      color var(--grey-6)
      &:hover:not(:disabled), &:focus-visible:not(:disabled)
        color var(--statistics-ui-accent)
        background var(--color-red-a1)
      &:focus-visible
        outline-color var(--primary-color)
      &:disabled
        opacity .35
        cursor default
      &[aria-pressed="true"]
        color var(--statistics-ui-accent)
        background var(--grey-1)
        box-shadow 0 1px 4px var(--box-bg-shadow)
    .ic
      width 1rem
      height 1rem
      margin 0
      font-size 1rem
      line-height 1

  .statistics-chart
    height 260px
    width 100%

  .statistics-legend-frame
    position relative
    min-width 0
    padding 0 1.875rem

  .statistics-legend
    display flex
    align-items center
    gap .85rem
    max-width 100%
    overflow-x auto
    padding .25rem .15rem
    overscroll-behavior-x contain
    scrollbar-width none
    &::-webkit-scrollbar
      display none
    touch-action pan-x pan-y
    cursor grab
    user-select none
    &.is-dragging
      cursor grabbing
    button
      display inline-flex
      align-items center
      flex 0 0 auto
      gap .35rem
      padding .15rem 0
      border 0
      border-radius 3px
      background transparent
      color var(--tooltip-text, var(--grey-6))
      font-size 12px
      white-space nowrap
      cursor inherit
      &[aria-pressed="false"]
        opacity .4
      &:hover
        background transparent
        color var(--primary-color)
    .statistics-legend-swatch
      width 18px
      height 10px
      border-radius 3px
      flex 0 0 auto

  .statistics-map-layout
    position relative

  .statistics-map-scale
    position absolute
    left .5rem
    bottom 1.5rem
    z-index 3
    font-size 11px
    color var(--grey-6)
    pointer-events none
    > span
      display block
      margin .65rem 0
    .statistics-map-scale-bar
      position relative
      width 12px
      height 105px
      background linear-gradient(0deg, var(--statistics-scale-low), var(--statistics-scale-mid), var(--statistics-scale-high))
      &::before, &::after
        content ''
        position absolute
        left -1px
        width 14px
        height 3px
        border-radius 3px
      &::before
        top -5px
        background var(--statistics-scale-high)
      &::after
        bottom -5px
        background var(--statistics-scale-low)
      span
        position absolute
        left 21px
        white-space nowrap
      .statistics-map-scale-max
        top -10px
      .statistics-map-scale-min
        bottom -10px

  .statistics-map-aside
    position absolute
    right 0
    top 1rem
    z-index 4
    max-width 30%
    max-height 100%
    display flex
    flex-direction column

  .statistics-map-ranking
    min-height 0
    list-style none
    margin 0
    padding .25rem .35rem
    max-height 420px
    overflow-y auto
    scrollbar-width thin
    scrollbar-color transparent transparent
    transition scrollbar-color .3s
    &.is-scrolling
      scrollbar-color var(--statistics-map-border) transparent
    &::-webkit-scrollbar
      width 3px
    &::-webkit-scrollbar-track
      background transparent
    &::-webkit-scrollbar-button
      display none
    &::-webkit-scrollbar-thumb
      border-radius 3px
      background transparent
    &.is-scrolling::-webkit-scrollbar-thumb
      background var(--statistics-map-border)
    li
      margin 0
      padding 0
      &::before
        display none
    button
      display grid
      grid-template-columns 1.45rem var(--region-width, 4em) minmax(3.2rem, 4.5rem)
      align-items center
      gap .4rem
      width 100%
      padding .45rem .1rem
      border 0
      color var(--statistics-map-label)
      font-size .8rem
      &:hover, &:focus-visible
        background var(--grey-2)
    .statistics-map-rank
      border-radius .45rem
      background var(--statistics-map-fill)
      line-height 1.6rem
      text-align center
    .statistics-map-region
      text-align right
      white-space nowrap
      overflow hidden
      text-overflow ellipsis
    .statistics-map-bar
      position relative
      isolation isolate
      border-radius 1rem
      background var(--statistics-map-fill)
      text-align left
      padding .1rem .5rem
      overflow hidden
      &::before
        content ''
        position absolute
        z-index -1
        inset 0 auto 0 0
        width var(--visit-share)
        background linear-gradient(90deg, var(--statistics-bar-start), var(--statistics-scale-high))
        opacity .6
        border-radius inherit
    .statistics-map-ranking-empty
      color var(--grey-6)
      font-size .85rem
      text-align center

  [data-chart="map"] .statistics-chart
    height auto
    aspect-ratio 1.3
    width 100%
    max-width none
    margin 0 auto
    position relative
    overflow hidden

  .statistics-map-hit
    position absolute
    z-index 2
    padding 0
    border 1px dashed transparent
    border-radius .75rem
    background transparent
    color var(--grey-7)
    cursor pointer
    transition border-color .2s, background .2s
    &:hover, &:focus-visible, &.is-active
      border-color var(--statistics-map-border)
      background transparent

  [data-map-mode="world"] .statistics-chart
    aspect-ratio 1.6

  .statistics-calendar-scroll
    overflow-x auto
    overflow-y hidden
    scrollbar-width none
    cursor grab
    touch-action pan-x pan-y
    &::-webkit-scrollbar
      display none
    &.is-dragging
      cursor grabbing
      user-select none
    canvas
      touch-action pan-x pan-y !important
    .statistics-chart
      min-width 640px
      height auto
      aspect-ratio 54 / 10

  .statistics-calendar-frame
    position relative
    min-width 0

  .statistics-calendar-arrow
    position absolute
    z-index 5
    top 50%
    transform translateY(-50%)
    display grid
    place-items center
    width 1.75rem
    height 1.75rem
    padding 0
    border 0
    background transparent
    box-shadow none
    color var(--statistics-ui-accent)
    &:hover
      background transparent
    .ic
      display block
      margin 0
      font-size 1rem
      line-height 1
      animation statistics-scroll-hint 1.8s ease-in-out infinite
    &.is-left
      left 0
      --scroll-hint-distance -3px
    &.is-right
      right 0
      --scroll-hint-distance 3px
    @media (prefers-reduced-motion: reduce)
      .ic
        animation none

  .statistics-calendar-frame
    &:has(> .statistics-calendar-arrow:not([hidden]))
      padding-bottom 2rem
    > .statistics-calendar-arrow
      top auto
      bottom 0
      transform none

  .statistics-calendar-frame, .statistics-legend-frame
    > .statistics-calendar-arrow
      border-radius 6px
      background unquote('color-mix(in srgb, var(--grey-1) 65%, transparent)')
      border 1px solid unquote('color-mix(in srgb, var(--grey-4) 35%, transparent)')
      backdrop-filter blur(8px)
      -webkit-backdrop-filter blur(8px)
      &:hover
        background unquote('color-mix(in srgb, var(--grey-2) 85%, transparent)')

  .statistics-content-plot
    position relative
  .statistics-content-links
    position absolute
    top 10px
    bottom 35px
    left 0
    display grid
    font-size 12px
    a, button
      display flex
      align-items center
      justify-content flex-end
      min-width 0
      padding-right 4px
      border 0
      background transparent
      font inherit
      cursor pointer
      color var(--grey-7)
      &:hover, &:focus-visible
        color var(--color-blue)
      span
        overflow hidden
        text-overflow ellipsis
        white-space nowrap

  .statistics-map-toggle
    display none

  .statistics-calendar-footer
    display flex
    justify-content space-between
    align-items center
    flex-wrap wrap
    gap .75rem
    padding .6rem 0 1rem
    color var(--grey-6)
    font-size .75rem

  .statistics-calendar-scale
    display flex
    align-items center
    gap 2px
    span
      margin 0 .35rem
    i
      width 12px
      height 12px
      border-radius 2px

  .statistics-calendar-totals
    position relative
    isolation isolate
    display grid
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap 0
    overflow hidden
    border-radius 8px
    &::before
      content ''
      position absolute
      inset 0
      z-index -1
      border-radius 8px
      background var(--statistics-summary-bg)
      pointer-events none
    > div
      display flex
      flex-direction column
      gap .25rem
      padding 1rem .6rem
      text-align center
    span
      font-size .8rem
      color var(--grey-6)
    strong
      font-size 1.65rem
      line-height 1.4
      font-weight 500
      color var(--primary-color)
      font-variant-numeric tabular-nums
    small
      font-size .65rem
      color var(--grey-6)
      font-variant-numeric tabular-nums

  @media (max-width: 600px)
    .statistics-calendar-scroll .statistics-chart
      min-width 600px
    .statistics-calendar-totals
      grid-template-columns minmax(0, 1fr)
      > div
        display grid
        grid-template-columns minmax(0, 1fr) auto
        align-items center
        padding .7rem 1rem
        text-align left
      strong
        grid-column 2
        grid-row 1 / 3
        font-size 1.4rem

  .statistics-trend-controls
    display flex
    flex-wrap wrap
    gap .25rem
    margin-left auto
    button
      border 0
      color var(--grey-6)
      font-size .8rem
      min-height 2rem
      &[aria-pressed="true"]
        color var(--primary-color)
        background var(--color-red-a1)

  .statistics-content-toolbar
    display contents

  .statistics-posts-range
    margin-left auto
    display flex
    align-items center
    gap .5rem
    font-size .8rem
    color var(--grey-6)

  [data-chart="posts"] .statistics-chart
    height 310px

  [data-chart="clock"] .statistics-chart
    height 340px

  .statistics-content-controls
    max-width 100%
    flex-wrap wrap
    button
      width auto
      height auto
      min-height 2rem
      padding .3rem .7rem
      font-size .8rem
      white-space nowrap

  .statistics-content-actions
    display flex
    align-items center
    justify-content flex-end
    flex-wrap wrap
    gap .5rem
    margin-left auto

  .statistics-content-picker
    display flex
    align-items center

  .statistics-content-picker .select-picker-trigger, .statistics-posts-range .select-picker-trigger
    padding .4rem .65rem
    min-width 6rem
    min-height 2.375rem
    justify-content space-between
    border 1px solid var(--grey-3)
    border-radius .5rem
    color var(--grey-6)
    background var(--grey-2)
    font-size .8rem
    line-height 1.5
    &[aria-expanded="true"]
      color var(--statistics-ui-accent)
      border-color currentColor

  .statistics-trend-summary
    display grid
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap 1rem
    margin-bottom 1rem
    > div
      display flex
      flex-direction column
      gap .25rem
    span
      color var(--grey-6)
      font-size .8rem
    strong
      font-size 1.4rem
      font-weight 500
      font-variant-numeric tabular-nums

  .statistics-trend-range
    color var(--grey-6)
    font-size .75rem
    margin .5rem 0 0

  [data-chart="trends"] .statistics-chart
    height 320px

  @media (max-width: 600px)
    .statistics-trend-summary
      grid-template-columns 1fr
      > div
        flex-direction row
        align-items center
        justify-content space-between

  @media (max-width: 600px)
    .statistics-panel
      padding 1rem .75rem
    [data-chart="map"] .statistics-chart
      width 100%
    .statistics-map-layout
      padding-bottom 0
    .statistics-map-scale
      top 7rem
      bottom auto
    .statistics-map-aside
      position absolute
      top .75rem
      right 0
      transform none
      z-index 6
      max-width calc(100% - 2rem)
      width 15rem
      max-height calc(100% - 1.5rem)
      margin 0
      padding 2.5rem .5rem .5rem
      border 1px solid var(--grey-3)
      border-radius 8px
      background var(--grey-1)
      background unquote('color-mix(in srgb, var(--grey-1) 82%, transparent)')
      backdrop-filter blur(16px)
      -webkit-backdrop-filter blur(16px)
      box-shadow 0 4px 18px var(--box-bg-shadow)
    .statistics-map-ranking
      max-height 340px
      flex 1
    .statistics-map-toggle
      display grid
      place-items center
      position absolute
      top .75rem
      right 0
      z-index 7
      width 1.75rem
      height 3rem
      padding 0
      border 1px solid unquote('color-mix(in srgb, var(--grey-4) 40%, transparent)')
      border-radius 6px 0 0 6px
      color var(--statistics-ui-accent)
      background unquote('color-mix(in srgb, var(--grey-1) 55%, transparent)')
      backdrop-filter blur(8px)
      -webkit-backdrop-filter blur(8px)
      box-shadow 0 1px 4px var(--box-bg-shadow)
      --scroll-hint-distance -3px
      .ic
        display block
        margin 0
        line-height 1
        animation statistics-scroll-hint 1.8s ease-in-out infinite
      @media (prefers-reduced-motion: reduce)
        .ic
          animation none
      &:hover
        background unquote('color-mix(in srgb, var(--grey-1) 75%, transparent)')
    .is-ranking-open .statistics-map-toggle
      --scroll-hint-distance 3px
      height 2rem
      border 0
      background transparent
      box-shadow none

@keyframes statistics-spin
  to
    transform rotate(360deg)

.statistics-comments-dialog
  position fixed
  inset 0
  margin auto
  width unquote('min(1100px, calc(100vw - 2rem))')
  height unquote('min(850px, calc(100dvh - 2rem))')
  max-height none
  max-width none
  overflow hidden
  padding 0
  border 1px solid var(--grey-3)
  border-radius 1rem
  color var(--grey-7)
  background unquote('color-mix(in srgb, var(--grey-1) 90%, transparent)')
  backdrop-filter blur(18px)
  box-shadow 0 1rem 3rem var(--box-bg-shadow)
  &[open]
    display flex
    flex-direction column
  &::backdrop
    background rgba(0, 0, 0, .3)
    backdrop-filter blur(4px)
  > header
    flex-shrink 0
    display flex
    align-items center
    gap 1rem
    padding 1rem 1.5rem
    border-bottom 1px solid var(--grey-4)
    h2
      margin 0
      font-size 1.15rem
      line-height 1.4
      overflow-wrap anywhere
      &::before, &::after
        display none
    >span
      color var(--primary-color)
      white-space nowrap
  > header > button, .statistics-comments-body > button
    cursor pointer
    border 1px solid var(--grey-4)
    border-radius .75rem
    padding .4rem .8rem
    color var(--primary-color)
    background var(--grey-1)
    &:hover
      border-color var(--primary-color)
    &:focus-visible
      outline 2px solid var(--primary-color)
      outline-offset 3px
  .statistics-comments-close
    margin-left auto
    flex-shrink 0
    display grid
    place-items center
    width 2rem
    height 2rem
    padding 0
    border 0
    border-radius .5rem
    background transparent
    color var(--grey-6)
    font-size 1rem
    transition background .2s, color .2s, transform .2s
    &:focus-visible
      outline none
    &:hover
      color var(--primary-color)
      background var(--color-pink-a1)
      transform translateY(-1px)
  .statistics-comments-body
    flex 1
    min-height 0
    overflow-y auto
    overscroll-behavior contain
    padding 1.5rem
    scrollbar-width thin
    scrollbar-color var(--grey-4) transparent
    > ol
      position relative
      list-style none
      margin 0 0 1rem
      padding 0
      display grid
      grid-template-columns minmax(0, 1fr) minmax(0, 1fr)
      column-gap 3rem
      &::before
        content ''
        position absolute
        left calc(50% - 1px)
        top 0
        bottom 0
        width 2px
        background var(--color-red-a3)
    > ol > li
      grid-column 1
      position relative
      border 1px solid var(--grey-3)
      border-radius .75rem
      padding 1rem
      margin 0 0 1rem
      background var(--grey-1)
      box-shadow 0 3px 12px var(--box-bg-shadow)
      &:nth-child(even)
        grid-column 2
      &:not(:first-child)
        margin-top -.25rem
      &::before
        content ''
        position absolute
        right -1.85rem
        top 1.3rem
        width .6rem
        height .6rem
        background var(--primary-color)
        border-radius 50%
        border 2px solid var(--grey-1)
      &::after
        content ''
        position absolute
        top 1.4rem
        right -.35rem
        width .6rem
        height .6rem
        transform rotate(45deg)
        background var(--grey-1)
        border-top 1px solid var(--grey-3)
        border-right 1px solid var(--grey-3)
      &:nth-child(even)::before
        left -1.85rem
        right auto
      &:nth-child(even)::after
        left -.35rem
        right auto
        transform rotate(225deg)
      time
        color var(--grey-5)
        font-size .8rem
      a, span, strong
        overflow-wrap anywhere
  .statistics-comment-post
    display block
    width fit-content
    max-width 100%
    margin-bottom .65rem
    font-size .9rem
    line-height 1.5
    font-weight 600
    color var(--text-color)
    overflow-wrap anywhere
    transition color .2s ease
    &:hover, &:focus-visible
      color var(--primary-color)
  .statistics-comment-meta
    display grid
    grid-template-columns 2.25rem minmax(0, 1fr)
    gap .15rem .65rem
    align-items center
    margin-bottom .65rem
    line-height 1.4
  .statistics-comment-identity
    display flex
    align-items center
    flex-wrap wrap
    gap .4rem .5rem
    min-width 0
    .statistics-comment-name
      display inline-flex
      align-items center
      font-size 1rem
      line-height 1.5
      font-weight 600
      color var(--primary-color)
    time
      flex 0 0 auto
      white-space nowrap
      line-height 1.4
  .statistics-comment-badge
    display inline-flex
    align-items center
    justify-content center
    box-sizing border-box
    margin 0
    padding .125rem .5rem
    line-height 1.5
    font-size .75rem
    font-weight 600
    border-radius 999px
    border 1px solid var(--badge-light-border, var(--color-pink-a3))
    color var(--badge-light-text, var(--primary-color))
    background var(--badge-light-background, linear-gradient(120deg, var(--color-pink-light), var(--color-red-a3)))
    > span
      // Optical correction for the site's CJK font; keep the pill box centered.
      transform translateY(.04em)
    html[data-theme='dark'] &
      border-color var(--badge-dark-border, var(--color-pink-a3))
      color var(--badge-dark-text, var(--primary-color))
      background var(--badge-dark-background, linear-gradient(120deg, var(--color-pink-light), var(--color-red-a3)))
  .statistics-comment-details
    display flex
    flex-wrap wrap
    gap .3rem
    margin-bottom .5rem
    &:empty
      display none
    >span
      display inline-flex
      align-items center
      gap .3rem
      font-size .7rem
      line-height 1.4
      padding .15rem .4rem
      border 1px solid var(--grey-3)
      border-radius 1rem
      color var(--grey-6)
      &::before
        flex 0 0 1em
        margin 0
        background-size contain
  .statistics-comment-excerpt
    comment-content()
    display block
    overflow-wrap anywhere
    white-space normal
    color inherit
    p, blockquote, pre, ul, ol
      margin .5rem 0
    > :first-child
      margin-top 0
    > :last-child
      margin-bottom 0
    a
      color var(--color-blue)
    ul, ol
      padding-left 1.5rem
    img
      max-width 100%
      max-height 20rem
      height auto
      object-fit contain
  .statistics-comment-avatar
    position relative
    display grid
    place-items center
    width 2.25rem
    height 2.25rem
    overflow hidden
    border-radius 50%
    color var(--primary-color)
    background var(--color-red-a1)
    img
      position absolute
      inset 0
      width 100%
      height 100%
      object-fit cover
      margin 0
  @media (max-width: 767px)
    > header
      padding 1rem
      gap .5rem
    .statistics-comments-body
      padding 1rem
      > ol
        display block
        padding-left 1.25rem
        &::before
          left 0
      > ol > li
        margin-top 0
        &::before, &:nth-child(even)::before
          left -1.6rem
          right auto
        &::after, &:nth-child(even)::after
          left -.35rem
          right auto
          transform rotate(225deg)

@keyframes statistics-scroll-hint
  0%, 100%
    transform translateX(0)
  50%
    transform translateX(var(--scroll-hint-distance))

[data-theme="dark"] #statistics_container
  --statistics-scale-low #67434f
  --statistics-scale-mid #b37187
  --statistics-scale-high #f0a1b8
  --statistics-bar-start #b87a8e
  --statistics-summary-bg rgba(240, 161, 184, .045)
  --statistics-ui-accent #f0adc7
  --statistics-map-fill #3c343a
  --statistics-map-border #9c8490
  --statistics-map-hover rgba(244, 174, 148, .4)
  --statistics-map-label #f3fbff

.select-picker-menu[data-picker="statistics"]
  border-color var(--grey-3)
  border-radius .5rem
  .select-picker-option
    &:hover, &:focus-visible
      background var(--color-red-a1)
    &[aria-selected="true"]
      color var(--primary-color)
      background var(--color-red-a1)

[data-theme="dark"] .select-picker-menu[data-picker="statistics"] .select-picker-option[aria-selected="true"]
  color #f0adc7
