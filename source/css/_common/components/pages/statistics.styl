#statistics_container
  --statistics-map-fill #e8eff3
  --statistics-map-border #a7b8c2
  --statistics-map-hover rgba(126, 189, 224, .72)
  --statistics-map-label #23465e
  display grid
  gap 2.5rem
  min-width 0

  .statistics-panel
    min-width 0
    position relative
    padding .5rem 0

  .statistics-heading
    margin 0 0 1rem
    font-size 1.1rem
    text-align center
    border 0
    padding 0

  .statistics-loading
    width 2.75rem
    height 2.75rem
    margin 1rem auto
    border .3rem solid transparent
    border-top-color #ff32a8
    border-radius 50%
    animation statistics-spin .7s linear infinite

  .statistics-feedback
    display flex
    flex-direction column
    justify-content center
    align-items center
    min-height 160px
    padding 1rem
    text-align center
    gap .75rem

  .is-ready .statistics-feedback
    min-height 80px
    padding .5rem
    .statistics-loading
      width 1.75rem
      height 1.75rem
      border-width .2rem

  @media (prefers-reduced-motion: reduce)
    .statistics-loading
      animation none

  [hidden]
    display none !important

  .statistics-status
    color var(--grey-6)
    margin 0
    font-size .9rem

  button
    margin 0
    padding .25rem .9rem
    color var(--primary-color)
    border 1px solid currentColor
    border-radius 6px
    background transparent
    cursor pointer
    transition color .2s, background .2s
    &:hover
      background var(--color-red-a1)

  button:focus-visible
    outline 2px solid var(--primary-color)
    outline-offset 3px

  .statistics-map-controls
    display flex
    width fit-content
    gap .1rem
    padding .15rem
    margin 0 0 .5rem auto
    border-radius .6rem
    background var(--grey-3)
    button
      display grid
      place-items center
      margin 0
      width 2rem
      height 1.65rem
      padding .25rem .4rem
      border 0
      border-radius .45rem
      color var(--grey-6)
      &[aria-pressed="true"]
        color var(--primary-color)
        background var(--grey-1)
        box-shadow 0 1px 4px var(--box-bg-shadow)
    .ic
      width 1rem
      height 1rem
      margin 0
      font-size 1rem
      line-height 1

  .statistics-chart
    height 260px
    width 100%

  .statistics-legend
    display flex
    align-items center
    gap .85rem
    max-width 100%
    overflow-x auto
    padding .25rem .15rem .55rem
    overscroll-behavior-x contain
    scrollbar-width thin
    scrollbar-color var(--grey-4) transparent
    touch-action pan-x pan-y
    cursor grab
    user-select none
    &.is-dragging
      cursor grabbing
    button
      display inline-flex
      align-items center
      flex 0 0 auto
      gap .35rem
      padding .15rem 0
      border 0
      border-radius 3px
      background transparent
      color var(--tooltip-text, var(--grey-6))
      font-size 12px
      white-space nowrap
      cursor inherit
      &[aria-pressed="false"]
        opacity .4
      &:hover
        background transparent
        color var(--primary-color)
    .statistics-legend-swatch
      width 18px
      height 10px
      border-radius 3px
      flex 0 0 auto

  .statistics-map-layout
    position relative

  .statistics-map-scale
    position absolute
    left .5rem
    bottom 1.5rem
    z-index 3
    font-size 11px
    color var(--grey-6)
    pointer-events none
    > span
      display block
      margin .65rem 0
    .statistics-map-scale-bar
      position relative
      width 12px
      height 105px
      background linear-gradient(0deg, #92d0f9, #49b1f5)
      &::before, &::after
        content ''
        position absolute
        left -1px
        width 14px
        height 3px
        border-radius 3px
      &::before
        top -5px
        background #49b1f5
      &::after
        bottom -5px
        background #92d0f9
      span
        position absolute
        left 21px
        white-space nowrap
      .statistics-map-scale-max
        top -10px
      .statistics-map-scale-min
        bottom -10px

  .statistics-map-aside
    position absolute
    right 0
    top 50%
    transform translateY(-50%)
    z-index 4
    max-width 30%
    max-height 100%
    display flex
    flex-direction column

  .statistics-map-zoom
    display flex
    justify-content center
    align-self center
    flex-shrink 0
    gap .1rem
    padding .15rem
    margin 0 .35rem .6rem
    border-radius .6rem
    background var(--grey-3)
    button
      display grid
      place-items center
      width 2rem
      height 1.65rem
      padding 0
      border 0
      border-radius .45rem
      color var(--statistics-map-label)
      background transparent
      transition background .2s, box-shadow .2s, opacity .2s
      &:hover:not(:disabled), &:focus-visible:not(:disabled)
        background var(--grey-1)
        box-shadow 0 1px 4px var(--box-bg-shadow)
      &:disabled
        opacity .35
        cursor default
      .ic
        margin 0
        font-size 1rem

  .statistics-map-ranking
    min-height 0
    list-style none
    margin 0
    padding .25rem .35rem
    max-height 420px
    overflow-y auto
    scrollbar-width thin
    scrollbar-color transparent transparent
    transition scrollbar-color .3s
    &.is-scrolling
      scrollbar-color var(--statistics-map-border) transparent
    &::-webkit-scrollbar
      width 3px
    &::-webkit-scrollbar-track
      background transparent
    &::-webkit-scrollbar-button
      display none
    &::-webkit-scrollbar-thumb
      border-radius 3px
      background transparent
    &.is-scrolling::-webkit-scrollbar-thumb
      background var(--statistics-map-border)
    li
      margin 0
      padding 0
      &::before
        display none
    button
      display grid
      grid-template-columns 1.45rem var(--region-width, 4em) minmax(3.2rem, 4.5rem)
      align-items center
      gap .4rem
      width 100%
      padding .45rem .1rem
      border 0
      color var(--statistics-map-label)
      font-size .8rem
      &:hover, &:focus-visible
        background var(--grey-2)
    .statistics-map-rank
      border-radius .45rem
      background var(--statistics-map-fill)
      line-height 1.6rem
      text-align center
    .statistics-map-region
      text-align right
      white-space nowrap
      overflow hidden
      text-overflow ellipsis
    .statistics-map-bar
      position relative
      isolation isolate
      border-radius 1rem
      background var(--statistics-map-fill)
      text-align left
      padding .1rem .5rem
      overflow hidden
      &::before
        content ''
        position absolute
        z-index -1
        inset 0 auto 0 0
        width var(--visit-share)
        background linear-gradient(90deg, #92d0f9, #49b1f5)
        opacity .6
        border-radius inherit
    .statistics-map-ranking-empty
      color var(--grey-6)
      font-size .85rem
      text-align center

  [data-chart="map"] .statistics-chart
    height auto
    aspect-ratio 1.3
    width 100%
    max-width none
    margin 0 auto
    position relative
    overflow hidden

  .statistics-map-hit
    position absolute
    z-index 2
    padding 0
    border 1px dashed transparent
    border-radius .75rem
    background transparent
    color var(--grey-7)
    cursor pointer
    transition border-color .2s, background .2s
    &:hover, &:focus-visible, &.is-active
      border-color var(--statistics-map-border)
      background transparent

  [data-map-mode="world"] .statistics-chart
    aspect-ratio 1.6

  .statistics-calendar-scroll
    overflow-x auto
    scrollbar-width thin
    .statistics-chart
      min-width 640px
      height auto
      aspect-ratio 54 / 10

  .statistics-calendar-footer
    display flex
    justify-content space-between
    align-items center
    flex-wrap wrap
    gap .75rem
    padding .6rem 0 1rem
    color var(--grey-6)
    font-size .75rem

  .statistics-calendar-scale
    display flex
    align-items center
    gap 2px
    span
      margin 0 .35rem
    i
      width 12px
      height 12px
      border-radius 2px

  .statistics-calendar-totals
    display grid
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap .75rem
    > div
      display flex
      flex-direction column
      gap .25rem
      padding .9rem .6rem
      border 1px solid var(--grey-3)
      border-radius .8rem
      background linear-gradient(135deg, var(--color-red-a1), transparent)
      text-align center
    span
      font-size .8rem
      color var(--grey-6)
    strong
      font-size 1.65rem
      line-height 1.4
      font-weight 500
      color var(--primary-color)
      font-variant-numeric tabular-nums
    small
      font-size .65rem
      color var(--grey-6)
      font-variant-numeric tabular-nums

  @media (max-width: 600px)
    .statistics-calendar-totals
      grid-template-columns minmax(0, 1fr)
      > div
        display grid
        grid-template-columns 1fr auto
        align-items center
        padding .7rem 1rem
        text-align left
      strong
        grid-column 2
        grid-row 1 / 3
        font-size 1.4rem

  @media (max-width: 600px)
    .statistics-panel
      padding .5rem 0
    [data-chart="map"] .statistics-chart
      width 100%
    .statistics-map-layout
      padding-bottom 0
    .statistics-map-scale
      top 7rem
      bottom auto
    .statistics-map-aside
      position relative
      top auto
      right auto
      transform none
      max-width none
      width fit-content
      margin .5rem auto 0
    .statistics-map-ranking
      max-height 260px

@keyframes statistics-spin
  to
    transform rotate(360deg)

[data-theme="dark"] #statistics_container
  --statistics-map-fill #435767
  --statistics-map-border #819baa
  --statistics-map-hover rgba(98, 168, 209, .72)
  --statistics-map-label #f3fbff
