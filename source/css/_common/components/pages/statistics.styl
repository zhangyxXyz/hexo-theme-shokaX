#statistics_container
  --statistics-map-fill #e8eff3
  --statistics-map-border #a7b8c2
  --statistics-map-hover rgba(126, 189, 224, .72)
  --statistics-map-label #23465e
  display grid
  gap 2.5rem
  min-width 0

  .statistics-panel
    min-width 0
    position relative
    padding .5rem 0

  .statistics-heading
    margin 0 0 1rem
    font-size 1.1rem
    text-align center
    border 0
    padding 0

  .statistics-loading
    width 2.75rem
    height 2.75rem
    margin 1rem auto
    border .3rem solid transparent
    border-top-color #ff32a8
    border-radius 50%
    animation statistics-spin .7s linear infinite

  .statistics-feedback
    display flex
    flex-direction column
    justify-content center
    align-items center
    min-height 160px
    padding 1rem
    text-align center
    gap .75rem

  .is-ready .statistics-feedback
    min-height 80px
    padding .5rem
    .statistics-loading
      width 1.75rem
      height 1.75rem
      border-width .2rem

  @media (prefers-reduced-motion: reduce)
    .statistics-loading
      animation none

  [hidden]
    display none !important

  .statistics-status
    color var(--grey-6)
    margin 0
    font-size .9rem

  button
    margin 0
    padding .25rem .9rem
    color var(--primary-color)
    border 1px solid currentColor
    border-radius 6px
    background transparent
    cursor pointer
    transition color .2s, background .2s
    &:hover
      background var(--color-red-a1)

  button:focus-visible
    outline 2px solid var(--primary-color)
    outline-offset 3px

  .statistics-map-controls
    display flex
    width fit-content
    gap .1rem
    padding .15rem
    margin 0 0 .5rem auto
    border-radius .6rem
    background var(--grey-3)
    button
      display grid
      place-items center
      margin 0
      width 2rem
      height 1.65rem
      padding .25rem .4rem
      border 0
      border-radius .45rem
      color var(--grey-6)
      &[aria-pressed="true"]
        color var(--primary-color)
        background var(--grey-1)
        box-shadow 0 1px 4px var(--box-bg-shadow)
    .ic
      width 1rem
      height 1rem
      margin 0
      font-size 1rem
      line-height 1

  .statistics-chart
    height 260px
    width 100%

  .statistics-legend
    display flex
    align-items center
    gap .85rem
    max-width 100%
    overflow-x auto
    padding .25rem .15rem .55rem
    overscroll-behavior-x contain
    scrollbar-width thin
    scrollbar-color var(--grey-4) transparent
    touch-action pan-x pan-y
    cursor grab
    user-select none
    &.is-dragging
      cursor grabbing
    button
      display inline-flex
      align-items center
      flex 0 0 auto
      gap .35rem
      padding .15rem 0
      border 0
      border-radius 3px
      background transparent
      color var(--tooltip-text, var(--grey-6))
      font-size 12px
      white-space nowrap
      cursor inherit
      &[aria-pressed="false"]
        opacity .4
      &:hover
        background transparent
        color var(--primary-color)
    .statistics-legend-swatch
      width 18px
      height 10px
      border-radius 3px
      flex 0 0 auto

  [data-chart="map"] .statistics-chart
    height auto
    aspect-ratio 1.3
    width 88%
    max-width 960px
    margin 0 auto
    position relative

  .statistics-map-hit
    position absolute
    z-index 2
    padding 0
    border 1px dashed transparent
    border-radius .75rem
    background transparent
    color var(--grey-7)
    cursor pointer
    transition border-color .2s, background .2s
    &:hover, &:focus-visible, &.is-active
      border-color var(--statistics-map-border)
      background transparent

  [data-map-mode="world"] .statistics-chart
    aspect-ratio 1.6

  [data-chart="calendar"]
    overflow-x auto
    .statistics-chart
      min-width 680px
      height 210px

  @media (max-width: 600px)
    .statistics-panel
      padding .5rem 0
    [data-chart="map"] .statistics-chart
      width 96%

@keyframes statistics-spin
  to
    transform rotate(360deg)

[data-theme="dark"] #statistics_container
  --statistics-map-fill #435767
  --statistics-map-border #819baa
  --statistics-map-hover rgba(98, 168, 209, .72)
  --statistics-map-label #f3fbff
