.news
  min-width 0
  [hidden]
    display none !important
  a:focus-visible, button:focus-visible, summary:focus-visible
    outline 2px solid var(--primary-color)
    outline-offset 4px
  .sr-only
    position absolute
    width 1px
    height 1px
    overflow hidden
    clip-path inset(50%)
  .news-intro
    padding 1.75rem
    border-radius 1rem
    background linear-gradient(125deg, var(--grey-2), var(--grey-1))
    border 1px solid var(--grey-3)
    margin-bottom 1.5rem
    h2
      font-size 1.65rem
      margin .4rem 0
    p
      margin .5rem 0 1rem
      color var(--grey-6)
  .news-eyebrow
    display flex
    align-items center
    gap .5rem
    color var(--primary-color)
    font-size .8rem
    letter-spacing .12em
    font-weight 700
  .news-credit, .news-meta, .news-card-footer
    display flex
    flex-wrap wrap
    align-items center
    gap .5rem 1rem
    font-size .8rem
    color var(--grey-6)
  .news-credit a, .news-card-footer a, .news-subscribe
    color var(--primary-color)
  .news-channels
    display grid
    grid-template-columns repeat(4, minmax(0, 1fr))
    gap .65rem
    margin-bottom 1.25rem
    button
      display flex
      justify-content center
      align-items center
      gap .65rem
      padding .8rem .5rem
      min-height 44px
      font inherit
      color var(--grey-6)
      background var(--grey-1)
      border 1px solid var(--grey-3)
      border-radius .65rem
      cursor pointer
      &[aria-pressed='true']
        color var(--primary-color)
        border-color var(--primary-color)
        box-shadow 0 3px 12px var(--box-bg-shadow)
      small
        font-size .7rem
        opacity .8
  .news-toolbar
    display flex
    flex-wrap wrap
    gap .75rem 1rem
    align-items center
    justify-content space-between
    margin-bottom 1.5rem
  .news-search
    display flex
    align-items center
    gap .65rem
    padding .6rem .9rem
    border 1px solid var(--grey-3)
    border-radius .6rem
    color var(--grey-6)
    background var(--grey-1)
    width min(100%, 24rem)
    &:focus-within
      border-color var(--primary-color)
      box-shadow 0 0 0 1px var(--primary-color)
    input
      min-width 0
      width 100%
      border 0
      background transparent
      font inherit
      color var(--text-color)
      &:focus-visible
        outline none
  .news-results, .news-updated
    margin 0
    font-size .75rem
    color var(--grey-6)
  .news-channel-heading
    display flex
    align-items flex-start
    justify-content space-between
    gap 1rem
    h3
      margin 0
    p
      color var(--grey-6)
      font-size .85rem
      margin .35rem 0 .75rem
  .news-subscribe
    display inline-flex
    flex-shrink 0
    align-items center
    gap .4rem
    min-height 44px
    font-size .8rem
  .news-warning
    padding .75rem 1rem
    border-left 3px solid var(--primary-color)
    background var(--grey-2)
  .news-list
    display grid
    gap 1rem
    margin 1rem 0 1.5rem
  .news-card
    min-width 0
    padding 1.4rem 1.5rem
    border 1px solid var(--grey-3)
    border-radius .8rem
    background var(--grey-1)
    transition border-color .2s
    overflow-wrap anywhere
    &:hover
      border-color var(--primary-color)
    h3
      margin .65rem 0
      font-size 1.1rem
      line-height 1.65
    .news-summary
      color var(--grey-6)
      font-size .9rem
      line-height 1.9
      margin .5rem 0 1rem
      white-space pre-line
  .news-category
    padding .15rem .55rem
    border-radius .3rem
    background var(--grey-2)
    color var(--primary-color)
  .news-content
    margin 1rem 0
    summary
      cursor pointer
      color var(--primary-color)
      font-size .85rem
    p
      white-space pre-line
      line-height 1.9
      font-size .9rem
      max-height 34rem
      overflow auto
      padding 1rem
      background var(--grey-2)
      border-radius .5rem
  .news-empty
    text-align center
    padding 2rem
    color var(--grey-6)
  .news-more
    display block
    margin 1.5rem auto 0
    padding .75rem 2rem
    border 1px solid var(--primary-color)
    border-radius 2rem
    background var(--grey-1)
    color var(--primary-color)
    font inherit
    cursor pointer
  @media (max-width: 600px)
    .news-intro, .news-card
      padding 1.1rem
    .news-channels
      grid-template-columns repeat(2, minmax(0, 1fr))
    .news-toolbar, .news-search
      width 100%
