.category-directory {
  position: relative;
  > .item.title { padding-right: 6.5rem; margin-bottom: 1.5rem; }
  [hidden] { display: none !important; }
  svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
  .category-controls {
    position: absolute;
    right: 0;
    top: 1.25rem;
    display: flex;
    width: fit-content;
    margin: 0;
    padding: .2rem;
    gap: .15rem;
    background: var(--grey-3);
    border-radius: .8rem;
    button {
      display: grid;
      place-items: center;
      transition: color .2s, transform .2s;
      &:hover { color: var(--accent-hover); transform: translateY(-1px); }
      border: 0;
      border-radius: .6rem;
      width: 2.5rem;
      height: 2.1rem;
      background: transparent;
      color: var(--grey-6);
      font-size: 1.1rem;
      cursor: pointer;
      &[aria-pressed="true"] {
        background: var(--grey-1);
        color: var(--primary-color);
        box-shadow: 0 2px 6px var(--box-bg-shadow);
      }
    }
  }
  .category-cards {
    --category-ease: cubic-bezier(.22, .61, .36, 1);
    --category-line: var(--accent-decoration-border);
    --category-line: unquote('color-mix(in srgb, var(--accent-state) 26%, transparent)');
    --category-tint: var(--accent-decoration-border);
    --category-tint: unquote('color-mix(in srgb, var(--accent-state) 7%, transparent)');
    columns: 2;
    column-gap: 1.25rem;
  }
  .category-card {
    --category-glow-tint: 3%;
    position: relative;
    break-inside: avoid;
    margin: 0 0 1.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--accent-decoration-border);
    border-radius: 1rem;
    background: var(--grey-1);
    background: unquote('linear-gradient(180deg, color-mix(in srgb, var(--accent-state) var(--category-glow-tint), var(--grey-1)), var(--grey-1) 5rem)');
    box-shadow: 0 4px 16px var(--box-bg-shadow);
    transition: border-color .3s, box-shadow .4s var(--category-ease), translate .4s var(--category-ease);
    &::after {
      content: '';
      position: absolute;
      top: -1px;
      inset-inline: 14%;
      height: 1px;
      background: unquote('linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent-state) 70%, transparent), transparent)');
      opacity: .4;
      transition: opacity .4s var(--category-ease), inset-inline .4s var(--category-ease);
      pointer-events: none;
    }
    &:hover, &:focus-within {
      --category-glow-tint: 4%;
      border-color: var(--accent-state);
      translate: 0 -3px;
      box-shadow: 0 .9rem 1.8rem -1rem var(--box-bg-shadow);
      box-shadow: unquote('0 1.25rem 2.25rem -1.25rem color-mix(in oklch, var(--accent-state) 45%, transparent), 0 .35rem 1rem -.5rem var(--box-bg-shadow)');
      &::after { opacity: .7; inset-inline: 8%; }
    }
    html[data-theme='dark'] & { --category-glow-tint: 7%; }
    html[data-theme='dark'] &:hover, html[data-theme='dark'] &:focus-within { --category-glow-tint: 8%; }
    > .category-link, > summary > .category-link {
      font-size: 1.15rem;
      font-weight: 600;
      > .category-icon {
        color: var(--accent-state);
        width: 1.5rem;
        height: 1.5rem;
        transform-origin: 20% 80%;
        transition: transform .35s var(--category-ease);
      }
    }
    &:hover > .category-link > .category-icon,
    &:hover > summary > .category-link > .category-icon {
      transform: rotate(-8deg) scale(1.08);
    }
  }
  .category-link {
    display: flex;
    align-items: center;
    gap: .7rem;
    flex: 1;
    min-width: 0;
    padding: .5rem 0;
    color: var(--grey-7);
    border: 0;
    text-decoration: none;
    transition: color .2s, transform .2s;
    &:hover { color: var(--accent-hover); transform: translateY(-1px); }
  }
  .category-name { overflow-wrap: anywhere; }
  .category-count {
    margin-left: auto;
    min-width: 1.9rem;
    padding: .1rem .5rem;
    border-radius: 999px;
    background: var(--category-tint);
    color: var(--grey-6);
    font-size: .8rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
    text-align: center;
    transition: color .2s, background-color .2s;
  }
  .category-link:hover .category-count,
  summary:hover .category-count {
    color: var(--accent-state);
    background: var(--accent-decoration-border);
  }
  // Leaves reserve the chevron column so counts line up with expandable rows.
  .category-leaf > .category-link { margin-right: 1.65rem; }
  .category-branch > summary {
    display: flex;
    align-items: center;
    gap: .65rem;
    list-style: none;
    cursor: pointer;
    padding: 0;
    background: transparent;
    &::before { display: none; }
    &::-webkit-details-marker { display: none; }
  }
  .category-chevron {
    display: inline-flex;
    justify-content: center;
    width: 1rem;
    color: var(--grey-6);
    transition: transform .3s var(--category-ease), color .2s;
  }
  summary:hover > .category-chevron { color: var(--accent-state); }
  .category-branch:not([open]) > summary > .category-chevron { transform: rotate(-90deg); }
  .category-children {
    --category-row-center: 1.2rem;
    --category-gap: .35rem;
    margin: var(--category-gap) 0 .25rem .7rem;
    padding: 0 0 0 1.1rem;
    animation: none;
    > * { position: relative; }
    > .category-leaf, > details > summary {
      padding-inline: .55rem;
      border-radius: .6rem;
      transition: background-color .2s;
    }
    > .category-leaf:hover, > details > summary:hover { background: var(--category-tint); }
    // Each row draws its own rounded elbow; only non-final rows continue the trunk downward.
    > *::before, > *:not(:last-child)::after {
      content: '';
      position: absolute;
      left: -1.1rem;
      pointer-events: none;
      border: 0 solid var(--category-line);
      transition: border-color .2s;
    }
    > *::before {
      top: 0;
      width: .8rem;
      height: var(--category-row-center);
      border-left-width: 1.5px;
      border-bottom-width: 1.5px;
      border-bottom-left-radius: .55rem;
    }
    > :first-child::before {
      top: calc(-1 * var(--category-gap));
      height: calc(var(--category-row-center) + var(--category-gap));
    }
    > *:not(:last-child)::after {
      top: var(--category-row-center);
      bottom: 0;
      border-left-width: 1.5px;
    }
    > .category-leaf:hover::before,
    > :has(> summary:hover)::before,
    > :focus-within::before { border-color: var(--accent-state); }
  }
  .category-children .category-children { margin-left: .85rem; }
  button, summary, .category-link {
    &:focus-visible { outline: 2px solid var(--accent-hover); outline-offset: 3px; border-radius: .25rem; }
  }
  @media (max-width: 767px) {
    > .item.title { padding-right: 0; margin-bottom: 0; }
    .category-controls { position: static; margin: .5rem 0 1rem auto; }
    .category-cards { columns: 1; }
    .category-card { padding: .75rem 1rem; }
  }
  +reduced-motion() {
    *, *::before, *::after { transition: none !important; }
    .category-card { translate: none !important; }
    .category-icon { transform: none !important; }
  }
}
