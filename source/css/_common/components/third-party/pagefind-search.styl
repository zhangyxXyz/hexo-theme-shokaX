#site-search {
  --pagefind-ui-primary: var(--primary-color);
  --pagefind-ui-text: var(--text-color);
  --pagefind-ui-background: var(--grey-1);
  --pagefind-ui-border: var(--grey-3);
  --pagefind-ui-font: inherit;
  --pagefind-ui-scale: 1;
  position: fixed;
  box-sizing: border-box;
  inset: 0;
  width: 100%;
  max-width: none;
  height: 100%;
  max-height: none;
  margin: 0;
  padding: 2rem 1.5rem 1.5rem;
  border: 0;
  color: var(--text-color);
  background: linear-gradient(to bottom, rgba(20, 24, 32, .65), rgba(20, 24, 32, .35) 9rem, transparent 18rem), var(--grey-1-a3);
  overflow-y: auto;
  overscroll-behavior: contain;
  &::backdrop { background: transparent; backdrop-filter: blur(10px) saturate(1.1); }
  &[open] { animation: search-appear .22s ease-out; }
  .search-shell { max-width: 64rem; margin: 0 auto; }
  .search-intro { margin: 0 .5rem 1.25rem; color: #fff; text-shadow: 0 1px 4px rgba(0, 0, 0, .3); }
  .search-eyebrow { color: #ffd5df; font-weight: 700; letter-spacing: .15em; font-size: .85rem; }
  h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin: .5rem 0 .3rem; line-height: 1.35; }
  .search-intro p { color: rgba(255, 255, 255, .9); margin: 0; }
  .search-workspace { position: relative; }
  .search-dismiss {
    position: absolute; right: .5rem; top: .375rem; height: 2rem;
    display: flex; align-items: center; gap: .7rem; border: 0;
    background: transparent; color: var(--grey-6); cursor: pointer;
    kbd { font-family: inherit; font-size: .7rem; border: 1px solid var(--grey-3); border-radius: .4rem; padding: .15rem .4rem; }
    span { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .5rem; background: var(--grey-2); font-size: 1.3rem; }
    &:hover span { color: var(--primary-color); }
  }
  .pagefind-ui__form { position: relative; }
  .search-input-icon { position: absolute; top: 50%; transform: translateY(-50%); left: 1rem; color: var(--primary-color); font-size: 1.1rem; pointer-events: none; }
  .pagefind-ui__search-input {
    box-sizing: border-box; width: 100%; height: 2.75rem; padding: 0 9rem 0 2.75rem;
    font: inherit; font-size: 1rem; border: 1px solid var(--grey-3);
    border-radius: .75rem; background: var(--grey-1-a7); color: var(--text-color);
    &::-webkit-search-cancel-button { display: none; }
    &:focus { outline: 1px solid var(--primary-color); outline-offset: 1px; }
  }
  .pagefind-ui__search-clear { position: absolute; right: 6rem; top: .375rem; height: 2rem; padding: 0 .5rem; border: 0; border-radius: .5rem; font: inherit; font-size: .8rem; cursor: pointer; color: var(--grey-6); background: transparent; &:hover { background: var(--grey-2); } }
  .pagefind-ui__drawer, .search-welcome {
    margin-top: 1rem; padding: 1.25rem 1.5rem; border: 1px solid var(--grey-3);
    border-radius: 1.5rem; background: var(--grey-1-a7);
  }
  .pagefind-ui__drawer { display: none; height: calc(100dvh - 15rem); min-height: 15rem; box-sizing: border-box; overflow: hidden; }
  .has-query .pagefind-ui__drawer { display: flex; flex-direction: column; }
  .search-result-list { overflow-y: auto; min-height: 0; flex: 1; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--primary-color) transparent; padding-right: .75rem; }
  .has-query .search-welcome { display: none; }
  .pagefind-ui__results-area { min-width: 0; }
  .pagefind-ui__message { flex: none; align-self: flex-start; margin: 0 0 .8rem; padding: .25rem .75rem; border-radius: 2rem; background: var(--color-pink-light-a3); font-size: .8rem; line-height: 1.5; font-weight: 400; color: var(--primary-color); }
  .pagefind-ui__result {
    position: relative; padding: 1.1rem 1.25rem; margin: 0 0 .8rem;
    border: 1px solid var(--grey-3); border-radius: 1rem; background: var(--grey-1-a3);
    transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
    &:hover, &:focus-within { border-color: var(--primary-color); background: var(--grey-1-a5); box-shadow: 0 2px 10px var(--grey-9-a1); }
  }
  .pagefind-ui__message {
    display: inline-flex; align-items: center; gap: .45rem; color: var(--grey-7);
    strong, i { color: var(--primary-color); }
    strong { font-weight: 700; font-variant-numeric: tabular-nums; }
    i { font-size: .85rem; }
  }
  .search-result-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem 1rem; margin-bottom: .5rem; padding-right: 2.5rem; color: var(--grey-6); font-size: .8rem;
    span, time { display: inline-flex; align-items: center; gap: .4rem; }
    i { color: var(--primary-color); }
  }
  .search-result-number { position: absolute; top: 1rem; right: 1.15rem; color: var(--primary-color); opacity: .4; font-size: 1.35rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .pagefind-ui__result-title { font-size: 1.15rem; margin: 0 0 .75rem; padding-right: 2.5rem; line-height: 1.6; }
  .search-subresult { margin-left: .7rem; }
  .search-section-title { font-size: 1rem; margin: .8rem 0 .25rem; }
  .pagefind-ui__result-link { color: var(--text-color); border: 0; }
  .pagefind-ui__result-link:hover { color: var(--primary-color); text-decoration: none; }
  .pagefind-ui__result-excerpt { color: var(--grey-7); font-size: .95rem; line-height: 1.8; margin: .4rem 0 .7rem; overflow-wrap: anywhere; }
  .search-pagination {
    display: flex; flex: none; justify-content: center; align-items: center; gap: .45rem; padding-top: 1rem;
    &:empty { display: none; }
    button { border: 0; width: 2.2rem; height: 2.2rem; border-radius: .6rem; background: transparent; color: var(--grey-7); font: inherit; cursor: pointer;
      &:hover { background: var(--grey-2); }
      &[aria-current] { background: var(--primary-color); color: white; }
      &:disabled { opacity: .35; cursor: default; }
    }
  }
  mark { color: var(--text-color); background: var(--color-pink-a3); border-radius: .2rem; padding: .08em .12em; font-weight: 600; }
  .pagefind-ui__button { border-radius: .8rem; color: var(--primary-color); }
  .search-welcome { min-height: min(26rem, 48vh); display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; }
  .search-welcome-badge { align-self: flex-start; border-radius: 2rem; background: var(--color-pink-light-a3); color: var(--primary-color); padding: .25rem .75rem; font-size: .8rem; line-height: 1.5; }
  .search-discover { text-align: center; padding: .25rem 1rem .75rem; }
  .search-constellation {
    display: flex; align-items: center; justify-content: center; gap: 1.25rem; color: var(--primary-color);
    .search-compass { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; font-size: 2rem; opacity: .75; }
    user-select: none;
    span { opacity: .55; font-size: .9rem; &:first-child { transform: translateY(-.65rem); } &:last-child { transform: translateY(.55rem); } }
  }
  .search-discover-title { margin: .65rem 0 .75rem; font-size: .9rem; color: var(--grey-7); }
  .search-topics { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; }
  .search-topic {
    &[hidden] { display: none; }
    display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .7rem; border: 1px solid var(--grey-3); border-radius: 2rem;
    background: var(--grey-1-a3); color: var(--grey-7); font: inherit; font-size: .8rem; line-height: 1.5; cursor: pointer;
    span { color: var(--primary-color); }
    &:hover { border-color: var(--primary-color); color: var(--primary-color); background: var(--grey-1-a7); }
  }
  .search-tips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-bottom: .5rem; }
  .search-tip {
    padding: 1.25rem; border: 1px solid var(--grey-3); border-radius: 1.1rem;
    background: var(--grey-1-a7);
    i { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: .8rem; background: var(--primary-color); color: white; font-size: 1.2rem; }
    h3 { margin: 1rem 0 .5rem; font-size: 1rem; }
    p { margin: 0; color: var(--grey-6); font-size: .85rem; line-height: 1.7; }
  }
  .search-load-error { color: var(--primary-color); }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--primary-color); outline-offset: 3px; }
  @media (max-width: 600px) {
    padding: 1.5rem .85rem;
    .search-intro { margin-bottom: 1.25rem; }
    .search-intro p { font-size: .85rem; }
    .search-dismiss kbd { display: none; }
    .pagefind-ui__search-input { padding-right: 7rem; }
    .pagefind-ui__search-clear { right: 4rem; }
    .pagefind-ui__drawer, .search-welcome { padding: 1rem; border-radius: 1rem; }
    .pagefind-ui__drawer { height: calc(100dvh - 15rem); }
    .pagefind-ui__result { padding: .9rem; }
    .search-welcome { gap: 2rem; min-height: 0; }
    .search-tips { grid-template-columns: 1fr; gap: .65rem; margin-bottom: 0; }
    .search-tip { padding: .9rem; i { float: left; margin-right: 1rem; } h3 { margin: 0 0 .25rem; } }
  }
  @media (prefers-reduced-motion: reduce) { &[open] { animation: none; } }
}
[data-theme="dark"] #site-search {
  .pagefind-ui__message, .search-welcome-badge {
    background: rgba(233, 84, 107, .1);
    color: #ffafbd;
    box-shadow: inset 0 0 0 1px rgba(233, 84, 107, .22);
  }
  .pagefind-ui__message {
    color: var(--grey-6);
    strong, i { color: #ffafbd; }
  }
}
@keyframes search-appear {
  from { opacity: 0; }
  to { opacity: 1; }
}
