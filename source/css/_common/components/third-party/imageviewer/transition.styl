.shokax-post-viewer {
  .shokax-image-pending {
    visibility: hidden !important;
  }

  .shokax-viewer-slide-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;

    img {
      max-width: none !important;
      max-height: none !important;
    }
  }
}
