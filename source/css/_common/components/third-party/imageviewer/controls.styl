.shokax-post-viewer {
  .viewer-toolbar {
    position: fixed;
    top: 1rem;
    right: 4.25rem;
    z-index: 4;

    > ul {
      display: inline-flex;
      gap: .125rem;
      padding: .25rem;
      margin: 0;
      border: 0;
      border-radius: .7rem;
      background: var(--grey-3);
      box-shadow: 0 .125rem .5rem var(--box-bg-shadow);

      > li {
        --viewer-control-bg: transparent;
        float: none;
        width: 2.25rem;
        height: 2.25rem;
        margin: 0;
        border-radius: .5rem;
        background: transparent;
      }
    }
  }

  .viewer-toolbar > ul > li,
  .viewer-navigation > div,
  .viewer-button {
    display: grid;
    place-items: center;
    color: var(--primary-color);
    transition: color .18s ease, background-color .18s ease, box-shadow .18s ease;

    &::before {
      display: none;
    }

    .ic {
      width: 1.25rem;
      height: 1.25rem;
      font-size: 1.25rem;
      line-height: 1;
      pointer-events: none;
    }

    &:focus {
      color: var(--primary-color);
      background: var(--viewer-control-bg, var(--grey-1));
      box-shadow: none;
      outline: none;
    }

    &:hover {
      color: var(--primary-color);
      background: var(--grey-1);
      box-shadow: 0 1px 4px var(--box-bg-shadow);
    }

    &:focus-visible {
      outline: .125rem solid var(--primary-color);
      outline-offset: -.125rem;
      box-shadow: none;
    }

    &[aria-disabled='true'] {
      opacity: .3;
      cursor: default;
      pointer-events: auto;
      color: var(--text-color);
      background: var(--viewer-control-bg, var(--grey-1));
      box-shadow: none;
    }
  }

  .viewer-navigation {
    z-index: 3;
    pointer-events: none;

    > div {
      pointer-events: auto;
      width: 2.75rem;
      height: 2.75rem;
      margin-top: -1.375rem;
      border-radius: .65rem;
      background: var(--grey-1);
      border: .0625rem solid var(--grey-3);
      box-shadow: 0 1px 4px var(--box-bg-shadow);
    }
  }

  .viewer-button {
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: .7rem;
    border: .0625rem solid var(--grey-3);
    background: var(--grey-1);
    box-shadow: 0 1px 4px var(--box-bg-shadow);
    z-index: 4;
  }

  .viewer-toolbar > ul > li:not(:hover):not(:focus-visible) {
    color: var(--grey-6);
  }

  +mobile-small() {
    .viewer-toolbar {
      position: relative;
      top: auto;
      right: auto;
      margin: .5rem auto;

      > ul > li {
        width: 2.25rem;
        height: 2.25rem;
      }
    }

    .viewer-button {
      top: unquote('max(.625rem, env(safe-area-inset-top))');
      right: unquote('max(.625rem, env(safe-area-inset-right))');
      width: 2.25rem;
      height: 2.25rem;
      border-radius: .6rem;
      border-color: rgba(255, 255, 255, .12);
      background: rgba(40, 43, 49, .65);
      color: #e3e5ec;
      box-shadow: none;

      &::after {
        content: '';
        position: absolute;
        inset: -.25rem;
      }

      &:hover, &:focus-visible {
        color: var(--primary-color);
        background: rgba(40, 43, 49, .85);
      }
    }

    .viewer-navigation > div {
      width: 2.25rem;
      height: 2.25rem;
      margin-top: -1.125rem;
      border-radius: .5rem;

      &::after {
        content: '';
        position: absolute;
        inset: -.25rem;
      }
    }
  }
}
