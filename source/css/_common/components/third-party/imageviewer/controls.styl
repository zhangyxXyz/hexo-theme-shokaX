.shokax-post-viewer {
  .viewer-toolbar {
    position: fixed;
    top: 1rem;
    right: 4.25rem;
    z-index: 4;

    > ul {
      display: inline-flex;
      gap: .125rem;
      padding: .25rem;
      margin: 0;
      border: 1px solid var(--viewer-glass-border);
      border-radius: 999px;
      background: var(--viewer-glass);
      backdrop-filter: var(--viewer-glass-blur);
      box-shadow: var(--viewer-glass-shadow);

      > li {
        --viewer-control-bg: transparent;
        float: none;
        width: 2.25rem;
        height: 2.25rem;
        margin: 0;
        border-radius: 50%;
        background: transparent;
      }
    }
  }

  .viewer-toolbar > ul > li,
  .viewer-navigation > div,
  .viewer-button {
    display: grid;
    place-items: center;
    color: var(--grey-6);
    transition: color .18s ease, background-color .18s ease, box-shadow .18s ease;

    &::before {
      display: none;
    }

    .ic {
      width: 1.25rem;
      height: 1.25rem;
      font-size: 1.25rem;
      line-height: 1;
      pointer-events: none;
    }

    &:focus {
      color: var(--grey-6);
      background: var(--viewer-control-bg, var(--viewer-glass));
      box-shadow: var(--viewer-control-shadow, var(--viewer-glass-shadow));
      outline: none;
    }

    &:hover {
      color: var(--primary-color);
      background: var(--viewer-control-hover, var(--viewer-glass-strong));
    }

    &:focus-visible {
      outline: .125rem solid var(--primary-color);
      outline-offset: -.125rem;
    }

    &[aria-disabled='true'] {
      opacity: .35;
      cursor: default;
      pointer-events: auto;
      color: var(--grey-6);
      background: var(--viewer-control-bg, var(--viewer-glass));
    }
  }

  .viewer-toolbar > ul > li {
    --viewer-control-hover: var(--accent-wash);
    --viewer-control-shadow: none;
  }

  .viewer-navigation > div,
  .viewer-button {
    border: 1px solid var(--viewer-glass-border);
    border-radius: 50%;
    background: var(--viewer-glass);
    backdrop-filter: var(--viewer-glass-blur);
    box-shadow: var(--viewer-glass-shadow);
  }

  .viewer-navigation {
    z-index: 3;
    pointer-events: none;

    > div {
      pointer-events: auto;
      width: 3rem;
      height: 3rem;
      margin-top: -1.5rem;
    }
  }

  .viewer-button {
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    z-index: 4;
  }

  +mobile-small() {
    .viewer-toolbar {
      position: relative;
      top: auto;
      right: auto;
      margin: .5rem auto;
    }

    .viewer-button {
      top: unquote('max(.625rem, env(safe-area-inset-top))');
      right: unquote('max(.625rem, env(safe-area-inset-right))');
      width: 2.25rem;
      height: 2.25rem;

      &::after {
        content: '';
        position: absolute;
        inset: -.25rem;
      }
    }

    .viewer-navigation > div {
      width: 2.5rem;
      height: 2.5rem;
      margin-top: -1.25rem;

      &::after {
        content: '';
        position: absolute;
        inset: -.25rem;
      }
    }
  }
}
