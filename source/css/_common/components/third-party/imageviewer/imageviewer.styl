// Viewer.js supplies base CSS; theme appearance and transitions live here.
@import 'controls';
@import 'thumbnails';
@import 'transition';

.md img.shokax-image-viewer {
  cursor: zoom-in;
}

.shokax-post-viewer {
  --viewer-duration: 360ms;
  --viewer-easing: cubic-bezier(.22, .68, 0, 1);
  // Frosted surfaces follow the page palette, so light and dark modes need no separate values.
  --viewer-glass: unquote('color-mix(in srgb, var(--grey-0) 72%, transparent)');
  --viewer-glass-strong: unquote('color-mix(in srgb, var(--grey-0) 88%, transparent)');
  --viewer-glass-border: unquote('color-mix(in srgb, var(--grey-4) 40%, transparent)');
  --viewer-glass-shadow: 0 .5rem 1.5rem -.5rem var(--box-bg-shadow);
  --viewer-glass-blur: blur(12px);

  &.viewer-backdrop {
    background: unquote('color-mix(in srgb, var(--grey-1) 42%, transparent)');
    backdrop-filter: blur(20px) saturate(1.15);
  }

  .viewer-canvas > img {
    border-radius: .75rem;
    box-shadow: 0 0 0 1px var(--viewer-glass-border), 0 1.5rem 3rem -1.25rem rgba(0, 0, 0, .35);
  }

  .viewer-footer {
    padding: 0 0 unquote('max(12px, env(safe-area-inset-bottom))');
    z-index: 3;
  }

  .viewer-title,
  .shokax-viewer-counter,
  .viewer-tooltip {
    border: 1px solid var(--viewer-glass-border);
    border-radius: 999px;
    background: var(--viewer-glass);
    backdrop-filter: var(--viewer-glass-blur);
    box-sizing: border-box;
  }

  .viewer-title {
    width: max-content;
    max-width: 80%;
    margin: .5rem auto .75rem;
    padding: .25rem .9rem;
    color: var(--grey-6);
    font-size: .8125rem;
    line-height: 1.5;
    opacity: 1;

    &:empty {
      display: none;
    }
  }

  .shokax-viewer-counter {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding: 0 1rem;
    color: var(--grey-6);
    font-size: .8125rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .06em;

    &:empty {
      display: none;
    }
  }

  .viewer-tooltip {
    width: auto;
    height: auto;
    min-width: 4rem;
    margin: 0;
    transform: translate(-50%, -50%);
    padding: .25rem .9rem;
    color: var(--grey-7);
    font-size: .8125rem;
    line-height: 1.5;
    box-shadow: var(--viewer-glass-shadow);
  }

  +mobile-small() {
    .shokax-viewer-counter {
      top: unquote('max(.625rem, env(safe-area-inset-top))');
      left: unquote('max(.625rem, env(safe-area-inset-left))');
      height: 2.25rem;
      padding: 0 .8rem;
    }

    .viewer-title {
      max-width: 90%;
      margin: .5rem auto .25rem;
    }
  }
}

// The article-wide dark-mode dimming would wash out the image being inspected.
[data-theme="dark"] .shokax-post-viewer img {
  opacity: 1;
}

@supports not (backdrop-filter: blur(1px)) {
  .shokax-post-viewer.viewer-backdrop {
    background: unquote('color-mix(in srgb, var(--grey-1) 94%, transparent)');
  }
}

@media (prefers-reduced-transparency: reduce) {
  .shokax-post-viewer {
    --viewer-glass: var(--grey-0);
    --viewer-glass-strong: var(--grey-0);

    &.viewer-backdrop {
      background: var(--grey-1);
      backdrop-filter: none;
    }
  }
}
