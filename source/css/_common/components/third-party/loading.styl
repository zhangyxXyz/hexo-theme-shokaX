// Orbital composition inspired by Lavender's Blog, adapted to ShokaX.
#loading.site-loading {
  --loader-orbit: 4.4rem;
  // Soften the theme's pink with 15% white for brief page transitions.
  --loader-start: #f5afc9;
  --loader-main: #f084ae;
  --loader-accent: #8fcfc8;
  --loader-ink: var(--loader-main);
  --loader-surface: rgba(253, 250, 252, .95);
  --loader-haze: rgba(237, 110, 160, .06);
  --loader-ring: rgba(237, 110, 160, .24);
  --loader-glow: rgba(237, 110, 160, .12);
  --loader-track: rgba(237, 110, 160, .12);
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  isolation: isolate;
  overflow: hidden;
  pointer-events: none;
  color: var(--text-color);
  background: radial-gradient(ellipse at 50% 42%, var(--loader-haze), transparent 42%), var(--loader-surface);
  backdrop-filter: blur(8px);
  opacity: 1;
  transition: opacity .24s ease-out;

  &[hidden] { display: none; }
  &[data-mode='initial'] {
    // A missing application bundle must not leave the page covered forever.
    animation: loader-failsafe 15s step-end forwards;
  }
  &[data-mode='navigation'] {
    background: radial-gradient(ellipse at 50% 44%, var(--loader-haze), transparent 50%), var(--loader-surface);
    animation: loader-arrive .18s ease-out both;
  }
  &[data-mode='navigation'][data-scope='content'] { border-radius: 1rem; }
  &[data-state='leaving'] { animation: loader-depart .24s ease-out both; }
  &[data-paused='true'] *, &[data-paused='true'] *::before, &[data-paused='true'] *::after { animation-play-state: paused; }
}

[data-theme='dark'] #loading.site-loading {
  --loader-main: #ed80aa;
  --loader-ink: #f3aac6;
  --loader-surface: rgba(33, 37, 43, .95);
}

.site-loader {
  width: 25rem;
  max-width: calc(100% - 3rem);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 1.5rem 0;
}

.site-loader-stage {
  position: relative;
  flex: none;
  width: 10rem;
  height: 10rem;
  margin-bottom: 1.7rem;
}

.site-loader-halo {
  position: absolute;
  inset: .65rem;
  border: 1px solid var(--loader-ring);
  border-radius: 50%;

  &::before, &::after {
    content: '';
    position: absolute;
    border: 1px solid transparent;
    border-radius: 50%;
    animation: loader-orbit 6s linear infinite;
  }
  &::before { inset: .65rem; border-top-color: var(--loader-start); border-right-color: var(--loader-accent); animation-direction: reverse; }
  &::after { inset: -.6rem; border-bottom-color: var(--loader-main); animation-duration: 8s; }
}

.site-loader-orbit {
  position: absolute;
  inset: 0;
  animation: loader-orbit 6s linear infinite;

  span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: .5rem;
    height: .5rem;
    margin: -.25rem;
    border-radius: 50%;
    background: var(--loader-main);
    transform: rotate(calc(var(--star-index) * 60deg)) translateY(calc(-1 * var(--loader-orbit)));

    &:nth-child(3n) { background: var(--loader-accent); }
  }
}

.site-loader-core {
  position: absolute;
  inset: 2rem;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: white;
  background: linear-gradient(145deg, var(--loader-start), var(--loader-main));
  box-shadow: 0 .75rem 2.2rem var(--loader-glow), inset 0 1px 1px rgba(255, 255, 255, .5);
  animation: loader-breathe 2.4s ease-in-out infinite;

  svg { width: 2rem; height: 2rem; }
}

.site-loader-title {
  margin: 0;
  font-family: $font-family-headings;
  font-size: 1.65rem;
  line-height: 1.4;
  font-weight: 600;
  letter-spacing: .04em;
  color: var(--loader-ink);
}

.site-loader-subtitle {
  max-width: 26em;
  margin: .65rem 0 0;
  font-size: .9rem;
  line-height: 1.8;
  color: var(--grey-6);
  text-wrap: balance;
}

.site-loader-progress {
  width: 11rem;
  height: 2px;
  margin-top: 1.6rem;
  overflow: hidden;
  border-radius: 1px;
  background: var(--loader-track);

  span {
    display: block;
    // One pink ribbon, centered with soft ends and no competing hue.
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--loader-start) 18%, var(--loader-main) 50%, var(--loader-start) 82%, transparent);
  }
}

@keyframes loader-orbit { to { transform: rotate(360deg); } }
@keyframes loader-breathe { 50% { transform: scale(.97); } }
@keyframes loader-arrive { from { opacity: 0; } to { opacity: 1; } }
@keyframes loader-depart { from { opacity: 1; } to { opacity: 0; } }
@keyframes loader-failsafe { to { visibility: hidden; opacity: 0; } }

@media (max-width: 767px) {
  #loading.site-loading { --loader-orbit: 3.45rem; }
  .site-loader-stage { width: 8rem; height: 8rem; margin-bottom: 1.2rem; }
  .site-loader-core { inset: 1.6rem; }
  .site-loader-title { font-size: 1.5rem; }
  .site-loader-subtitle { font-size: .8rem; }
}

@media (prefers-reduced-motion: reduce) {
  #loading.site-loading { transition-duration: .1s; }
  #loading.site-loading[data-mode='navigation'], .site-loader *, .site-loader *::before, .site-loader *::after { animation: none; }
  #loading.site-loading[data-state='leaving'] { animation: loader-depart .1s ease-out both; }
}

@media (forced-colors: active) {
  .site-loader-title { color: CanvasText; }
}
