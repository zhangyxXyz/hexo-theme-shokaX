// Orbital composition inspired by Lavender's Blog, adapted to ShokaX.
#loading.site-loading {
  --loader-orbit: 4.4rem;
  // Soften the theme's pink with 15% white for brief page transitions.
  --loader-start: #f5afc9;
  --loader-main: #f084ae;
  --loader-accent: #8fcfc8;
  --loader-title-start: #e26497;
  --loader-title-end: #c264a6;
  --loader-surface: rgba(253, 250, 252, .95);
  --loader-haze: rgba(237, 110, 160, .07);
  --loader-haze-accent: rgba(143, 207, 200, .08);
  --loader-ring: rgba(237, 110, 160, .2);
  --loader-glow: rgba(237, 110, 160, .14);
  --loader-track: rgba(237, 110, 160, .12);
  --loader-starfield-opacity: 0;
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  isolation: isolate;
  overflow: hidden;
  pointer-events: none;
  color: var(--text-color);
  background: radial-gradient(ellipse at 38% 30%, var(--loader-haze-accent), transparent 46%), radial-gradient(ellipse at 50% 42%, var(--loader-haze), transparent 52%), var(--loader-surface);
  backdrop-filter: blur(8px);
  opacity: 1;
  transition: opacity .24s ease-out;

  // Night sky dust, only visible in dark mode.
  &::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-image: radial-gradient(1px 1px at 12% 22%, rgba(255, 255, 255, .8), transparent),
      radial-gradient(1px 1px at 27% 68%, rgba(255, 255, 255, .55), transparent),
      radial-gradient(1.5px 1.5px at 41% 14%, rgba(255, 255, 255, .7), transparent),
      radial-gradient(1px 1px at 58% 82%, rgba(255, 255, 255, .5), transparent),
      radial-gradient(1.5px 1.5px at 72% 28%, rgba(255, 255, 255, .75), transparent),
      radial-gradient(1px 1px at 86% 60%, rgba(255, 255, 255, .6), transparent),
      radial-gradient(1px 1px at 92% 12%, rgba(255, 255, 255, .5), transparent),
      radial-gradient(1px 1px at 6% 88%, rgba(255, 255, 255, .45), transparent);
    opacity: var(--loader-starfield-opacity);
    animation: loader-dust 5s ease-in-out infinite alternate;
  }

  &[hidden] { display: none; }
  &[data-mode='initial'] {
    // A missing application bundle must not leave the page covered forever.
    animation: loader-failsafe 15s step-end forwards;
  }
  &[data-mode='navigation'] {
    background: radial-gradient(ellipse at 38% 32%, var(--loader-haze-accent), transparent 50%), radial-gradient(ellipse at 50% 44%, var(--loader-haze), transparent 56%), var(--loader-surface);
    animation: loader-arrive .18s ease-out both;
  }
  &[data-mode='navigation'][data-scope='content'] { border-radius: 1rem; }
  &[data-state='leaving'] { animation: loader-depart .24s ease-out both; }
  &[data-paused='true'], &[data-paused='true']::before, &[data-paused='true'] *, &[data-paused='true'] *::before, &[data-paused='true'] *::after { animation-play-state: paused; }
}

[data-theme='dark'] #loading.site-loading {
  --loader-main: #ed80aa;
  --loader-title-start: #f08fb5;
  --loader-title-end: #d99bd0;
  --loader-surface: rgba(16, 20, 33, .96);
  --loader-haze: rgba(237, 128, 170, .1);
  --loader-haze-accent: rgba(143, 207, 200, .08);
  --loader-ring: rgba(237, 128, 170, .22);
  --loader-glow: rgba(237, 128, 170, .22);
  --loader-starfield-opacity: .9;
}

html[data-reading-palette] #loading.site-loading {
  --loader-start: unquote('color-mix(in oklch, var(--accent-start) 60%, var(--grey-1))');
  --loader-main: var(--accent-start);
  --loader-accent: var(--accent-end);
  // Large-title roles already follow the light or dark surface.
  --loader-title-start: var(--accent-title);
  --loader-title-end: var(--accent-secondary-title);
  --loader-haze: unquote('color-mix(in srgb, var(--accent-start) 7%, transparent)');
  --loader-haze-accent: unquote('color-mix(in srgb, var(--accent-end) 8%, transparent)');
  --loader-ring: unquote('color-mix(in srgb, var(--accent-start) 22%, transparent)');
  --loader-glow: unquote('color-mix(in srgb, var(--accent-start) 16%, transparent)');
  --loader-track: unquote('color-mix(in srgb, var(--accent-start) 12%, transparent)');
}

html[data-reading-palette][data-theme='dark'] #loading.site-loading {
  --loader-glow: unquote('color-mix(in srgb, var(--accent-start) 26%, transparent)');
}

.site-loader {
  width: 25rem;
  max-width: calc(100% - 3rem);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 1.5rem 0;
}

.site-loader-stage {
  position: relative;
  flex: none;
  width: 10rem;
  height: 10rem;
  margin-bottom: 1.7rem;
}

.site-loader-halo {
  position: absolute;
  inset: .65rem;
  border: 1px solid var(--loader-ring);
  border-radius: 50%;

  // Inner star track.
  &::before {
    content: '';
    position: absolute;
    inset: 1.1rem;
    border: 1px dashed var(--loader-ring);
    border-radius: 50%;
    opacity: .7;
    animation: loader-orbit 40s linear infinite reverse;
  }

  // A comet sweeping the outer ring, its tail fading behind the bright head.
  &::after {
    content: '';
    position: absolute;
    inset: -.6rem;
    border-radius: 50%;
    background: conic-gradient(transparent 0 55%, var(--loader-start) 85%, var(--loader-main) 99.6%, transparent 99.7%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    filter: drop-shadow(0 0 4px var(--loader-glow));
    animation: loader-orbit 2.8s cubic-bezier(.55, .1, .45, .9) infinite;
  }
}

.site-loader-orbit {
  position: absolute;
  inset: 0;
  animation: loader-orbit 16s linear infinite;

  span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: .45rem;
    height: .45rem;
    margin: -.225rem;
    border-radius: 50%;
    background: var(--loader-main);
    box-shadow: 0 0 .5rem var(--loader-glow);
    transform: rotate(calc(var(--star-index) * 60deg + 12deg)) translateY(calc(-1 * var(--loader-orbit)));
    // Opacity only: an independent scale would pull the star toward the centre.
    animation: loader-glint 2.6s ease-in-out infinite;
    animation-delay: calc(var(--star-index) * -.45s);

    &:nth-child(2n) { width: .28rem; height: .28rem; margin: -.14rem; }
    &:nth-child(3n) { background: var(--loader-accent); }
  }
}

.site-loader-core {
  position: absolute;
  inset: 2.6rem;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 45%, var(--loader-haze), transparent 70%);

  svg {
    width: 3.6rem;
    height: 3.6rem;
    overflow: visible;
    animation: loader-breathe 2.6s ease-in-out infinite;
  }
}

.site-loader-stop-start { stop-color: var(--loader-main); }
.site-loader-stop-end { stop-color: var(--loader-accent); }

.site-loader-star {
  fill: var(--loader-ring);
  stroke-width: 1.6;
  stroke-linejoin: round;
  filter: drop-shadow(0 0 6px var(--loader-glow));
}

.site-loader-sparkle {
  fill: var(--loader-accent);
  transform-origin: 38px 8px;
  animation: loader-twinkle 2.6s ease-in-out infinite -1.3s;
}

.site-loader-title {
  margin: 0;
  font-family: $font-family-headings;
  font-size: 1.65rem;
  line-height: 1.4;
  font-weight: 600;
  letter-spacing: .06em;
  color: var(--loader-title-start);
  background: linear-gradient(90deg, var(--loader-title-start), var(--loader-title-end));
  background: unquote('linear-gradient(90deg in oklch, var(--loader-title-start), var(--loader-title-end))');
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.site-loader-subtitle {
  max-width: 26em;
  margin: .65rem 0 0;
  font-size: .9rem;
  line-height: 1.8;
  letter-spacing: .02em;
  color: var(--grey-5);
  text-wrap: balance;
}

.site-loader-progress {
  position: relative;
  width: 9rem;
  height: 2px;
  margin-top: 1.6rem;
  overflow: hidden;
  border-radius: 1px;
  background: var(--loader-track);

  span {
    display: block;
    width: 45%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, var(--loader-main) 45%, var(--loader-accent) 80%, transparent);
    animation: loader-sweep 1.8s cubic-bezier(.45, 0, .55, 1) infinite;
  }
}

@keyframes loader-orbit { to { transform: rotate(360deg); } }
@keyframes loader-breathe { 50% { transform: scale(.92) rotate(8deg); } }
@keyframes loader-twinkle { 50% { opacity: .35; scale: .6; } }
@keyframes loader-glint { 50% { opacity: .3; } }
@keyframes loader-sweep { from { transform: translateX(-100%); } to { transform: translateX(225%); } }
@keyframes loader-dust { to { opacity: calc(var(--loader-starfield-opacity) * .55); } }
@keyframes loader-arrive { from { opacity: 0; } to { opacity: 1; } }
@keyframes loader-depart { from { opacity: 1; } to { opacity: 0; } }
@keyframes loader-failsafe { to { visibility: hidden; opacity: 0; } }

@media (max-width: 767px) {
  #loading.site-loading { --loader-orbit: 3.45rem; }
  .site-loader-stage { width: 8rem; height: 8rem; margin-bottom: 1.2rem; }
  .site-loader-core { inset: 2.1rem; }
  .site-loader-core svg { width: 2.9rem; height: 2.9rem; }
  .site-loader-title { font-size: 1.5rem; }
  .site-loader-subtitle { font-size: .8rem; }
}

+reduced-motion() {
  #loading.site-loading { transition-duration: .1s; }
  #loading.site-loading::before, #loading.site-loading[data-mode='navigation'], .site-loader *, .site-loader *::before, .site-loader *::after { animation: none; }
  #loading.site-loading[data-state='leaving'] { animation: loader-depart .1s ease-out both; }
  .site-loader-progress span { width: 100%; background: linear-gradient(90deg, transparent, var(--loader-main) 30%, var(--loader-accent) 70%, transparent); }
}

@media (forced-colors: active) {
  .site-loader-title { color: CanvasText; background: none; -webkit-text-fill-color: CanvasText; }
}
