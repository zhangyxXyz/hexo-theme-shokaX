// Keep overrides scoped above the lazily loaded Waline stylesheet.
.comment-entry
  display: flex
  align-items: flex-start
  justify-content: space-between
  gap: 1rem
  margin-block: 1.5rem 0
  padding-block: 1.25rem
  border-top: 1px solid var(--grey-3)

  .comment-entry-copy
    min-width: 0

    strong
      display: flex
      align-items: center
      box-sizing: border-box
      min-height: 2.25rem
      gap: .5rem
      font-size: 1rem
      font-weight: 600
      line-height: 1.4

      .ic
        display: inline-grid
        place-items: center
        flex: 0 0 1.25rem
        width: 1.25rem
        height: 1.25rem
        line-height: 1
        color: var(--primary-color)

    p
      margin: .2rem 0 0 1.75rem
      color: var(--grey-5)
      font-size: .8125rem
      line-height: 1.6

  .comment-entry-button
    display: inline-flex
    box-sizing: border-box
    align-items: center
    justify-content: center
    flex-shrink: 0
    min-height: 2.25rem
    gap: .45rem
    padding: .45rem .75rem
    border: 3px solid var(--grey-3)
    border-radius: .85rem
    background: var(--grey-1)
    box-shadow: 0 2px 5px var(--grey-9-a1)
    color: var(--primary-color)
    font-size: .8125rem
    line-height: 1.4
    text-decoration: none
    transition: border-color .22s ease, box-shadow .22s ease

    &:hover, &:focus-visible
      border-color: var(--color-pink-a3)

    .comment-entry-button-label
      display: inline-flex
      align-items: center
      gap: .25rem
      white-space: nowrap

    &:focus-visible
      outline: 2px solid var(--primary-color)
      outline-offset: 3px

    .comment-entry-count:empty
      display: none

    .ic
      display: inline-grid
      place-items: center
      width: 1.25rem
      height: 1.25rem
      font-size: 1.15rem
      line-height: 1

  @media (max-width: 580px)
    align-items: center
    gap: .75rem

  @media (prefers-reduced-motion: reduce)
    .comment-entry-button, .comment-entry-button-label
      transition: none

#main .wrap.comment-entry-footer
  padding-block: 0

  > .comment-entry
    align-items: center
    margin: 0
    padding: .65rem 2rem .9rem
    border: 0

    .comment-entry-copy strong
      gap: .3125rem

      .ic
        flex-basis: 1.1rem
        width: 1.1rem

    .comment-entry-copy p
      margin-inline-start: 1.4125rem

  +mobile-small()
    > .comment-entry
      padding-inline: 0

.comment-shell[hidden]
  display: none

#tool .chat[hidden]
  display: none !important

.comment-target-status
  margin: 0
  padding: 0 1.5rem
  color: var(--grey-5)
  font-size: .875rem

  &:empty
    display: none

.comment-dialog
  box-sizing: border-box
  inset: .75rem .75rem .75rem auto
  width: min(52rem, 76vw)
  height: calc(100dvh - 1.5rem)
  max-width: 100vw
  max-height: 100dvh
  margin: 0
  padding: 0 1.5rem 1rem
  border: 1px solid var(--grey-3)
  border-radius: 1.1rem
  outline: none
  background: var(--grey-1)
  color: var(--text-color)
  box-shadow: 0 0 3rem var(--grey-9-a1)
  overscroll-behavior: contain
  scrollbar-gutter: stable

  &[data-side='left']
    inset: .75rem auto .75rem .75rem

  &::backdrop
    background: rgba(0, 0, 0, .3)
    backdrop-filter: blur(3px)

  &[open]
    animation: comment-slide-right .22s ease-out

    &[data-side='left']
      animation-name: comment-slide-left

  #comments.wrap
    width: 100%
    margin: 0
    padding: .5rem 0 0
    box-shadow: none

  .comment-dialog-header
    position: sticky
    top: 0
    z-index: 2
    display: flex
    align-items: center
    justify-content: space-between
    padding: .75rem 0
    background: var(--grey-1)
    border-bottom: 1px solid var(--grey-3)

    h2
      margin: 0
      font-size: 1rem

    button
      display: grid
      place-items: center
      width: 2.25rem
      height: 2.25rem
      padding: 0
      border: 3px solid var(--grey-3)
      border-radius: .85rem
      background: var(--grey-1)
      color: var(--primary-color)
      box-shadow: 0 2px 6px var(--grey-9-a1)
      font-size: 1rem
      line-height: 1
      cursor: pointer

      &:hover
        background: var(--color-red-a1)

      &:focus-visible
        outline: 2px solid var(--primary-color)
        outline-offset: 2px

  @media (max-width: 767px)
    &, &[data-side='left']
      inset: .375rem
      width: calc(100vw - .75rem)
      height: calc(100dvh - .75rem)
      border-radius: .85rem
    padding-inline: .75rem

  @media (prefers-reduced-motion: reduce)
    &[open]
      animation: none

@keyframes comment-slide-right
  from
    transform: translateX(2rem)
    opacity: 0
  to
    transform: translateX(0)
    opacity: 1

@keyframes comment-slide-left
  from
    transform: translateX(-2rem)
    opacity: 0
  to
    transform: translateX(0)
    opacity: 1

#comments
  .wl-user
    position: relative

  .wl-user img, .wl-content img
    transition: filter .25s ease, opacity .25s ease

    &.comment-media-pending
      filter: blur(5px)
      opacity: .45
      background: var(--grey-3)

  img.comment-media-ready
    animation: comment-media-reveal .8s ease-in-out both

  @keyframes comment-media-reveal
    from
      filter: blur(10px)
    to
      filter: blur(0)

  @media (prefers-reduced-motion: reduce)
    .wl-user img, .wl-content img
      transition: none
      animation: none

  .comment-locate-burst
    position: absolute
    z-index: 1
    width: 0
    height: 0
    pointer-events: none

  .comment-locate-ring
    position: absolute
    border: 2px solid var(--primary-color)
    border-radius: 50%
    pointer-events: none

  .comment-locate-dot
    position: absolute
    width: 4px
    height: 4px
    margin: -2px
    border-radius: 50%
    background: var(--color-pink)
    pointer-events: none

    &:nth-child(3n)
      background: var(--color-aqua)

    &:nth-child(3n + 1)
      background: var(--color-orange)

  --waline-font-size: 1rem
  --waline-theme-color: var(--primary-color)
  --waline-active-color: var(--color-pink)
  --waline-color: var(--text-color)
  --waline-bg-color: var(--grey-1)
  --waline-bg-color-light: var(--grey-2)
  --waline-bg-color-hover: var(--color-red-a1)
  --waline-border-color: var(--grey-3)
  --waline-light-grey: var(--grey-5)
  --waline-dark-grey: var(--grey-6)
  --waline-info-color: var(--grey-5)
  --waline-info-bg-color: var(--grey-2)
  --waline-disable-color: var(--grey-5)
  --waline-disable-bg-color: var(--grey-2)
  --waline-badge-color: var(--primary-color)
  --waline-bq-color: var(--grey-3)
  --waline-avatar-size: 3rem
  --waline-avatar-radius: 50%
  --waline-border: 1px solid var(--waline-border-color)
  --waline-box-shadow: none
  color: var(--text-color)

  .wl-comment > .wl-login-info
    flex-shrink: 0
    margin-inline-end: .875rem

    + .wl-panel
      margin-inline-start: 0

  .wl-panel
    display: flex
    flex-direction: column
    min-width: 0
    margin: .5rem 0 .5rem .75rem
    border-radius: .75rem
    box-shadow: 0 4px 18px var(--grey-9-a1)

  .wl-header
    margin: 0 1rem
    padding: .25rem 0
    border-bottom-width: 1px

    input
      font-size: .875rem

  .wl-editor
    width: calc(100% - 2rem)
    min-height: 8rem
    margin: 1rem
    padding: .25rem
    font-family: inherit
    font-size: 1rem
    line-height: 1.8

    &:focus, &:focus-visible
      border: none
      outline: none
      box-shadow: none
      background: transparent

  .wl-footer
    order: 2
    gap: .5rem
    align-items: center
    margin: .75rem 1rem 1rem

  .wl-actions
    flex: 1 0 auto
    flex-wrap: wrap
    gap: 0

  .wl-info
    flex: 0 0 auto
    margin-inline-start: auto

  .wl-text-number
    white-space: nowrap

  .wl-action, .wl-private-reply
    box-sizing: border-box !important
    position: relative
    display: inline-flex
    align-items: center
    justify-content: center
    flex-shrink: 0
    width: 24px
    height: 24px
    margin: 2px
    padding: 0
    border: 0
    border-radius: .5rem
    background: transparent
    color: var(--grey-6)
    cursor: pointer
    font-size: 16px
    transition: color .2s ease, background .2s ease

    > svg
      display: block
      flex-shrink: 0
      width: 24px
      height: 24px

    > .ic
      font-size: 24px
      line-height: 1

    &:hover, &.active, &[aria-checked='true'], &:has(input:checked)
      color: var(--primary-color)

    &:focus-visible, &:has(input:focus-visible)
      outline: 2px solid var(--primary-color)
      outline-offset: -2px

  .shokax-comment-controls
    display: contents

  .shokax-editor-tools
    position: absolute
    z-index: 1
    top: -.625rem
    inset-inline-start: .375rem
    display: flex
    margin: 0
    padding: 0 .125rem
    border-radius: .25rem
    background: var(--waline-bg-color)

    > .shokax-markdown-guide
      width: 1.5rem
      height: 1.25rem
      margin: 0
      color: var(--color-blue)
      opacity: .7

      > svg
        width: 1rem
        height: 1rem

      &:hover
        color: var(--color-blue)
        opacity: 1

  .wl-btn
    padding: .6rem 1.1rem
    border-radius: .5rem
    font-size: .875rem
    transition: color .2s ease, background .2s ease, border-color .2s ease

  .wl-footer .wl-btn
    box-sizing: content-box !important
    display: inline-block
    height: auto
    min-height: 0
    padding: .5em 1em
    line-height: 1.5
    font-size: .75em
    border-radius: .5em

  .wl-footer .wl-btn.primary, .wl-card .wl-comment-actions .wl-reply
    box-sizing: border-box !important
    display: inline-flex
    align-items: center
    justify-content: center
    min-height: 2rem
    padding: .375rem .875rem
    border: 1px solid var(--grey-4)
    border-radius: .85rem
    font-size: .8125rem
    line-height: 1
    transition: color .22s ease, background .22s ease, border-color .22s ease, box-shadow .22s ease

    &:not(:disabled)
      background: transparent
      color: var(--primary-color)
      box-shadow: 0 2px 5px var(--grey-9-a1)

      &:hover, &:focus-visible, &:active, &.active
        border-color: var(--primary-color)
        background: transparent
        color: var(--primary-color)

  .wl-card .wl-admin-actions
    display: flex
    justify-content: flex-end
    align-items: center
    flex-wrap: wrap
    gap: .5rem
    margin: .75rem 0

    .wl-comment-status
      display: inline-flex
      align-items: center
      gap: .125rem
      margin: 0
      padding: .1875rem
      border: 1px solid var(--grey-3)
      border-radius: .65rem
      background: var(--grey-2)

      .wl-btn
        display: inline-flex
        box-sizing: border-box !important
        align-items: center
        justify-content: center
        gap: .3rem
        min-height: 1.75rem
        min-width: 3.25rem
        margin: 0
        padding: .25rem .5rem
        border: 0
        border-radius: .45rem
        background: transparent
        color: var(--grey-5)
        font-size: .75rem
        line-height: 1
        --moderation-color: var(--primary-color)

        &.wl-approved
          --moderation-color: var(--color-green)
        &.wl-waiting
          --moderation-color: var(--color-orange)
        &.wl-spam
          --moderation-color: var(--color-red)

        &:hover:not(:disabled)
          background: var(--grey-1)
          color: var(--moderation-color)

        &:disabled
          opacity: 1
          cursor: default
          background: var(--grey-1)
          color: var(--moderation-color)
          box-shadow: 0 1px 3px var(--grey-9-a1)

          &::before
            content: ''
            width: .3rem
            height: .3rem
            border-radius: 50%
            background: currentColor

    > .wl-sticky
      min-height: 1.75rem
      padding: .25rem .65rem
      border-radius: .6rem
      font-size: .75rem

  .wl-private-reply
    // Keep the native label and checkbox accessible without a second switch.
    font-size: 0 !important

    input
      position: absolute
      width: 1px
      height: 1px
      margin: 0
      opacity: 0
      clip-path: inset(50%)

    .is-locked
      display: none

    &:has(input:checked)
      .is-unlocked
        display: none
      .is-locked
        display: block

    &:has(input:disabled)
      cursor: default
      opacity: .55

  .wl-head .wl-badge.shokax-private-badge
    gap: .3rem
    color: var(--color-blue)
    background: var(--color-blue-a1)
    border-color: var(--color-blue-a3)

    &::before
      content: '\1F512'
      font-size: .65rem

  button:focus-visible, a:focus-visible, .wl-input:focus-visible
    outline: 2px solid var(--primary-color)
    outline-offset: 3px

  // An in-flow drawer keeps the emoji picker from covering the preview/list.
  .wl-emoji-popup
    position: relative
    inset: auto
    flex-basis: 100%
    min-width: 0
    width: auto
    max-width: none
    margin: .5rem 0 0
    border-radius: .65rem
    background: var(--grey-2)

    .wl-tab-wrapper
      max-height: 15rem
      padding: .5rem
      overscroll-behavior: contain

    button
      width: 2.75rem
      height: 2.75rem
      border-radius: .4rem
      line-height: 2.75rem

    .wl-emoji
      max-width: 2rem
      max-height: 2rem

    .wl-tabs
      padding: .4rem

    .wl-tab
      margin-inline-end: .25rem
      padding: 0 .25rem

      &.active
        border: 0
        border-radius: .4rem
        background: var(--color-red-a1)
        box-shadow: inset 0 -2px var(--primary-color)

  .wl-preview
    --preview-inline-space: 1rem
    position: relative
    order: 1
    margin: 0 var(--preview-inline-space) .5rem
    padding: .75rem 0 0
    border: 0
    border-top: 1px dashed var(--grey-4)
    border-radius: 0
    background: transparent

    > hr
      display: none

    > h4
      position: absolute
      top: 0
      inset-inline-start: calc(.5rem - var(--preview-inline-space))
      transform: translateY(-50%)
      margin: 0
      padding: 0 .25rem
      background: var(--waline-bg-color)
      color: var(--primary-color)
      font-size: .875rem
      line-height: 1.25

  .wl-content
    font-size: .9375rem
    line-height: 1.85

    // MiniValine used .emoji; Waline uses .wl-emoji / .vemoji.
    // Override the theme's block-image layout only for inline emoji.
    img.emoji, img.vemoji, img.wl-emoji
      display: inline-block
      width: auto
      height: 1.3em
      max-width: none
      max-height: 1.3em
      margin: 0 .15em
      padding: 0
      border: 0
      border-radius: 0
      box-shadow: none
      vertical-align: -.2em

    a
      max-width: 100%
      overflow-wrap: anywhere

    pre
      border: var(--waline-border)
      border-radius: .5rem

    // Native preview exists before async Shiki finishes; keep its palette stable.
    pre:not(.shiki)
      background: var(--code-bg) !important
      color: var(--text-color)

      code
        background: transparent !important
        color: inherit

    .shokax-code
      margin: .75rem 0
      max-width: 100%

      pre.shiki
        margin: 0
        padding: 1rem
        border: 0
        border-radius: 0

      pre.shiki code
        color: inherit
        background: transparent
        padding: 0

    table
      display: block
      max-width: 100%
      overflow-x: auto

    blockquote
      margin-inline: 0
      padding: .25rem 1rem
      border-inline-start: 3px solid var(--primary-color)
      background: var(--grey-2)

  .wl-meta-head
    gap: .75rem
    flex-wrap: wrap
    padding: 1.25rem 0
    border-bottom: 1px solid var(--grey-3)

  .wl-count
    font-size: 1.375rem
    letter-spacing: .025em

  .wl-cards > .wl-card-item
    padding: 1.5rem 0 .5rem

  .wl-card
    padding-bottom: 1.25rem

    > .wl-content
      padding-top: .8rem
      margin-bottom: 1rem

    .wl-head
      display: flex
      flex-wrap: wrap
      align-items: center
      gap: .5rem .75rem
      overflow: visible

      .wl-nick
        margin: 0
        font-size: 1rem
        line-height: 1.5
        overflow-wrap: anywhere

    .wl-badge
      display: inline-flex
      align-items: center
      max-width: 100%
      margin: 0
      // Optical centering for the theme's rounded CJK font; total height stays 21px.
      box-sizing: border-box
      justify-content: center
      padding: .3125rem .5rem .125rem
      border: 1px solid var(--color-pink-a3)
      border-radius: 999px
      background: linear-gradient(120deg, var(--color-pink-light), var(--color-red-a3))
      color: var(--primary-color)
      font-size: .75rem
      font-weight: 600
      line-height: 1
      overflow-wrap: anywhere

    .wl-badge.shokax-friend-badge
      color: var(--friend-light-text, #347d83)
      background: var(--friend-light-background, #eaf5f4)
      border-color: var(--friend-light-border, #c5e3df)

      html[data-theme='dark'] &
        color: var(--friend-dark-text, #9ad5ce)
        background: var(--friend-dark-background, #253b3c)
        border-color: var(--friend-dark-border, #3d6262)

    .wl-time
      display: inline-flex
      align-items: center
      box-sizing: border-box
      margin: 0
      padding-top: .125rem
      color: var(--grey-5)
      font-size: .75rem
      line-height: 1

    .wl-comment-actions
      display: inline-flex
      align-items: center
      gap: .35rem
      margin-inline-start: auto

      .wl-reply
        gap: .35rem

        &::after
          content: attr(aria-label)
          display: block
          line-height: 1

        svg
          display: block
          flex: 0 0 1.125rem
          width: 1.125rem
          height: 1.125rem
          color: inherit
          transform: translateY(-.03rem)

      .wl-like
        display: inline-flex
        align-items: center
        gap: .2rem
        padding: .35rem
        font-size: .75rem

        svg
          width: 1.1rem
          height: 1.1rem

    .wl-meta
      display: flex
      flex-wrap: wrap
      align-items: center
      gap: .35rem
      margin: .65rem 0 .15rem

      > span
        display: inline-flex
        align-items: center
        gap: .3rem
        max-width: 100%
        margin: 0
        padding: .2rem .55rem
        border: 1px solid var(--grey-3)
        border-radius: 999px
        background: linear-gradient(120deg, var(--grey-2), var(--grey-1))
        color: var(--grey-6)
        font-size: .75rem
        line-height: 1.5
        overflow-wrap: anywhere

        &::before
          flex: 0 0 1em
          align-self: center
          width: 1em
          height: 1em
          line-height: 1
          margin: 0
          background-size: contain
          opacity: .85

      .wl-browser
        order: 0

      .wl-os
        order: 1

      .wl-addr
        order: -1

    .wl-quote
      margin-top: 1rem
      padding-inline-start: .5rem
      border-inline-start: 1px dashed var(--grey-4)

      .wl-card-item
        padding-top: 1rem

  .wl-cards > .wl-card-item > .wl-user
    margin-inline-end: 1rem

  // Use Waline's verified administrator marker, never infer roles from nicknames.
  .wl-card-item:has(> .wl-user .administrator-icon) > .wl-card > .wl-head > .wl-badge:not(.shokax-private-badge)
    color: var(--primary-color)
    background: linear-gradient(120deg, var(--color-red-a3), var(--color-pink-a3))
    border-color: var(--color-red-a3)
    box-shadow: 0 2px 6px var(--color-red-a1)

  .wl-user-avatar
    border: 2px solid var(--grey-1)
    outline: 1px solid var(--grey-3)

  .wl-sort li
    padding: .35rem .5rem
    border-radius: .4rem

    &.active
      background: var(--color-red-a1)

  .wl-meta-foot
    display: flex
    align-items: center
    justify-content: space-between
    flex-wrap: wrap
    gap: .75rem 1rem
    margin-top: 1rem
    padding: 1rem 0 .25rem
    border-top: 1px solid var(--grey-3)

  .wl-rss
    display: inline-flex
    align-items: center
    flex-wrap: nowrap
    gap: 0
    margin: 0
    max-width: 100%
    overflow: visible
    transition: gap .28s ease

    > a
      display: inline-flex
      box-sizing: border-box
      align-items: center
      justify-content: center
      flex-shrink: 0
      gap: 0
      height: 1.75rem
      margin: 0
      padding: 0 .3rem
      overflow: hidden
      border: 1px solid transparent
      border-radius: 999px
      background: transparent
      color: var(--grey-6)
      font-size: .8125rem
      line-height: 1
      text-decoration: none
      transition: padding .28s ease, max-width .28s ease, opacity .22s ease, background .22s ease, border-color .22s ease

      > svg
        display: block
        flex: 0 0 1rem
        width: 1rem
        height: 1rem
        margin: 0
        align-self: center
        vertical-align: middle

      > span
        display: inline-flex
        align-items: center
        align-self: center
        height: 1rem
        line-height: 1rem
        max-width: 0
        margin-inline-start: 0
        overflow: hidden
        opacity: 0
        white-space: nowrap
        color: inherit
        font-size: inherit
        transition: max-width .28s ease, margin .28s ease, opacity .22s ease

      &:last-child
        max-width: 0
        padding-inline: 0
        border-width: 0
        opacity: 0
        pointer-events: none

      &:hover
        color: var(--primary-color)

      &:focus-visible
        outline: 2px solid var(--primary-color)
        outline-offset: 2px

    &:hover, &:focus-within
      gap: .4rem

      > a
        max-width: 14rem
        padding-inline: .6rem
        border: 1px solid var(--grey-3)
        background: var(--grey-2)
        opacity: 1
        pointer-events: auto

        > span
          max-width: 11rem
          margin-inline-start: .35rem
          opacity: 1

        &:hover
          border-color: var(--color-pink-a3)
          background: var(--color-red-a1)

    @media (hover: none)
      gap: .4rem
      flex-wrap: wrap
      > a
        max-width: 14rem
        padding-inline: .6rem
        border: 1px solid var(--grey-3)
        background: var(--grey-2)
        opacity: 1
        pointer-events: auto
        > span
          max-width: 11rem
          margin-inline-start: .35rem
          opacity: 1

    @media (prefers-reduced-motion: reduce)
      &, > a, > a > span
        transition: none

  .wl-power
    margin: 0
    color: var(--grey-5)
    font-size: .6875rem

  @media (max-width: 580px)
    --waline-avatar-size: 2.5rem

    .wl-panel
      margin-inline-start: .35rem

    .wl-header
      margin-inline: .75rem

    .wl-editor
      width: calc(100% - 1.5rem)
      min-height: 7rem
      margin: .75rem

    .wl-footer, .wl-preview
      margin-inline: .75rem

    .wl-preview
      --preview-inline-space: .75rem

    .wl-card .wl-quote .wl-card-item
      padding-inline-start: .35rem

    .wl-card .wl-quote
      padding-inline-start: 0

    .wl-card .wl-head
      gap: .35rem .5rem

    .wl-card .wl-meta > span
      padding: .15rem .4rem
      font-size: .6875rem

    .wl-cards > .wl-card-item > .wl-user
      margin-inline-end: .6rem

    .wl-sort li + li
      margin-inline-start: .25rem

  @media (prefers-reduced-motion: reduce)
    .wl-panel, .wl-action, .wl-btn, .wl-private-reply, .wl-card .wl-comment-actions .wl-reply
      transition: none

@media (max-width: 767px)
  #comments .wl-comment > .wl-login-info
    margin-inline-end: .625rem

// Display-only mode. Server authorization remains the write protection.
.comment-dialog #comments
  .wl-panel
    margin: .75rem 0 1rem
    box-shadow: 0 2px 8px var(--grey-9-a1)

  .wl-editor
    min-height: 7rem
    margin-block: .75rem

  .wl-footer
    margin-block: .25rem .75rem

  .wl-meta-head
    padding: .75rem 0

  .wl-count
    font-size: 1.125rem

  .wl-cards > .wl-card-item
    padding-top: 1rem

  .wl-card
    padding-bottom: .65rem

    > .wl-content
      padding-top: .5rem
      margin-bottom: .5rem

    .wl-quote
      margin-top: .65rem

    .wl-meta
      margin-top: .4rem

#comments.waline-readonly
  .wl-panel, .wl-action
    display: none !important
