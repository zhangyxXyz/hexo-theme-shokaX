.index.wrap .meta.footer.summary-footer {
  align-items: center;
  line-height: 1.4;
  gap: .55rem;
  overflow: visible;
  .summary-switch { flex: 0 0 auto; }
  .summary-model-picker { color: inherit; }
  span { margin-right: 0; }
  .summary-category { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .summary-switch button, .summary-fixed { color: var(--grey-5); }
  .summary-switch:has(+ .summary-category)::after {
    content: '';
    width: 1px;
    height: .7em;
    margin-left: .55rem;
    border-radius: 1px;
    background: var(--grey-4);
    opacity: .55;
    flex: 0 0 1px;
  }
  .summary-switch button:hover { color: var(--primary-color); }
  .summary-switch, .summary-model-picker, .summary-category { display: inline-flex; align-items: center; line-height: inherit; }
  .summary-switch .summary-picker-trigger, .summary-category > a {
    display: inline-flex;
    align-items: center;
    gap: .2em;
    padding: 0;
    height: 1.4em;
    line-height: 1.4;
  }
  .summary-switch .summary-picker-trigger .ic, .summary-category .ic {
    width: 1em;
    height: 1em;
    flex: 0 0 1em;
    margin: 0;
    font-size: 1em;
    line-height: 1;
  }
  .summary-switch .summary-picker-trigger .ic, .summary-fixed > .ic {
    // Compensate for the icon font's lower visual baseline without moving the label.
    transform: translateY(-.08em);
  }
}
.info:has(.summary-switch) .excerpt { min-height: 5rem; }
.summary-switch {
  display: inline-flex;
  vertical-align: -.12em;
  align-items: center;
  margin-inline-start: 0;
  padding: 0;
  gap: .05rem;
  border-radius: 1rem;
  background: transparent;
  border: 0;
  font-size: inherit;
  line-height: 1;
  button, .summary-fixed {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: 0 .35rem;
    border: 0;
    border-radius: 1rem;
    background: transparent;
    color: var(--grey-6);
    font: inherit;
    white-space: nowrap;
  }
  button { cursor: pointer; transition: background .2s, color .2s; }
  button[aria-pressed='true'], .summary-fixed { background: transparent; color: var(--grey-6); box-shadow: none; }
  button:focus-visible, .summary-fixed:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 2px; }
  button:hover { color: var(--primary-color); }
  .summary-model-picker {
    position: relative;
    display: inline-flex;
    padding: 0;
    color: var(--grey-6);
    select { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .summary-picker-trigger {
      justify-content: center;
      gap: .28rem;
      padding: 0 .12rem;
      min-width: 1.1rem;
      height: 1.2em;
      line-height: 1;
      .ic { display: inline-flex; align-items: center; line-height: 1; }
      .summary-picker-arrow { width: .65rem; height: .65rem; flex-basis: .65rem; }
    }
  }
}
.excerpt[data-summary-panel][hidden] { display: none !important; }
