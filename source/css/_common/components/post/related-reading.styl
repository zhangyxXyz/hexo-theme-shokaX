.related-reading {
  --archive-axis: unquote('color-mix(in srgb, var(--grey-5) 20%, transparent)');
  margin: 1.5rem 0;
  padding: 1.15rem 1.4rem;
  border: 1px solid var(--archive-axis);
  border-radius: 1rem;
  h2 { display: flex; align-items: center; gap: .6rem; margin: 0; font-size: 1rem; font-weight: 500; .ic { color: var(--primary-color); } }
  .related-reading-description { margin: .4rem 0 .75rem; font-size: .8rem; color: var(--grey-6); }
  .related-reading-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .25rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  .article-preview-row { grid-template-columns: 1.1rem minmax(0, 1fr) auto; gap: .35rem; min-height: 2.25rem; padding: .2rem .25rem; > .ic { font-size: .75rem; color: var(--grey-6); } }
  [hidden] { display: none !important; }
  .post-nav {
    gap: .75rem;
    margin: 1rem 0 0;
    .item {
      flex: 1;
      min-width: 0;
      a { min-height: 7.5rem; padding: .85rem 1rem; border-radius: .65rem; overflow: hidden; background-position: center; }
      a::before { opacity: .6; }
      a:hover::before { opacity: .45; }
      .type { display: inline-flex; align-items: center; gap: .25rem; font-size: .7rem; opacity: .85; }
      .category { display: inline-flex; align-items: center; gap: .3rem; margin-top: .15rem; font-size: .68rem; opacity: .9; }
      .type > span, .category > span { font-size: inherit; }
      .type > .ic, .category > .ic { font-size: .75rem; flex-shrink: 0; }
      h3 { margin: auto 0 0; padding-top: .65rem; font-size: .9rem; line-height: 1.5; }
    }
  }
  .related-reading-list + .post-nav { border-top: 1px solid var(--archive-axis); padding-top: 1rem; }
}
@media (max-width: 767px) {
  .related-reading { padding: 1rem; .related-reading-list { grid-template-columns: minmax(0, 1fr); } }
}
