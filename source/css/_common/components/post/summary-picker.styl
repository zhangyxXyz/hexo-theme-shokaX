.summary-picker-enhanced > select[hidden], .summary-model-picker.summary-picker-enhanced > span { display: none !important; }
.summary-picker-trigger {
  display: inline-flex;
  align-items: center;
  gap: .65rem;
  min-width: 1.2rem;
  padding: .15rem .25rem;
  border: 0;
  border-radius: .8rem;
  background: transparent;
  color: inherit;
  font: inherit;
  cursor: pointer;
  span { overflow-wrap: anywhere; }
  &:focus { outline: none; }
  &:focus-visible { box-shadow: 0 0 0 2px var(--color-blue); }
  &[aria-expanded='true'] .summary-picker-arrow { transform: rotate(90deg); }
}
.summary-picker-arrow {
  display: block;
  width: .75rem;
  height: .75rem;
  flex: 0 0 .75rem;
  transform: rotate(0deg);
  transform-origin: 50% 50%;
  line-height: 0;
  svg { display: block; width: 100%; height: 100%; }
  opacity: .65;
  transition: transform .18s;
}
.summary-picker-menu {
  position: fixed;
  z-index: 1100;
  box-sizing: border-box;
  padding: .25rem;
  max-width: calc(100vw - 24px);
  overflow-y: auto;
  border: 1px solid rgba(120, 179, 199, .12);
  border-radius: .6rem;
  background: var(--grey-1);
  background: unquote('color-mix(in srgb, var(--grey-1) 92%, transparent)');
  backdrop-filter: blur(18px);
  box-shadow: 0 .4rem 1.2rem rgba(0, 0, 0, .13);
  font-size: .75rem;
  line-height: 1.5;
}
.summary-picker-option {
  display: flex;
  align-items: center;
  gap: .5rem;
  box-sizing: border-box;
  width: 100%;
  padding: .4rem .55rem;
  border: 0;
  border-radius: .35rem;
  background: transparent;
  color: var(--grey-7);
  text-align: start;
  font: inherit;
  cursor: pointer;
  .ic { color: var(--grey-6); flex-shrink: 0; font-size: .9rem; }
  span { overflow-wrap: anywhere; }
  .summary-picker-check { margin-inline-start: auto; width: .25rem; height: .25rem; flex-shrink: 0; border-radius: 50%; }
  &:hover, &:focus-visible { outline: none; background: rgba(105, 184, 212, .09); }
  &[aria-selected='true'] {
    background: rgba(105, 184, 212, .045);
    color: var(--color-blue);
    .ic { color: inherit; }
    .summary-picker-check { background: currentColor; }
  }
}
@media (prefers-reduced-motion: reduce) {
  .summary-picker-arrow { transition: none; }
}
