.post .post-end-meta {
  display: grid;
  gap: .85rem;
  margin-top: 1.5rem;
  padding: 1rem 0 .75rem;

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem .625rem;
    margin: 0;
    min-width: 0;
    a { max-width: 100%; overflow-wrap: anywhere; }
    a:not(:last-child) { margin-right: 0; }
  }
  .meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: .4rem .8rem;
    min-width: 0;
    line-height: 1.6;
    .item { margin: 0; }
    .item:empty { display: none; }
  }
  .tags + .meta {
    border-top: 1px solid var(--grey-3);
    padding-top: .85rem;
  }
}
@media (max-width: 767px) {
  .post .post-end-meta .meta {
    justify-content: flex-start;
    text-align: left;
  }
}
