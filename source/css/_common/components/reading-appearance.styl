for pattern, mask in $reading-patterns {
  html[data-reading-texture={pattern}],
  .reading-settings-texture-preview[data-texture={pattern}] {
    --reading-texture-mask: unquote(mask);
  }
}

html[data-reading-texture] main {
  position: relative;

  &::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    opacity: var(--reading-texture-opacity, .12);
    mask-image: var(--reading-texture-mask);
    mask-repeat: repeat;
  }

  // The opaque reading surface and cover cards stay above the decorative layer.
  > .inner { position: relative; }
}

.reading-settings-texture-preview {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--accent-soft), var(--grey-2));

  &::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    mask-image: var(--reading-texture-mask);
    mask-repeat: repeat;
    mask-size: auto 100%;
    opacity: .48;
  }

  &[data-texture='none']::before { display: none; }
}

// Only the home feed (including its pagination) opts into a second column.
// Narrow screens retain the theme's existing single-column cards.
@media (min-width: s('calc(%s + 1px)', $mobile-wdith)) {
  html[data-reading-home-layout='grid'] [data-reading-home] .segments.posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 1rem;
    align-items: start;

    > .item {
      width: auto;
      min-width: 0;
      height: auto;
      max-height: none;
      margin: 0;
      flex-direction: column;

      .cover {
        width: 100%;
        height: 10rem;
        margin: 0;
        clip-path: none;
        border-radius: .625rem .625rem 0 0;
      }

      .info {
        width: 100%;
        min-width: 0;
        min-height: 15rem;
        padding: .75rem 1rem 3.25rem;

        h3 {
          display: -webkit-box;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 2;
          white-space: normal;
          line-height: 1.5;
          min-height: 3em;
        }

        > .meta { flex-wrap: wrap; justify-content: flex-start; }

        .meta.footer {
          left: 1rem;
          right: 6rem;
          max-width: none;
          flex-wrap: nowrap;
        }
      }

      .btn {
        left: auto;
        right: 0;
        border-radius: 1rem 0;
        background-image: linear-gradient(to right, var(--accent-fill-start), var(--accent-fill-end));
      }

      &:hover {
        .info { width: 100%; }
        .cover { filter: brightness(.85); }
        .cover img { transform: scale(1.06); }
      }
    }
  }
}
