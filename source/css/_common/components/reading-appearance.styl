// Optional reader choices. With no preference attributes, the theme is unchanged.
html[data-reading-background='gradient'] {
  #imgs {
    background: unquote('linear-gradient(135deg, color-mix(in srgb, var(--accent-start) 12%, var(--grey-1)), color-mix(in srgb, var(--accent-end) 14%, var(--grey-1)))');

    > img, > ul { visibility: hidden; }
    .item { animation-play-state: paused; }
    &::before { background: transparent; }
  }

  #header {
    --header-text-color: var(--grey-7);
    text-shadow: none;
  }

  #brand .artboard { --brand-glitch-blend: normal; }
}

