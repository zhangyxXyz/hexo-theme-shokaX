.select-picker-enhanced > select[hidden], .select-picker-trigger [hidden] { display: none !important; }
.select-picker-trigger {
  control-focus(2px);
  display: inline-flex;
  align-items: center;
  gap: .65rem;
  min-width: 1.2rem;
  padding: .15rem .25rem;
  border: 0;
  border-radius: .5rem;
  background: transparent;
  color: inherit;
  font: inherit;
  cursor: pointer;
  span { overflow-wrap: anywhere; }
  &:focus:not(:focus-visible) { outline: none; }
  &[aria-expanded='true'] .select-picker-arrow { transform: rotate(90deg); }
}
.select-picker-arrow {
  display: block;
  width: .75rem;
  height: .75rem;
  flex: 0 0 .75rem;
  transform: rotate(0deg);
  transform-origin: 50% 50%;
  line-height: .75rem;
  font-size: .75rem;
  svg { display: block; width: 100%; height: 100%; }
  opacity: .65;
  transition: transform .18s;
}
.select-picker-menu {
  position: fixed;
  z-index: 1100;
  box-sizing: border-box;
  padding: .25rem;
  max-width: calc(100vw - 24px);
  overflow-y: auto;
  border: 1px solid var(--tooltip-border);
  border-radius: .6rem;
  background: var(--tooltip-bg);
  backdrop-filter: blur(18px);
  box-shadow: 0 .4rem 1.2rem var(--tooltip-shadow);
  font-size: .75rem;
  line-height: 1.5;
}
.select-picker-option {
  display: flex;
  align-items: center;
  gap: .5rem;
  box-sizing: border-box;
  width: 100%;
  padding: .4rem .55rem;
  border: 0;
  border-radius: .35rem;
  background: transparent;
  color: var(--tooltip-text);
  text-align: start;
  font: inherit;
  cursor: pointer;
  &:disabled { opacity: .45; cursor: default; }
  .ic { color: var(--grey-6); flex-shrink: 0; font-size: .9rem; }
  span { overflow-wrap: anywhere; }
  .select-picker-check { margin-inline-start: auto; width: .25rem; height: .25rem; flex-shrink: 0; border-radius: 50%; }
  &:not(:disabled):hover, &:focus-visible { outline: none; background: var(--accent-soft); }
  &[aria-selected='true'] {
    background: var(--accent-soft);
    color: var(--primary-color);
    .ic { color: inherit; }
    .select-picker-check { background: currentColor; }
  }
}
.select-picker-group + .select-picker-group {
  margin-top: .2rem;
  padding-top: .2rem;
  border-top: 1px solid var(--grey-3);
}
.select-picker-group-label {
  padding: .4rem .55rem .2rem;
  color: var(--grey-5);
  font-size: .7rem;
  font-weight: 600;
}
+reduced-motion() {
  .select-picker-arrow { transition: none; }
}
