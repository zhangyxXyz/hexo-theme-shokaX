.tabs {
  display: block;
  position: relative;

  .nav {
    border-bottom: .0625rem solid var(--grey-1-a7);
    height: 2.6875rem;

    ul {
      display: flex;
      padding: 0;
      white-space: nowrap;
      overflow-x: auto;
    }

    ul.special::before {
      font-family: ic;
      content: "\e652";
      font-size: x-large;
      padding-left: 1em;
    }

    li {
      position: relative;
      cursor: pointer;
      border: none;
      display: inline-block;
      padding: .3125rem 1.25rem;
      margin: 0;

      &::before {
        content: "";
        position: absolute;
        left: 50%;
        right: 50%;
        top: 2em;
        bottom: 0;
        transition: all .2s ease-in-out;
        width: auto;
        height: auto;
        background: none;
        border-radius: 0;
        border-bottom: .125rem solid transparent;
      }

      &.active::before {
        border-bottom-color: var(--primary-color);
        left: 0;
        right: 0;
      }
    }
  }

  .tab {
    display: none;
    @extend .fade-in;

    &.active {
      display: block;
    }
  }

  .show-btn {
    position: absolute;
    cursor: pointer;
    right: 0;
    bottom: 0;
    width: 2.875rem;
    height: 2.875rem;
    text-align: center;
    color: var(--grey-4);
    z-index: $zindex-1;

    &::before {
      font-family-icons();
      @extend .i-arrow-up:before;
    }
  }

}

// Article tabs share the Markdown block surface; player and comment tabs keep the base look.
.md .tabs {
  --tabs-accent: var(--accent-state, var(--primary-color));
  margin: 1.5rem 0 2rem;
  border: 1px solid var(--grey-3);
  border-radius: .875rem;
  background: var(--grey-1);

  > .nav {
    height: auto;
    padding: .375rem .5rem;
    border-bottom: 1px solid var(--grey-3);
    border-radius: .875rem .875rem 0 0;
    background: unquote('color-mix(in srgb, var(--grey-2) 60%, var(--grey-1))');

    ul {
      gap: .25rem;
      margin: 0;
      scrollbar-width: none;
    }

    li {
      padding: .375rem .875rem;
      border-radius: .5rem;
      color: var(--grey-5);
      font-size: .875rem;
      line-height: 1.5;
      transition: color .2s ease, background-color .2s ease;

      &::before { display: none; }

      &:hover {
        color: var(--text-color);
        background: unquote('color-mix(in srgb, var(--tabs-accent) 7%, transparent)');
      }

      &.active {
        color: var(--tabs-accent);
        background: unquote('color-mix(in srgb, var(--tabs-accent) 13%, var(--grey-1))');
      }
    }
  }

  .tab {
    padding: 1.25rem 1.5rem;

    +mobile() { padding: 1rem; }
  }

  .show-btn {
    width: 2.5rem;
    height: 2.5rem;
    line-height: 2.5rem;
    color: var(--grey-4);
    transition: color .2s ease;

    &:hover { color: var(--tabs-accent); }
  }
}
