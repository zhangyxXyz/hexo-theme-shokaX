// `::github{repo}` follows the project page card: copy on the left, a tilted window preview on the right.
.md .md-github {
  --gh-accent: var(--accent-state, var(--primary-color));
  --gh-soft: unquote('color-mix(in srgb, var(--gh-accent) 9%, var(--grey-1))');
  --gh-line: unquote('color-mix(in srgb, var(--gh-accent) 15%, var(--grey-2))');
  --gh-glow-tint: 3%;
  --gh-ease: cubic-bezier(.22, .61, .36, 1);
  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  gap: 1.75rem;
  align-items: center;
  margin: 1.5rem 0;
  padding: 1.5rem 1.75rem;
  border: 1px solid var(--gh-line);
  border-radius: 1.25rem;
  background: var(--grey-1);
  background: unquote('linear-gradient(180deg, color-mix(in srgb, var(--gh-accent) var(--gh-glow-tint), var(--grey-1)), var(--grey-1) 6rem)');
  box-shadow: 0 .625rem 1.875rem -.9375rem var(--box-bg-shadow);
  transition: border-color .3s, box-shadow .4s var(--gh-ease), translate .4s var(--gh-ease);
  &::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -1px;
    inset-inline: 12%;
    height: 1px;
    background: unquote('linear-gradient(90deg, transparent, color-mix(in srgb, var(--gh-accent) 70%, transparent), transparent)');
    opacity: .45;
    transition: opacity .4s var(--gh-ease), inset-inline .4s var(--gh-ease);
    pointer-events: none;
  }
  &:hover, &:focus-within {
    --gh-glow-tint: 4%;
    translate: 0 -3px;
    border-color: unquote('color-mix(in srgb, var(--gh-accent) 32%, var(--grey-2))');
    box-shadow: 0 1.5rem 2.5rem -1.5rem var(--box-bg-shadow);
    box-shadow: unquote('0 1.5rem 2.5rem -1.25rem color-mix(in oklch, var(--gh-accent) 45%, transparent), 0 .375rem 1rem -.5rem var(--box-bg-shadow)');
    &::before { opacity: .7; inset-inline: 8%; }
  }
  p { margin: 0; }

  .md-github-copy { min-width: 0; }
  .md-github-category {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .25rem .5rem;
    color: var(--grey-6);
    font-size: .8125rem;
    .ic { color: var(--gh-accent); }
  }
  .md-github-name {
    margin: .75rem 0 .5rem;
    color: var(--text-color);
    font-family: $font-family-title;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .md-github-description {
    margin-bottom: 1rem;
    color: var(--grey-6);
    line-height: 1.8;
  }
  .md-github-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin: 0 0 1.25rem;
    padding: 0;
    li {
      margin: 0;
      padding: .125rem .625rem;
      border-radius: .375rem;
      background: var(--gh-soft);
      color: var(--gh-accent);
      font-size: .75rem;
      line-height: 1.6;
      &::before { content: none; }
    }
    &[hidden] { display: none; }
  }
  .md-github-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem .75rem;
    font-size: .875rem;
    a {
      control-base();
      control-raised();
      control-focus($control-focus-offset, var(--gh-accent));
      color: var(--text-color);
      transition: color $control-duration, border-color $control-duration, box-shadow $control-duration;
      .ic {
        display: inline-grid;
        place-items: center;
        flex: 0 0 1.25rem;
        width: 1.25rem;
        height: 1.25rem;
        font-size: 1.15rem;
        line-height: 1;
        color: var(--grey-8);
        // The link glyph fills its em box; the GitHub mark has built-in padding.
        &.i-link-alt { font-size: .95rem; }
      }
      > span { line-height: 1.4; }
      &:hover, &:focus-visible { color: var(--gh-accent); border-color: var(--accent-border); }
      &[hidden] { display: none; }
    }
  }

  .md-github-preview {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--gh-line);
    border-radius: .875rem;
    background: var(--grey-0);
    transform: rotate(-2deg);
    transition: transform .3s;
    user-select: none;
  }
  &:hover .md-github-preview { transform: rotate(0); }
  .md-github-windowbar {
    display: flex;
    align-items: center;
    gap: .75rem;
    min-height: 2.25rem;
    padding: .5rem .875rem;
    border-bottom: 1px solid var(--gh-line);
    color: var(--grey-6);
    font-size: .6875rem;
    > span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  }
  .md-github-dots {
    display: flex;
    flex: none;
    gap: .375rem;
    span { width: .375rem; height: .375rem; border: 1px solid var(--grey-5); border-radius: 50%; }
  }
  .md-github-hero {
    display: grid;
    gap: .25rem;
    padding: 1.5rem .75rem 1.375rem;
    background: var(--gh-soft);
    color: var(--gh-accent);
    text-align: center;
    span { font-size: .75rem; opacity: .85; }
    strong { font-size: 1.375rem; font-weight: 500; line-height: 1.3; overflow-wrap: anywhere; }
  }
  .md-github-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .5rem;
    margin: 0;
    padding: .875rem 1rem 1rem;
    text-align: center;
    dt {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .25rem;
      color: var(--grey-6);
      font-size: .6875rem;
      &::before { content: none; }
    }
    svg {
      width: .8125rem;
      height: .8125rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.4;
      stroke-linejoin: round;
    }
    dd {
      margin: .125rem 0 0;
      padding: 0;
      color: var(--text-color);
      font-size: 1rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
  }
  .md-github-lines {
    display: grid;
    gap: .625rem;
    padding: 1.25rem 1.5rem;
    span { width: 90%; height: .4375rem; border-radius: .25rem; background: var(--gh-line); }
    span:nth-child(2) { width: 68%; }
  }
  // Placeholder bars stand in until live numbers arrive, and stay if the request fails.
  &[data-github-fetch]:not([data-github-state='ready']) .md-github-stats,
  &[data-github-state='ready'] .md-github-lines { display: none; }

  @media (max-width: 767px) {
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.25rem;
    .md-github-preview { width: 100%; max-width: 22rem; justify-self: center; transform: none; }
  }
  +reduced-motion() {
    transition: none;
    &:hover, &:focus-within { translate: none; }
    .md-github-preview, .md-github-actions a { transition: none; }
  }
}
html[data-theme='dark'] .md .md-github {
  --gh-glow-tint: 7%;
  &:hover, &:focus-within { --gh-glow-tint: 8%; }
}
