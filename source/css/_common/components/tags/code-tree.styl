// Code tree: a file nav beside one code panel. Without JS (no `.is-enhanced`)
// every panel is listed in order and the toolbar is hidden.
.md .md-code-tree {
  --ct-accent: var(--accent-state, var(--primary-color));
  --ct-line: var(--grey-3);
  margin: 1.5rem 0;
  overflow: hidden;
  border: 1px solid var(--ct-line);
  border-radius: .875rem;
  background: var(--code-bg);
  box-shadow: 0 .3rem .8rem var(--grey-9-a1);

  &.is-error p {
    margin: 0;
    padding: .875rem 1rem;
    color: var(--color-red);
    font-size: .8125rem;
    code { margin-left: .25rem; }
  }
}

.md .md-code-tree-bar {
  display: flex;
  align-items: center;
  gap: .25rem .75rem;
  min-height: 2.75rem;
  padding: .375rem .5rem .375rem 1rem;
  border-bottom: 1px solid var(--ct-line);
  background: var(--code-header-bg);
}

.md .md-code-tree-title {
  min-width: 0;
  overflow: hidden;
  color: var(--text-color);
  font-size: .875rem;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.md .md-code-tree-count {
  flex: none;
  color: var(--code-muted);
  font-size: .75rem;
}

.md .md-code-tree-tools {
  display: flex;
  align-items: center;
  gap: .125rem;
  margin-left: auto;

  button {
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    height: 1.875rem;
    padding: 0 .625rem;
    border: 0;
    border-radius: .375rem;
    background: transparent;
    color: var(--code-muted);
    font-size: .75rem;
    white-space: nowrap;
    cursor: pointer;
    transition: color .2s ease, background-color .2s ease;
    &:hover {
      color: var(--ct-accent);
      background: unquote('color-mix(in srgb, var(--ct-accent) 10%, transparent)');
    }
    &:focus-visible { outline: 2px solid var(--ct-accent); outline-offset: -2px; }
    &[hidden] { display: none; }
    .ic { font-size: .8125rem; line-height: 1; }
  }
}

.md .md-code-tree:not(.is-enhanced) .md-code-tree-tools { display: none; }

.md .md-code-tree-body {
  display: grid;
  grid-template-columns: minmax(9rem, 13.5rem) minmax(0, 1fr);
}

.md .md-code-tree.is-enhanced .md-code-tree-body { height: var(--md-code-tree-height, 420px); }

.md .md-code-tree-nav {
  overflow: auto;
  padding: .5rem .375rem;
  border-right: 1px solid var(--ct-line);
  background: unquote('color-mix(in srgb, var(--code-header-bg) 45%, var(--code-bg))');
  font-size: .8125rem;
  ul { margin: 0; padding: 0; }
  ul ul {
    margin-left: .5625rem;
    padding-left: .5rem;
    border-left: 1px dashed var(--ct-line);
  }
  li {
    margin: 0;
    line-height: 1.6;
    &::before { content: none; }
  }
  details, details[open] { margin: 0; background: none; color: inherit; border-radius: 0; }
  details > summary {
    display: flex;
    align-items: center;
    padding: 0;
    background: none;
    border-radius: .375rem;
    cursor: pointer;
    &::before {
      flex: none;
      width: 1.125rem;
      margin: 0;
      color: var(--grey-5);
      text-align: center;
    }
  }
  details[open] > summary { background: none; }
  summary:focus-visible { outline: 2px solid var(--ct-accent); outline-offset: -2px; }
  .md-tree-entry {
    flex-wrap: nowrap;
    max-width: none;
    min-width: 0;
  }
  .md-tree-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
}

.md .md-code-tree-file {
  display: flex;
  width: 100%;
  padding: 0 0 0 1.125rem;
  border: 0;
  border-radius: .375rem;
  background: none;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
  .md-tree-entry { flex: 1; }
  &:hover .md-tree-entry { background: var(--md-block-soft); }
  &:focus-visible { outline: 2px solid var(--ct-accent); outline-offset: -2px; }
  &[aria-current='true'] .md-tree-entry {
    background: unquote('color-mix(in srgb, var(--ct-accent) 14%, transparent)');
    .md-tree-name { color: var(--ct-accent); }
  }
}

.md .md-code-tree:not(.is-enhanced) .md-code-tree-file { cursor: default; }

.md .md-code-tree-panels {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
}

.md .md-code-tree-panel {
  display: flex;
  flex-direction: column;
  min-height: 0;
  & + & { border-top: 1px solid var(--ct-line); }
}

.md .md-code-tree.is-enhanced .md-code-tree-panel {
  &:not([data-active]) { display: none; }
  &[data-active] { flex: 1; border-top: 0; }
}

.md .md-code-tree-path {
  flex: none;
  padding: .375rem 1rem;
  overflow: hidden;
  border-bottom: 1px solid var(--ct-line);
  color: var(--code-muted);
  font-family: $font-family-monospace;
  font-size: .75rem;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.md .md-code-tree pre.shiki {
  flex: 1;
  min-height: 0;
  margin: 0;
  padding: .75rem 1rem;
  overflow: auto;
  border: 0;
  border-radius: 0;
  background-color: var(--code-bg) !important;
  font-family: $font-family-monospace;
  font-size: .875rem;
  line-height: 1.6;
  tab-size: 2;
  white-space: pre;
  code {
    display: block;
    width: max-content;
    min-width: 100%;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    counter-reset: code-line;
  }
  .line { display: inline-block; min-width: 100%; }
  .line::before {
    counter-increment: code-line;
    content: counter(code-line);
    display: inline-block;
    width: 3ch;
    margin-right: 1.5ch;
    color: var(--code-muted);
    text-align: right;
    user-select: none;
  }
}

.md-code-tree-dialog {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  border: 0;
  background: var(--grey-1);
  color: var(--text-color);
  .md-code-tree {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .md-code-tree.is-enhanced .md-code-tree-body { flex: 1; min-height: 0; height: auto; }
}

@media (max-width: 767px) {
  .md .md-code-tree-body { grid-template-columns: minmax(0, 1fr); }
  .md .md-code-tree.is-enhanced .md-code-tree-body {
    grid-template-rows: auto minmax(0, 1fr);
    height: auto;
  }
  .md .md-code-tree-nav {
    max-height: 9.5rem;
    border-right: 0;
    border-bottom: 1px solid var(--ct-line);
  }
  .md .md-code-tree.is-enhanced pre.shiki { max-height: var(--md-code-tree-height, 420px); }
  .md-code-tree-dialog .md-code-tree.is-enhanced pre.shiki { max-height: none; }
  .md .md-code-tree-tools button { height: 2.25rem; }
}
