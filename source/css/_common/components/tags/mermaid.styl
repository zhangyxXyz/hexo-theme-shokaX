// Mermaid diagrams. Top-level because the fullscreen dialog lives outside `.md`;
// the source is the no-script and failure fallback.
.md-mermaid {
  --mm-accent: var(--accent-state, var(--primary-color));
  --mm-line: unquote('color-mix(in srgb, var(--mm-accent) 15%, var(--grey-2))');
  --mm-dot: unquote('color-mix(in srgb, var(--text-color) 16%, transparent)');
  margin: 1.5rem 0;
  overflow: hidden;
  border: 1px solid var(--mm-line);
  border-radius: .875rem;
  background: var(--grey-1);
  text-align: left;

  &[data-mermaid-state='ready'] {
    .md-mermaid-bar { display: flex; }
    .md-mermaid-canvas, .md-mermaid-help { display: block; }
    .md-mermaid-source { display: none; }
  }
  &[data-mermaid-state='error']::before { content: attr(data-error-label); }
  &[data-mermaid-state='unavailable']::before { content: attr(data-unavailable-label); }
  &[data-mermaid-state='error']::before,
  &[data-mermaid-state='unavailable']::before {
    display: block;
    padding: .75rem 1rem 0;
    color: var(--color-red);
    font-size: .8125rem;
  }
}

.md-mermaid-bar {
  display: none;
  align-items: center;
  gap: .625rem;
  min-height: 3rem;
  padding: .5rem .5rem .5rem 1rem;
  border-bottom: 1px solid var(--mm-line);
}

// Diagram type, detected from the source; same pill as the theme's accent chips.
.md-mermaid-type {
  flex: none;
  padding: .125rem .625rem;
  border-radius: 999px;
  background: var(--accent-wash);
  color: var(--mm-accent);
  font-size: .75rem;
  font-weight: 600;
  line-height: 1.6;
}

.md-mermaid-title {
  min-width: 0;
  overflow: hidden;
  color: var(--text-color);
  font-size: .9375rem;
  white-space: nowrap;
  text-overflow: ellipsis;
}

// Same icons and hover as the statistics map zoom group, but bare: the card border
// already frames the header, so the buttons only show a wash on hover.
.md-mermaid-tools {
  display: flex;
  align-items: center;
  gap: .125rem;
  margin-left: auto;

  [data-mermaid-action='fullscreen'] { margin-left: .375rem; }

  button {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: .375rem;
    background: transparent;
    color: var(--grey-5);
    cursor: pointer;
    transition: color .2s ease, background-color .2s ease;
    &:hover:not(:disabled), &:focus-visible:not(:disabled) {
      color: var(--mm-accent);
      background: var(--accent-wash);
    }
    &:focus-visible { outline: 2px solid var(--mm-accent); outline-offset: -2px; }
    &:disabled { opacity: .35; cursor: default; }
    .ic { width: .9375rem; height: .9375rem; margin: 0; font-size: .9375rem; line-height: 1; }
  }
}

.md-mermaid-zoom {
  min-width: 2.75rem;
  color: var(--grey-5);
  font-family: $font-family-monospace;
  font-size: .75rem;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

// Doubled class beats the article's `.md p` bottom margin.
.md-mermaid-help.md-mermaid-help {
  display: none;
  margin: 0;
  padding: .5rem 1rem;
  line-height: 1.5;
  border-top: 1px solid var(--mm-line);
  color: var(--grey-5);
  font-size: .6875rem;
  text-align: center;
}
.md-mermaid-help-touch { display: none; }
@media (pointer: coarse) {
  .md-mermaid-help-desktop { display: none; }
  .md-mermaid-help-touch { display: inline; }
}

.md-mermaid-canvas {
  display: none;
  position: relative;
  overflow: hidden;
  background-color: var(--grey-0);
  background-image: radial-gradient(circle, var(--mm-dot) 1px, transparent 1.2px);
  background-size: 16px 16px;
  cursor: grab;
  touch-action: pan-y;
  &.is-zoomed { touch-action: none; }
  &.is-dragging { cursor: grabbing; user-select: none; }
  &:focus-visible { outline: 2px solid var(--mm-accent); outline-offset: -2px; }
}

.md-mermaid-stage {
  position: absolute;
  top: 0;
  left: 0;
  transform-origin: 0 0;
  svg { display: block; max-width: none; }
  // Mermaid 12 adds hard grey drop shadows (CSS and SVG filters) that clash with the dark theme.
  svg :is(rect, polygon, path, circle, ellipse) { filter: none !important; }
}

.md-mermaid-source {
  margin: 0;
  padding: 1rem;
  overflow-x: auto;
  border: 0;
  border-radius: 0;
  background: none;
  white-space: pre;
  color: var(--grey-6);
  font-size: .8125rem;
  code { padding: 0; background: none; color: inherit; }
}

.md-mermaid-dialog {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  border: 0;
  background: var(--grey-1);
  color: var(--text-color);
  .md-mermaid {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  .md-mermaid-canvas { flex: 1; min-height: 0; }
}

@media (pointer: coarse) {
  .md-mermaid-tools button { width: 2.25rem; height: 2.25rem; }
}

@media (max-width: 420px) {
  .md-mermaid-zoom { display: none; }
}
