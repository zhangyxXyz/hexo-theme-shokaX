.theme-tooltip, .toc-title-tooltip
  position fixed
  z-index 1200
  width max-content
  box-sizing border-box
  max-width unquote('min(36rem, calc(100vw - 24px))')
  padding 6px 10px
  border 1px solid var(--tooltip-border)
  border-radius 8px
  background var(--tooltip-bg)
  backdrop-filter blur(12px) saturate(125%)
  -webkit-backdrop-filter blur(12px) saturate(125%)
  color var(--tooltip-text)
  box-shadow 0 4px 14px var(--tooltip-shadow)
  font-size 12px
  font-weight normal
  line-height 1.45
  overflow-wrap anywhere

  +tablet-mobile()
    max-width unquote('min(28rem, calc(100vw - 24px))')

  +mobile()
    max-width unquote('min(20rem, calc(100vw - 24px))')

.theme-tooltip
  pointer-events none
  white-space pre-line
  &[hidden]
    display none

// Glyph alignment comes from the shared icon_baselines.json mechanism.
.theme-tooltip .tooltip-inline-icon
  display inline-block
  width 1em
  height 1em
  margin-inline .12em
  font-size 1.3em
  line-height 1
  color var(--accent-color)
