:root {
  --selection-bg: unquote('color-mix(in srgb, var(--color-orange) 25%, transparent)');
}

html[data-theme='dark'] {
  --selection-bg: unquote('color-mix(in srgb, var(--color-orange) 30%, transparent)');
}

::selection {
  background: var(--selection-bg);
  color: currentColor;
}

*, *:before, *:after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
}

body {
  background: linear-gradient(to top, var(--body-bg-shadow) 0, var(--grey-1) 20%) no-repeat bottom;
  color: var(--text-color);
  font-family: $font-family-base;
  font-size: $font-size-base;
  line-height: $line-height-base;
  -webkit-font-smoothing: antialiased;
  overflow: auto;

  &.loaded {
    overflow: auto;
    @extend $big-scrollbar;

    #sidebar .panel.active {
      @extend .slide-up-big-in;
      display: block;
    }

  }

  +tablet-mobile() {
    // Remove the padding of body when the sidebar is open.
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  &.fullscreen {
    overflow: hidden;

    #tool, #sidebar>.inner {
      z-index: 0;
    }
  }
}
h1, h2, h3, h4, h5, h6 {
  font-family: $font-family-headings;
  font-weight: bold;
  line-height: 1.5;
  margin: 1.25rem 0 .9375rem;
  &.title {
    font-family: $font-family-title;
  }
}

a {
  border: none;
  color: currentColor;
  outline: 0;
  text-decoration: none;
  word-wrap();
  the-transition();

  &:hover {
    border-bottom-color: var(--color-blue);
    color: var(--color-blue);
  }

  &::before, &::after {
    the-transition(.4s);
  }

  cursor: pointer;
}

a, li, div {
  -webkit-tap-highlight-color: transparent;
}

li {
  list-style: none;
}

iframe, img, video {
  display: block;
  margin-left: auto;
  margin-right: auto;
  max-width: 100%;
}

hr {
  background-image: repeating-linear-gradient(-45deg, var(--grey-3), var(--grey-4) .25rem, transparent .25rem, transparent .5rem);
  border: none;
  height: .125rem;
  margin: 1.5rem 0;
}

blockquote {
  border-left: .25rem solid var(--grey-4);
  color: var(--grey-6);
  margin: 1.25rem 0;
  padding: .625rem 1.25rem;

  cite::before {
    content: '-';
    padding: 0 .3125rem;
  }
}

.pullquote {
  width: 45%;
  margin: 0;

  &.left {
    margin-left: 0.5em;
    margin-right: 1em;
    float: left;
  }

  &.right {
    margin-right: 0.5em;
    margin-left: 1em;
    float: right;
  }
}

dt {
  font-weight: bold;
}

dd {
  margin: 0;
  padding: 0;
}

input, textarea {
  color: var(--text-color);
}
@font-face {
  font-family: 'ic';
  font-display: swap;
  src: url(hexo-config('vendor_fonts.iconfont') + '.woff2') format('woff2'),
  url(hexo-config('vendor_fonts.iconfont') + '.woff') format('woff'),
  url(hexo-config('vendor_fonts.iconfont') + '.ttf') format('truetype');
}

@font-face {
  font-family: 'jetbrains-mono';
  font-display: swap;
  src: url(hexo-config('vendor_fonts.code')) format("woff2");
}

.ic {
  font-family: "ic" !important;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-align: center;
  width: 1.25em;
  display: inline-flex;
  font-style: normal;
  font-variant: normal;
  text-rendering: auto;
  line-height: 1;
  align-items: center;
  justify-content: center;
}

.ic em {
  font-size: 0;
}

.ic-lg {
  font-size: 1.33333em;
  line-height: .75em;
  vertical-align: -.0667em;
}
// Theme adapter for the unmodified remote Live2D widget.
#waifu.shokax-live2d {
  left: 4.5rem;
  z-index: 10;
  #waifu-tips, #shokax-waifu-tips { color: var(--text-color, #444); }
  &.has-theme-tip #waifu-tips { visibility: hidden; }
  #waifu-tool { right: 20px; top: 65px; }
  #waifu-tool .ic {
    color: #c66677;
    cursor: pointer;
    transition: color .3s;
    &:hover { color: #0684bd; }
  }
}
#shokax-waifu-tips {
  position: fixed;
  inset: auto;
  margin: 0;
  width: 250px;
  max-width: calc(100vw - 16px);
  min-height: 70px;
  padding: 5px 10px;
  box-sizing: border-box;
  border: 1px solid rgba(224, 186, 140, .62);
  border-radius: 12px;
  background: rgba(236, 217, 188, .85);
  box-shadow: 0 3px 15px 2px rgba(191, 158, 118, .2);
  font-size: 14px;
  line-height: 24px;
  overflow-wrap: anywhere;
  pointer-events: none;
  span { color: var(--waifu-keyword-color, var(--color-pink)); }
  &::backdrop { pointer-events: none; background: transparent; }
  &[hidden] { display: none; }
}
[data-theme="dark"] #waifu.shokax-live2d #waifu-tips {
  background-color: rgba(35, 35, 35, .5);
}
[data-theme="dark"] #shokax-waifu-tips {
  background-color: rgba(35, 35, 35, .94);
}
@media (prefers-reduced-motion: reduce) {
  #waifu.shokax-live2d, #waifu.shokax-live2d #waifu-tips { animation: none; transition: none; }
}
