.overview .menu
  --sidebar-menu-accent #e88fa7
  --sidebar-menu-line rgba(232, 143, 167, .3)
  --sidebar-menu-hover rgba(244, 166, 185, .12)
  padding 1rem 1.1rem
  margin 0
  text-align left
  background transparent

  .item
    display block
    position relative
    margin .2rem 0
    border-radius 14px
    color var(--grey-6)
    transition color .2s, background-color .2s

    > a, > .sidebar-menu-toggle
      display flex
      align-items center
      gap .65rem
      width 100%
      min-height 44px
      padding 0 1rem
      border 0
      border-radius inherit
      background transparent
      color inherit
      font inherit
      font-size 1rem
      line-height 1.3
      text-align left
      cursor pointer
      transition color .2s, background-color .2s

      &:focus-visible
        outline 2px solid var(--sidebar-menu-accent)
        outline-offset 2px

    .ic
      width 1.15rem
      flex 0 0 1.15rem
      margin 0
      text-align center
      color var(--sidebar-menu-accent)
      opacity .8

    &:hover
      color var(--sidebar-menu-accent)

    &.active
      color var(--sidebar-menu-accent)
      background linear-gradient(90deg, rgba(244, 166, 185, .2), rgba(247, 193, 181, .1))

    > a:hover, > .sidebar-menu-toggle:hover
      background var(--sidebar-menu-hover)

  .sidebar-menu-toggle::after
    content ''
    width 6px
    height 6px
    margin-left auto
    border-right 1.5px solid currentColor
    border-bottom 1.5px solid currentColor
    transform rotate(45deg)
    transition transform .2s
    flex 0 0 6px

  // Equal side columns keep the label on the sidebar centerline on either side of the page.
  > .item > a, > .item > .sidebar-menu-toggle:not(.sidebar-menu-chevron)
    display grid
    grid-template-columns 1.15rem minmax(0, 1fr) 1.15rem
    text-align center
    padding 0 1rem

  > .item > a::after
    content ''

  > .item > a > .ic, > .item > .sidebar-menu-toggle > .ic
    transform translateX(.65rem)

  .item > .sidebar-menu-chevron
    position absolute
    top 0
    right 0
    width 40px
    min-height 44px
    justify-content center
    padding 0
    &::after
      margin-left 0

  .submenu
    position relative
    display block
    max-height 0
    opacity 0
    visibility hidden
    overflow hidden
    margin 0 .4rem 0 1.45rem
    padding 0 0 0 1rem
    transition max-height .28s ease, opacity .2s, padding .28s
    &::before
      content ''
      position absolute
      left 4px
      top .5rem
      bottom .5rem
      width 1px
      background var(--sidebar-menu-line)

    .item
      margin .1rem 0
      border-radius 10px
      &::before
        content ''
        position absolute
        left -15px
        top 50%
        width 5px
        height 5px
        border-radius 50%
        background #e7bdc8
        transform translateY(-50%)
      > a
        min-height 36px
        padding 0 .6rem
        font-size .9375rem
      .ic
        color #d99aad
      &:hover, &.active
        background var(--sidebar-menu-hover)
        color var(--sidebar-menu-accent)
        &::before
          background var(--sidebar-menu-accent)
        .ic
          color var(--sidebar-menu-accent)

  .dropdown.expand, .dropdown.is-open
    > .submenu
      max-height 40rem
      padding-top .3rem
      padding-bottom .5rem
      visibility visible
      opacity 1
    > .sidebar-menu-toggle::after
      transform rotate(225deg)

  @media (prefers-reduced-motion: reduce)
    *, *::after
      transition none

[data-theme="dark"] .overview .menu
  --sidebar-menu-accent #f2a4b8
  --sidebar-menu-line rgba(242, 164, 184, .3)
  --sidebar-menu-hover rgba(232, 143, 167, .13)
  .item.active
    background linear-gradient(90deg, rgba(232, 143, 167, .18), rgba(231, 164, 145, .09))
  .submenu .item::before
    background #967582
  .submenu .item:hover::before, .submenu .item.active::before
    background var(--sidebar-menu-accent)
