.contents.toc-curve {
  --toc-accent: var(--accent-state);

  ol {
    padding: 0;
    list-style: none;
  }

  > .toc {
    position: relative;
    margin: 0;
  }

  .toc-child {
    display: block;
    padding-left: 1rem;
    height: 0;
    overflow: hidden;
  }

  .active > .toc-child {
    height: auto;
  }

  .toc-item {
    overflow: visible;
    white-space: normal;
    font-size: .9375rem;
  }

  .toc-number {
    font-variant-numeric: tabular-nums;
  }

  .toc-link {
    display: block;
    position: relative;
    padding: .5rem .25rem .5rem 1.5rem;
    color: var(--grey-6);
    line-height: 1.6;
    overflow-wrap: anywhere;
    isolation: isolate;
    transition: color .18s ease;

    // The tint starts after the rail gutter so the curve stays unobstructed.
    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: .2rem 0 .2rem 1.05rem;
      border-radius: .5rem;
      background: unquote('color-mix(in srgb, var(--toc-accent) 8%, transparent)');
      opacity: 0;
      transition: opacity .18s ease;
    }

    &:hover {
      color: var(--text-color);

      &::before {
        opacity: 1;
      }
    }

    &:focus-visible {
      outline: 2px solid var(--toc-accent);
      outline-offset: -2px;
      border-radius: .25rem;
    }
  }

  .active > .toc-link,
  .current > .toc-link {
    color: var(--grey-6);
    font-weight: normal;
  }

  .toc-link[data-toc-visible='true'],
  .toc-link[data-toc-visible='true']:hover {
    color: var(--toc-accent);
    font-weight: 600;
  }

  .toc-curve-rail {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
    fill: none;
    stroke: unquote('color-mix(in srgb, var(--toc-accent) 22%, transparent)');
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;

    .toc-curve-progress {
      stroke: var(--toc-accent);
      stroke-width: 1.75;
    }

    circle {
      fill: var(--toc-accent);
      stroke: none;
      filter: unquote('drop-shadow(0 0 3px color-mix(in srgb, var(--toc-accent) 55%, transparent))');
      transition: cx .18s ease, cy .18s ease;
    }

    .toc-curve-window {
      transition: y .18s ease, height .18s ease;
    }
  }
}

+reduced-motion() {
  .contents.toc-curve .toc-curve-rail {
    circle, .toc-curve-window {
      transition: none;
    }
  }

  .contents.toc-curve .toc-link::before {
    transition: none;
  }
}
