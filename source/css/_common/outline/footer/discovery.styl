// The outer footer retains the same width and sidebar gutter as the article.
#footer {
  color: var(--grey-7);
  background: var(--body-bg-shadow);
  box-shadow: 0 -1px 0 var(--body-bg-shadow);
  > .inner { margin: 0 auto; }
  .footer-shell { position: relative; isolation: isolate; padding: 2.5rem 1.5rem 0; }
  .footer-starlight { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; overflow: hidden; pointer-events: none; color: var(--color-blue); }
  .footer-orbits { opacity: .1; }
  .footer-stars { opacity: .18; }
  .footer-layout { display: grid; grid-template-columns: minmax(230px, .9fr) minmax(0, 2fr); gap: 2.5rem; }
  .footer-intro { display: flex; flex-direction: column; align-self: stretch; padding: 1.2rem 0 .2rem; }
  .footer-intro { container-type: inline-size; }
  .footer-brand { display: flex; align-items: center; gap: .45rem; color: var(--grey-8); font-size: 1.5rem; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
  .footer-brand .ic { font-size: 1.6rem; flex-shrink: 0; }
  .footer-brand > span { position: relative; font-family: $font-family-logo; font-weight: 400; }
  .footer-brand .artboard-glitch { opacity: 0; transition: opacity .18s ease; }
  .footer-tagline { color: var(--grey-6); font-size: .78rem; margin: .6rem 0; }
  .footer-latest { min-width: 0; margin-top: 1.6rem; }
  .footer-latest-heading { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; color: var(--grey-6); font-size: .78rem; }
  .footer-latest-heading time { font-size: .85em; color: var(--grey-5); }
  .footer-latest > a { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 100%; margin-top: .45rem; color: var(--grey-6); font-size: .76rem; line-height: 1.6; }
  .footer-latest > a:hover, .footer-latest > a:focus-visible { color: var(--primary-color); }
  .copyright { width: 100%; color: var(--grey-6); font-size: 1em; line-height: 1.8; text-align: center; overflow-wrap: anywhere; }
  .footer-data > h2 { display: none; }
  .footer-metrics { display: flex; margin: 1.4rem 0 1.15rem; }
  .footer-metric { flex: 1; min-width: 0; text-align: center; }
  .footer-metric + .footer-metric { border-left: 1px solid unquote('color-mix(in srgb, var(--grey-4) 65%, transparent)'); }
  .footer-metric strong { display: block; color: var(--grey-8); font-size: 1.45rem; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .footer-metric-unit { margin-left: .2em; color: var(--grey-6); font-size: .5em; font-weight: 400; line-height: 1; vertical-align: baseline; }
  .footer-metric > span { display: inline-flex; align-items: center; justify-content: center; gap: .2em; color: var(--grey-6); font-size: 1em; margin-top: .5rem; white-space: nowrap; }
  .footer-metric > [hidden] { display: none; }
  .footer-metric [data-visitor-count] { color: #61afef; cursor: help; }
  .footer-metric [data-visitor-count] .footer-metric-unit { color: inherit; }
  .footer-metric .ic { color: var(--grey-5); }
  .footer-browse { min-width: 0; padding-top: 1.2rem; }
  .footer-section-heading { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .75rem; }
  .footer-section-title { margin: 0 0 .75rem; padding: 0; font-size: .95rem; color: var(--grey-8); font-weight: 600; }
  .footer-section-heading .footer-section-title { margin: 0; font-size: .82rem; color: var(--grey-6); }
  .footer-shuffle { border: 0; background: none; color: var(--primary-color); cursor: pointer; padding: .4rem; font: inherit; font-size: .72rem; white-space: nowrap; }
  .footer-shuffle .ic { display: inline-block; margin-left: .35rem; transition: transform .35s ease; }
  .footer-shuffle:hover .ic, .footer-shuffle:focus-visible .ic { transform: rotate(180deg); }
  .footer-article-heading { display: flex; align-items: center; gap: .4rem; margin-bottom: .75rem; }
  .footer-article-heading .footer-section-title { margin: 0; }
  .footer-article-heading .footer-shuffle { margin-left: auto; }
  .footer-random { display: inline-flex; align-items: center; justify-content: center; width: 2.5rem; height: 1.75rem; margin: -.35rem 0; border: 0; border-radius: .8rem; color: var(--primary-color); background: transparent; font-size: 1rem; transition: background .2s, transform .25s; }
  .footer-random .ic { display: inline-block; transition: transform .45s cubic-bezier(.2, .8, .2, 1); }
  .footer-random:hover, .footer-random:focus-visible { transform: translateY(-1px); }
  .footer-random:hover .ic, .footer-random:focus-visible .ic { transform: rotate(180deg); }
  .footer-random[hidden] { display: none; }
  .footer-tags { display: flex; flex-wrap: wrap; gap: .45rem; min-height: 4.1rem; align-content: flex-start; }
  .footer-tag { display: inline-flex; align-items: baseline; gap: .4rem; padding: .3rem .65rem; border: 1px solid unquote('color-mix(in srgb, var(--primary-color) 18%, transparent)'); border-radius: .7rem; color: unquote('color-mix(in srgb, var(--primary-color) 80%, var(--grey-6))'); background: unquote('color-mix(in srgb, var(--grey-1) 45%, transparent)'); font-size: .78rem; max-width: 100%; overflow-wrap: anywhere; transition: background .2s, border-color .2s, color .2s; }
  .footer-tag:nth-child(even) { color: var(--color-purple); }
  .footer-tag[hidden] { display: none; }
  .footer-tag sup { position: static; font-size: .6rem; opacity: .65; }
  .footer-tag:hover, .footer-tag:focus-visible { color: var(--primary-color); border-color: var(--color-pink-a3); background: var(--color-red-a1); }
  .footer-stories { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; margin-top: .6rem; }
  .footer-stories-single { grid-template-columns: minmax(0, 1fr); }
  .footer-stories[hidden], .footer-browse[hidden], .footer-social:empty { display: none; }
  .footer-browse > .footer-stories:first-child { margin-top: 0; }
  .footer-layout.footer-layout-intro-only { grid-template-columns: minmax(0, 1fr); }
  .footer-layout-intro-only .footer-intro { width: 100%; max-width: 32rem; }
  .footer-list { list-style: none; padding: 0; margin: 0; }
  .footer-list li { margin: 0; padding: 0; }
  .footer-list li > a { display: block; min-height: 3.65rem; padding: .45rem .6rem; margin: 0 -.6rem .15rem; border-radius: .65rem; line-height: 1.6; }
  .footer-articles .footer-list li > a { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: .65rem; }
  .footer-article-number { color: var(--grey-5); font-size: 1.2rem; font-weight: 400; line-height: 1.15; text-align: center; font-variant-numeric: tabular-nums; }
  .footer-article-body { min-width: 0; }
  .footer-article-title { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: .85rem; }
  .footer-list small { display: block; color: var(--grey-6); font-size: .7rem; margin-top: .2rem; }
  .footer-list .footer-comment-link { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .65rem; }
  .footer-comment-avatar { width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; background: var(--grey-3); color: var(--primary-color); font-size: 1rem; overflow: hidden; }
  .footer-comment-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .footer-comment-body { min-width: 0; }
  .footer-comment-head { display: flex; flex-wrap: wrap; align-items: center; gap: .2rem .6rem; min-height: 1.3rem; }
  .footer-comment-identity { display: flex; flex-wrap: wrap; align-items: center; gap: .2rem .35rem; min-width: 0; max-width: 100%; }
  .footer-comment-name { font-weight: 600; font-size: .8rem; overflow-wrap: anywhere; }
  .footer-comment-badge { display: inline-flex; align-items: center; justify-content: center; padding: .23rem .35rem .11rem; border: 1px solid unquote('color-mix(in srgb, var(--primary-color) 20%, transparent)'); border-radius: 999px; color: var(--primary-color); background: unquote('color-mix(in srgb, var(--primary-color) 8%, transparent)'); font-size: .6rem; font-weight: 600; line-height: 1; overflow-wrap: anywhere; }
  .footer-comment-badge-friend { color: var(--friend-light-text, #347d83); background: unquote('color-mix(in srgb, var(--friend-light-background, #eaf5f4) 65%, transparent)'); border-color: var(--friend-light-border, #c5e3df); }
  .footer-comment-badge-level { color: var(--badge-light-text, var(--primary-color)); background: var(--badge-light-background, transparent); border-color: var(--badge-light-border, var(--primary-color)); }
  .footer-comment-time { margin-left: auto; color: var(--grey-5); font-size: .65rem; line-height: 1.5; white-space: nowrap; }
  .footer-comment-text { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: .25rem; color: var(--grey-6); font-size: .75rem; }
  .footer-comment-state { color: var(--grey-6); font-size: .8rem; padding: .5rem 0; }
  .footer-navigation { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem 1rem; min-height: 3.25rem; margin-top: 1.5rem; padding: .5rem 0; border-top: 1px solid var(--grey-3); }
  .footer-nav-links { display: flex; flex-wrap: wrap; gap: .3rem; }
  .footer-navigation a { display: inline-flex; align-items: center; gap: .35rem; padding: .25rem .55rem; font-size: .78rem; border-radius: .6rem; }
  .footer-list li > a, .footer-navigation a { position: relative; transition: background .2s, color .2s, transform .2s; }
  .footer-list li > a::before, .footer-navigation a::before { content: ''; position: absolute; inset: 0; border: 1px solid var(--color-pink-a3); border-radius: inherit; pointer-events: none; opacity: 0; transform: scale(.985); transition: opacity .2s, transform .2s; }
  .footer-list li > a:hover, .footer-list li > a:focus-visible, .footer-navigation a:hover, .footer-navigation a:focus-visible { color: var(--primary-color); background: unquote('color-mix(in srgb, var(--primary-color) 3%, transparent)'); transform: translateY(-1px); }
  .footer-list li > a:hover::before, .footer-list li > a:focus-visible::before, .footer-navigation a:hover::before, .footer-navigation a:focus-visible::before { opacity: 1; transform: scale(1); }
  .footer-nav-links .ic { color: var(--grey-5); }
  .footer-social { margin-left: auto; display: flex; gap: .5rem; }
  .footer-social a { font-size: 1.1rem; }
  .footer-meta { display: flex; flex-direction: column; align-items: center; gap: 0; padding: .6rem 0; border-top: 1px dashed var(--grey-4); }
  .site-uptime { display: flex; align-items: center; flex-wrap: wrap; gap: .2rem .6rem; margin-top: 1rem; font-variant-numeric: tabular-nums; }
  .footer-intro .footer-uptime-label { width: 100%; }
  .footer-uptime-label { color: var(--grey-6); font-size: 1em; }
  [data-uptime] { display: flex; flex-wrap: nowrap; align-items: baseline; gap: .3rem; color: var(--grey-6); font-size: 1em; white-space: nowrap; }
  [data-uptime-days] { color: var(--grey-8); font-size: 1.6rem; font-weight: 600; line-height: 1.3; }
  [data-uptime-clock] { font-size: 1em; color: var(--grey-6); margin-left: .2rem; }
  .footer-legal { display: flex; width: 100%; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: .35rem .45rem; font-size: 1em; line-height: 1.8; }
  .footer-meta-dot { color: var(--grey-5); opacity: .35; user-select: none; }
  .beian-info { display: contents; line-height: 1.8; }
  .icp-link { color: #dc624c; }
  .moe-link { color: #368fe0; }
  .powered-by { color: var(--grey-6); margin: 0; }
  .footer-police { display: inline-flex; gap: .3rem; align-items: center; }
  .footer-police img { margin: 0; }
  a:focus-visible, button:focus-visible, [data-visitor-count]:focus-visible { outline: 2px solid var(--primary-color); outline-offset: 3px; border-radius: .35rem; }
}

@container (max-width: 320px) {
  #footer .footer-metric > span:not([hidden]) { font-size: clamp(.68rem, 5cqi, .875rem); }
  #footer .footer-metric strong { font-size: 1.4rem; }
  #footer [data-uptime] { font-size: .875rem; gap: .25rem; }
  #footer [data-uptime-clock] { font-size: clamp(.75rem, 5cqi, .875rem); }
  #footer [data-uptime-days] { font-size: 1.4rem; }
}

@media (min-width: 768px) and (max-width: 1199px) {
  #footer {
    .footer-layout { grid-template-columns: minmax(210px, .9fr) minmax(0, 1.8fr); gap: 1.5rem; }
    .footer-intro { padding: 1.1rem 0; }
    .footer-brand { font-size: 1.25rem; }
    .footer-stories { gap: 1.5rem; }
    .footer-shell { padding-left: 1rem; padding-right: 1rem; }
  }
}

@media (max-width: 1199px) {
  #footer .footer-latest { display: none; }
}

@media (max-width: 767px) {
  #footer {
    > .inner { width: auto; margin: 0 1.25rem; padding: 0; }
    .footer-shell { padding: 1.5rem 0 0; }
    .footer-layout { display: block; }
    .footer-intro { padding: 1.1rem 0; }
    .footer-browse { display: none; }
    .footer-brand { font-size: 1.55rem; }
    .footer-tagline { font-size: .8rem; }
    .footer-metric strong { font-size: 1.5rem; }
    .footer-navigation { flex-wrap: nowrap; gap: .25rem; margin-top: 1rem; padding: .2rem 0; }
    .footer-social { position: relative; flex: 0 0 auto; align-items: center; gap: 0; padding-left: .3rem; margin-left: 0; }
    .footer-social::before { content: ''; position: absolute; left: 0; top: 50%; height: .9rem; border-left: 1px solid var(--grey-4); transform: translateY(-50%); opacity: .55; }
    .footer-social a { justify-content: center; width: 1.75rem; min-height: 2.75rem; padding: .15rem; font-size: .95rem; color: var(--grey-6); }
    .footer-nav-links { flex: 1 1 0; min-width: 0; display: flex; flex-wrap: nowrap; gap: 0; overflow-x: auto; }
    .footer-nav-links a { flex: 1 0 auto; justify-content: center; min-height: 2.75rem; gap: .15rem; padding: .35rem .05rem; font-size: .72rem; line-height: 1.5; white-space: nowrap; }
    .footer-nav-links .ic { font-size: .75rem; color: var(--grey-5); }
    .footer-navigation .ic { display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 1; }
    .footer-navigation .ic::before { display: block; line-height: 1; }
    .footer-navigation a:hover, .footer-navigation a:focus-visible { background: transparent; }
    .footer-navigation a:hover, .footer-navigation a:focus-visible, .footer-nav-links a:hover .ic, .footer-nav-links a:focus-visible .ic { color: var(--primary-color); }
    .footer-nav-links a:hover, .footer-nav-links a:focus-visible { transform: none; }
    .footer-navigation a::before { inset: .15rem 0; }
    .footer-nav-links a:focus-visible { outline-offset: -2px; }
    .site-uptime { justify-content: center; gap: .3rem; }
    .footer-uptime-label { width: 100%; text-align: center; }
    [data-uptime] { justify-content: center; }
    .footer-legal { flex-direction: column; align-items: center; text-align: center; margin-top: 0; gap: 0; }
    .footer-meta-dot { display: none; }
    .beian-info { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; max-width: 100%; gap: 0 .2rem; line-height: 1.8em; }
    .beian-info a, .beian-info .footer-meta-dot { font-size: clamp(.7rem, 3.5vw, .875rem); line-height: inherit; }
    .beian-info a { padding: 0; white-space: nowrap; }
    .beian-info .footer-meta-dot { display: inline; }
    .powered-by { display: block; }
  }
}

html[data-theme='dark'] #footer .footer-comment-badge-friend {
  color: var(--friend-dark-text, #9ad5ce);
  background: unquote('color-mix(in srgb, var(--friend-dark-background, #253b3c) 65%, transparent)');
  border-color: var(--friend-dark-border, #3d6262);
}

@media (hover: hover) and (pointer: fine) {
  #footer .footer-brand:hover .artboard-glitch, #footer .footer-brand:focus-visible .artboard-glitch { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  #footer .footer-brand .artboard-glitch { transition: none; }
  #footer .footer-list a, #footer .footer-tag { transition: none; }
  #footer .footer-random, #footer .footer-random .ic, #footer .footer-shuffle .ic { transition: none; transform: none; }
  #footer .footer-list li > a, #footer .footer-list li > a::before, #footer .footer-navigation a, #footer .footer-navigation a::before { transition: none; }
  #footer .footer-list li > a:hover, #footer .footer-list li > a:focus-visible, #footer .footer-navigation a:hover, #footer .footer-navigation a:focus-visible { transform: none; }
}
html[data-theme='dark'] #footer .footer-comment-badge-level {
  color: var(--badge-dark-text, var(--primary-color));
  background: var(--badge-dark-background, transparent);
  border-color: var(--badge-dark-border, var(--primary-color));
}
