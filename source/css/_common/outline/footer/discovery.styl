// The outer footer retains the same width and sidebar gutter as the article.
#footer {
  color: var(--grey-7);
  background: var(--body-bg-shadow);
  box-shadow: 0 -1px 0 var(--body-bg-shadow);
  > .inner { margin: 0 auto; }
  .footer-shell { padding: 2.5rem 1.5rem 1.5rem; }
  .footer-layout { display: grid; grid-template-columns: minmax(230px, .9fr) minmax(0, 2fr); gap: 2rem; }
  .footer-intro { display: flex; flex-direction: column; align-self: stretch; padding: 1.4rem 1.2rem .2rem; border-radius: 1.3rem; background: linear-gradient(145deg, var(--color-pink-light-a3), var(--grey-1-a0) 80%); }
  .footer-brand { display: flex; align-items: center; gap: .45rem; color: var(--grey-8); font-size: 1.5rem; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
  .footer-brand .ic { font-size: 1.6rem; flex-shrink: 0; }
  .footer-tagline { color: var(--grey-6); font-size: .78rem; margin: .6rem 0; }
  .copyright { color: var(--grey-6); font-size: 1em; line-height: 1.8; margin-top: auto; padding-top: 1.2rem; overflow-wrap: anywhere; }
  .footer-data > h2 { display: none; }
  .footer-metrics { display: flex; margin: 1.4rem 0 1.15rem; }
  .footer-metric { flex: 1; min-width: 0; text-align: center; }
  .footer-metric + .footer-metric { border-left: 1px solid var(--grey-4); }
  .footer-metric strong { display: block; color: var(--grey-8); font-size: 1.6rem; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; }
  .footer-metric > span { display: block; color: var(--grey-6); font-size: 1em; margin-top: .5rem; }
  .footer-metric .ic { color: var(--grey-5); }
  .footer-browse { min-width: 0; padding-top: 1.2rem; }
  .footer-section-heading { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .75rem; }
  .footer-section-title { margin: 0 0 1rem; padding: 0; font-size: .95rem; color: var(--grey-8); font-weight: 600; }
  .footer-section-heading .footer-section-title { margin: 0; font-size: .82rem; color: var(--grey-6); }
  .footer-shuffle { border: 0; background: none; color: var(--primary-color); cursor: pointer; padding: .4rem; font: inherit; font-size: .72rem; white-space: nowrap; }
  .footer-tags { display: flex; flex-wrap: wrap; gap: .45rem; min-height: 4.8rem; align-content: flex-start; }
  .footer-tag { display: inline-flex; align-items: baseline; gap: .4rem; padding: .3rem .65rem; border: 1px solid var(--color-pink-a3); border-radius: .7rem; color: var(--primary-color); background: var(--grey-1); font-size: .78rem; max-width: 100%; overflow-wrap: anywhere; transition: background .2s; }
  .footer-tag:nth-child(even) { color: var(--color-purple); }
  .footer-tag[hidden] { display: none; }
  .footer-tag sup { position: static; font-size: .64rem; opacity: .75; }
  .footer-tag:hover { background: var(--color-red-a1); }
  .footer-stories { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem; margin-top: .8rem; }
  .footer-list { list-style: none; padding: 0; margin: 0; }
  .footer-list li { margin: 0; padding: 0; }
  .footer-list li > a { display: block; padding: .55rem .6rem; margin: 0 -.6rem .2rem; border-radius: .65rem; line-height: 1.6; transition: background .2s; }
  .footer-list li > a:hover { background: var(--grey-1); color: var(--primary-color); }
  .footer-article-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: .85rem; }
  .footer-list small { display: block; color: var(--grey-6); font-size: .7rem; margin-top: .2rem; }
  .footer-list .footer-comment-link { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .65rem; }
  .footer-comment-avatar { width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; background: var(--grey-3); color: var(--primary-color); font-size: 1rem; overflow: hidden; }
  .footer-comment-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .footer-comment-name { font-weight: 600; font-size: .8rem; }
  .footer-comment-text { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--grey-6); font-size: .75rem; }
  .footer-comment-state { color: var(--grey-6); font-size: .8rem; padding: .5rem 0; }
  .footer-navigation { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem 1rem; margin-top: 1.5rem; padding: 1rem 0; border-top: 1px solid var(--grey-3); }
  .footer-navigation > strong { font-size: .78rem; color: var(--primary-color); white-space: nowrap; }
  .footer-nav-links { display: flex; flex-wrap: wrap; gap: .3rem; }
  .footer-navigation a { display: inline-flex; align-items: center; gap: .35rem; padding: .4rem .55rem; font-size: .78rem; border-radius: .6rem; }
  .footer-navigation a:hover { color: var(--primary-color); background: var(--grey-1); }
  .footer-nav-links .ic { color: var(--grey-5); }
  .footer-social { margin-left: auto; display: flex; gap: .5rem; }
  .footer-social a { font-size: 1.1rem; }
  .footer-social a span { font-size: .68rem; }
  .footer-rss { display: block; }
  .footer-meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .75rem 1rem; padding: .9rem 0 .2rem; border-top: 1px dashed var(--grey-4); }
  .site-uptime { display: flex; align-items: center; flex-wrap: wrap; gap: .2rem .6rem; margin-top: 1rem; font-variant-numeric: tabular-nums; }
  .footer-intro .footer-uptime-label { width: 100%; }
  .footer-intro [data-uptime-clock] { width: 100%; }
  .footer-uptime-label { color: var(--grey-6); font-size: 1em; }
  [data-uptime] { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .4rem; color: var(--grey-6); font-size: 1em; }
  [data-uptime-days] { color: var(--grey-8); font-size: 1.6rem; font-weight: 600; line-height: 1.3; }
  [data-uptime-clock] { font-size: 1em; color: var(--grey-6); }
  .footer-legal { display: flex; width: 100%; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: .5rem 1.25rem; font-size: 1em; }
  .beian-info { display: contents; line-height: 1.8; }
  .icp-link { color: #dc624c; }
  .moe-link { color: #368fe0; }
  .powered-by { color: var(--grey-6); margin-top: .25rem; }
  .footer-police { display: inline-flex; gap: .3rem; align-items: center; }
  .footer-police img { margin: 0; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--primary-color); outline-offset: 3px; border-radius: .35rem; }
}

@media (min-width: 768px) and (max-width: 1199px) {
  #footer {
    .footer-layout { grid-template-columns: minmax(210px, .9fr) minmax(0, 1.8fr); gap: 1.2rem; }
    .footer-intro { padding: 1.1rem .7rem; }
    .footer-brand { font-size: 1.25rem; }
    .footer-stories { gap: 1.1rem; }
    .footer-shell { padding-left: 1rem; padding-right: 1rem; }
  }
}

@media (max-width: 767px) {
  #footer {
    > .inner { width: auto; margin: 0 1.25rem; padding: 0; }
    .footer-shell { padding: 1.5rem 0; }
    .footer-layout { display: block; }
    .footer-intro { padding: 1.1rem; }
    .footer-browse { display: none; }
    .footer-brand { font-size: 1.55rem; }
    .footer-tagline { font-size: .8rem; }
    .footer-metric strong { font-size: 1.7rem; }
    .footer-navigation { gap: .5rem; margin-top: 1rem; }
    .footer-nav-links { order: 3; width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .25rem; }
    .footer-nav-links a { justify-content: center; padding: .55rem .2rem; }
    .footer-meta { display: block; padding-top: 1rem; }
    .site-uptime { justify-content: center; gap: .3rem; }
    .footer-uptime-label { width: 100%; text-align: center; }
    [data-uptime] { justify-content: center; }
    [data-uptime-clock] { width: 100%; margin: 0; text-align: center; }
    .footer-legal { flex-direction: column; align-items: center; text-align: center; margin-top: 0; gap: .2rem; }
    .beian-info a { padding: .2rem 0; }
    .powered-by { display: block; }
  }
}

@media (prefers-reduced-motion: reduce) {
  #footer .footer-list a, #footer .footer-tag { transition: none; }
}
